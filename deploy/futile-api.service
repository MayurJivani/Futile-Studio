[Unit]
Description=futile-api (futile.studio API and presence socket)
After=network-online.target

[Service]
User=icarusfalls
WorkingDirectory=/opt/apps/Futile-Studio/server
EnvironmentFile=/etc/apps/futile-api.env
Environment=NODE_ENV=production PORT=4000
ExecStart=/usr/bin/node index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
MemoryMax=384M
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
