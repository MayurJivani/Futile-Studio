---
/**
 * The studio index: the brand mark, the sections in the order you walk them,
 * and a small utility shelf (Field Guide count, desk settings, CV).
 *
 * Section-aware: on the homepage the section in view is marked with
 * aria-current, so a reader always knows where they are. On other pages the
 * links still go to the homepage sections.
 *
 * On narrow screens the sections fold into a drawer; the brand, the stamp
 * count and the menu button stay in the strip, so nothing essential is ever
 * covered by the navigation itself.
 */
import { url } from '../lib/url.js';
import { stamps } from '../data/stamps.js';
import LampCord from './LampCord.astro';

const sections = [
	['work', 'Projects'],
	['archive', 'Archive'],
	['guide', 'Field Guide'],
	['about', 'About'],
	['backroom', 'Back room'],
	['studio', 'Studio'],
	['contact', 'Contact'],
];
---

<div class="nav-strip">
	<nav class="nav" aria-label="Studio index">
		<a href={url()} class="nav-logo" aria-label="futile.studio, home">
			<span class="brandmark nav-mark">futile<b>.</b>studio</span>
		</a>

		<ul id="nav-list" class="nav-list">
			{
				sections.map(([id, name]) => (
					<li>
						<a href={url(`#${id}`)} class="nav-tab" data-section={id}>
							{name}
						</a>
					</li>
				))
			}
			<li class="nav-util">
				<button class="nav-tab" id="desk-open" aria-expanded="false" aria-controls="desk-panel">Desk</button>
				<a class="nav-tab" href={url('cv.pdf')} target="_blank" rel="noopener">
					CV<span class="visually-hidden">, PDF, opens in a new tab</span>
				</a>
			</li>
		</ul>

		<a class="nav-guide" href={url('#guide')} aria-label="Field Guide progress">
			<svg viewBox="0 0 20 24" aria-hidden="true">
				<path
					d="M2 2h16v20H2z"
					fill="var(--card)"
					stroke="currentColor"
					stroke-width="1.4"
					stroke-dasharray="1.6 1.6"></path>
				<rect x="5" y="5" width="10" height="10" fill="var(--stamp)" opacity="0.85"></rect>
			</svg>
			<span class="nav-guide-n"><span id="nav-guide-have">0</span>/{stamps.length}</span>
		</a>

		<button class="nav-toggle" id="nav-toggle" aria-label="Open the index" aria-expanded="false" aria-controls="nav-list">
			<span class="nav-toggle-bars" aria-hidden="true"><span></span><span></span></span>
			Index
		</button>
	</nav>
</div>
<div class="nav-backdrop" id="nav-backdrop"></div>

<LampCord />

<script>
	import { collected } from '../lib/guide.js';

	const toggle = document.getElementById('nav-toggle');
	const list = document.getElementById('nav-list');
	const backdrop = document.getElementById('nav-backdrop');

	function setOpen(open: boolean) {
		list?.classList.toggle('is-open', open);
		/* The lamp cord hangs in the same corner the drawer covers. */
		document.body.classList.toggle('nav-open', open);
		toggle?.classList.toggle('is-open', open);
		backdrop?.classList.toggle('is-open', open);
		toggle?.setAttribute('aria-expanded', open ? 'true' : 'false');
	}

	toggle?.addEventListener('click', () => setOpen(!list?.classList.contains('is-open')));
	backdrop?.addEventListener('click', () => setOpen(false));
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') setOpen(false);
	});
	list?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

	/* The stamp count in the strip, kept current as stamps land. */
	const have = document.getElementById('nav-guide-have');
	const count = () => have && (have.textContent = String(collected().size));
	count();
	window.addEventListener('futile-stamp', count);
	window.addEventListener('storage', (e) => e.key === 'futile-guide' && count());

	/* Section awareness: the section crossing the upper third of the screen is
	   the one you are in. */
	const links = new Map(
		[...document.querySelectorAll<HTMLAnchorElement>('.nav-tab[data-section]')].map((a) => [a.dataset.section!, a]),
	);
	/* The door is observed too, so walking back up to it clears the mark. */
	const targets = [...links.keys(), 'top'].map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
	if (targets.length) {
		const io = new IntersectionObserver(
			(entries) => {
				for (const e of entries) {
					if (!e.isIntersecting) continue;
					links.forEach((a, id) =>
						id === e.target.id ? a.setAttribute('aria-current', 'location') : a.removeAttribute('aria-current'),
					);
				}
			},
			{ rootMargin: '-30% 0px -65% 0px' },
		);
		targets.forEach((t) => io.observe(t));
	}
</script>

<style>
	.nav {
		position: relative;
		z-index: 100;
		display: flex;
		align-items: center;
		gap: 1rem;
		max-width: var(--page);
		margin: 0 auto;
		/* Extra right padding is the lamp cord's lane, so the two never collide. */
		padding: 0.7rem calc(var(--gutter) + 2.2rem) 0.7rem var(--gutter);
	}
	:global(.nav-strip) {
		position: sticky;
		top: 0;
		z-index: 100;
		background: color-mix(in srgb, var(--paper) 92%, transparent);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--ink-ghost);
	}

	.nav-logo {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		margin-right: auto;
		text-decoration: none;
	}
	.nav-mark {
		font-size: 1.3rem;
		transition: rotate 0.4s var(--ease-out);
	}
	.nav-logo:hover .nav-mark {
		rotate: 1.5deg;
	}

	.nav-list {
		list-style: none;
		display: flex;
		align-items: center;
	}

	.nav-tab {
		position: relative;
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 0.6rem;
		font-family: var(--mono);
		font-size: 0.74rem;
		font-weight: 500;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--ink-soft);
		text-decoration: none;
		background: none;
		border: none;
		cursor: pointer;
		transition: color 0.2s ease;
	}
	/* A pencilled circle around the section you are in: an index, marked up. */
	.nav-tab::after {
		content: '';
		position: absolute;
		inset: 0.45rem 0.1rem;
		border: 1.5px solid var(--stamp);
		border-radius: 50% 45% 55% 48% / 55% 50% 48% 52%;
		opacity: 0;
		scale: 0.85;
		rotate: -3deg;
		pointer-events: none;
		transition:
			opacity 0.25s ease,
			scale 0.35s var(--ease-out);
	}
	.nav-tab:hover,
	.nav-tab:focus-visible,
	.nav-tab[aria-current] {
		color: var(--ink);
	}
	.nav-tab:hover::after {
		opacity: 0.45;
		scale: 1;
	}
	.nav-tab[aria-current]::after {
		opacity: 1;
		scale: 1;
	}
	.nav-tab:active {
		translate: 0 1px;
	}

	.nav-util {
		display: flex;
		align-items: center;
		margin-left: 0.5rem;
		padding-left: 0.5rem;
		border-left: 1px solid var(--ink-ghost);
	}

	.nav-guide {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 44px;
		padding: 0 0.3rem;
		font-family: var(--mono);
		font-size: 0.78rem;
		color: var(--ink);
		text-decoration: none;
	}
	.nav-guide svg {
		width: 1rem;
		height: 1.2rem;
		rotate: 6deg;
		transition: rotate 0.35s var(--ease-out);
	}
	.nav-guide:hover svg {
		rotate: -4deg;
	}

	.nav-toggle {
		display: none;
		align-items: center;
		gap: 0.5rem;
		min-height: 44px;
		padding: 0 0.8rem;
		font-family: var(--mono);
		font-size: 0.76rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--ink);
		background: var(--card);
		border: 1px solid var(--ink-ghost);
		border-radius: 999px;
		cursor: pointer;
	}
	.nav-toggle-bars {
		display: inline-flex;
		flex-direction: column;
		gap: 3px;
	}
	.nav-toggle-bars span {
		width: 14px;
		height: 1.5px;
		background: var(--ink);
		transition: transform 0.25s ease;
	}
	.nav-toggle.is-open .nav-toggle-bars span:first-child {
		transform: translateY(2.2px) rotate(45deg);
	}
	.nav-toggle.is-open .nav-toggle-bars span:last-child {
		transform: translateY(-2.2px) rotate(-45deg);
	}

	.nav-backdrop {
		display: none;
	}

	@media (max-width: 1080px) {
		/* A backdrop filter would become the containing block of the fixed
		   drawer and trap it inside the strip, so the drawer widths get solid paper. */
		:global(.nav-strip) {
			backdrop-filter: none;
			-webkit-backdrop-filter: none;
			background: var(--paper);
		}
		.nav-toggle {
			display: inline-flex;
		}
		.nav-backdrop {
			display: block;
			position: fixed;
			inset: 0;
			z-index: 90;
			background: rgba(20, 16, 10, 0.45);
			opacity: 0;
			pointer-events: none;
			transition: opacity 0.3s ease;
		}
		.nav-backdrop.is-open {
			opacity: 1;
			pointer-events: auto;
		}
		.nav-list {
			position: fixed;
			top: 0;
			right: 0;
			z-index: 95;
			height: 100dvh;
			width: min(300px, 84vw);
			flex-direction: column;
			align-items: stretch;
			justify-content: center;
			padding: 2rem 1.6rem;
			background: var(--card);
			border-left: 1px solid var(--ink-ghost);
			box-shadow: -20px 0 40px -20px var(--shadow-deep);
			transform: translateX(100%);
			visibility: hidden;
			transition:
				transform 0.32s var(--ease-out),
				visibility 0s linear 0.32s;
		}
		.nav-list.is-open {
			transform: translateX(0);
			visibility: visible;
			transition: transform 0.32s var(--ease-out);
		}
		.nav-tab {
			font-family: var(--display);
			font-weight: 700;
			font-size: 1.6rem;
			letter-spacing: -0.02em;
			text-transform: none;
			color: var(--ink);
		}
		.nav-tab::after {
			inset: 0.3rem -0.2rem;
		}
		.nav-util {
			margin: 1rem 0 0;
			padding: 1rem 0 0;
			border-left: none;
			border-top: 1px solid var(--ink-ghost);
			gap: 0.4rem;
		}
		.nav-util .nav-tab {
			font-family: var(--mono);
			font-size: 0.85rem;
			text-transform: uppercase;
		}
	}
</style>
