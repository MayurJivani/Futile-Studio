---
/**
 * The back room: a short introduction to Jinx, and a door to /jinx for anyone
 * who wants the rest. One live line from /api/jinx, three counts read from the
 * same data /jinx uses, and the cat. The detail (instruments, the service
 * directory, the maintenance notes) lives on /jinx and is not repeated here.
 */
import PixelArt from './PixelArt.astro';
import HiddenStamp from './HiddenStamp.astro';
import { url } from '../lib/url.js';
import { SERVICES, STATIC } from '../data/jinx.js';
import { jinxCat, jinxPalette } from '../data/pixelArt.js';

/* the site itself is files too; the API is one more service */
const counts = [
	[STATIC.length + 1, 'sites served straight off disk'],
	[SERVICES.length + 1, 'Node services, the API among them'],
	[0, 'ports open to the internet'],
];
---

<section id="backroom" class="backroom" aria-labelledby="backroom-title">
	<div class="wrap backroom-inner">
		<div class="br-copy">
			<h2 id="backroom-title" class="br-title">The back room</h2>
			<p>
				Jinx is a computer in my flat, and every running project above is served from it: some as plain files, some
				as their own little Node service, all behind one reverse proxy and a tunnel that dials out.
			</p>
			<p class="br-vitals label" aria-live="polite">
				<span class="br-led" id="cabinet-vitals" aria-hidden="true"></span>
				<span id="cabinet-vitals-text">Asking the box how it is…</span>
			</p>
			<ul class="br-counts" role="list">
				{
					counts.map(([n, t]) => (
						<li>
							<b>{n}</b>
							<span>{t}</span>
						</li>
					))
				}
			</ul>
			<div class="br-actions">
				<a href={url('jinx')} class="btn btn-stamp">Visit the observatory</a>
				<a href="https://lab.futile.studio" class="br-link" target="_blank" rel="noopener">
					Unfinished things, at lab.futile.studio<span class="visually-hidden">, opens in a new tab</span>
				</a>
			</div>
		</div>

		<figure class="br-portrait">
			<div class="br-frame">
				<PixelArt rows={jinxCat} palette={jinxPalette} />
				<HiddenStamp id="jinx" class="br-stamp" />
			</div>
			<figcaption class="script">Jinx, the cat. The server took her name.</figcaption>
		</figure>
	</div>
</section>

<script>
	import { API_BASE } from '../lib/api.js';

	/* One honest line about the server, or an honest line about its absence. */
	(async () => {
		const led = document.getElementById('cabinet-vitals');
		const text = document.getElementById('cabinet-vitals-text');
		if (!led || !text) return;
		try {
			const res = await fetch(`${API_BASE}/api/jinx`, { headers: { Accept: 'application/json' } });
			if (!res.ok) throw new Error(String(res.status));
			const d = await res.json();
			const days = Math.floor(d.hostUptime / 86400);
			const hours = Math.floor((d.hostUptime % 86400) / 3600);
			text.textContent = `Awake. Up ${days ? `${days} d ` : ''}${hours} h · ${d.cpus} cores · load ${d.loadavg[0]}`;
			led.dataset.state = 'ok';
		} catch {
			text.textContent = 'Not answering from here right now. The observatory says the same.';
			led.dataset.state = 'down';
		}
	})();
</script>

<style>
	.backroom {
		position: relative;
		background: var(--night);
		color: var(--forest-ink);
		padding-block: clamp(4.5rem, 9vw, 6.5rem);
		/* a torn top edge where the paper gives way to the back room */
		clip-path: polygon(0 1.4rem, 6% 0.4rem, 14% 1.2rem, 23% 0, 31% 1rem, 42% 0.3rem, 50% 1.3rem, 61% 0.2rem, 70% 1.1rem, 79% 0.1rem, 88% 1rem, 95% 0.3rem, 100% 1.1rem, 100% 100%, 0 100%);
		--ink-soft: rgba(236, 228, 210, 0.76);
	}
	.backroom ::selection {
		background: var(--lime);
		color: var(--night);
	}
	.backroom :focus-visible {
		outline-color: var(--lime);
	}
	.backroom-inner {
		display: grid;
		grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
		gap: clamp(2rem, 6vw, 5rem);
		align-items: center;
	}
	.br-title {
		font-size: clamp(3rem, 7vw, 6rem);
		font-weight: 800;
		font-variation-settings: 'wdth' 75;
		letter-spacing: -0.035em;
		line-height: 0.9;
		margin-bottom: 1.2rem;
	}
	.br-copy > p {
		color: var(--ink-soft);
		max-width: 34rem;
	}
	.br-vitals {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 1.2rem 0;
		color: var(--forest-ink);
		text-transform: none;
		letter-spacing: 0.02em;
	}
	.br-led {
		flex: none;
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 50%;
		background: #8a8579;
	}
	.br-led[data-state='ok'] {
		background: var(--lime);
		box-shadow: 0 0 0 3px rgba(198, 232, 74, 0.18);
	}
	.br-led[data-state='down'] {
		background: #e0ad5c;
	}
	.br-counts {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
		max-width: 34rem;
		margin-bottom: 1.6rem;
		padding-block: 0.9rem;
		border-block: 1px dashed rgba(236, 228, 210, 0.2);
	}
	.br-counts li {
		display: grid;
		gap: 0.2rem;
	}
	.br-counts b {
		font-family: var(--mono);
		font-size: 1.6rem;
		font-weight: 500;
		line-height: 1;
		color: var(--lime);
	}
	.br-counts span {
		font-size: 0.78rem;
		line-height: 1.3;
		color: var(--ink-soft);
	}
	.br-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.8rem 1.4rem;
	}
	.br-link {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		color: var(--forest-ink);
	}

	/* the portrait, framed like a photo on the server's shelf */
	.br-portrait {
		justify-self: center;
		width: min(100%, 15rem);
		margin: 0;
	}
	.br-frame {
		position: relative;
		padding: 1.1rem;
		background: #0f131c;
		border: 1px solid rgba(236, 228, 210, 0.16);
		box-shadow: inset 0 0 0 6px #161b26;
		rotate: 2deg;
	}
	.br-frame :global(.br-stamp) {
		right: -1.2rem;
		bottom: -1.4rem;
		--peek-tilt: 10deg;
	}
	.br-portrait figcaption {
		margin-top: 0.9rem;
		text-align: center;
		color: var(--ink-soft);
	}

	@media (max-width: 860px) {
		.backroom-inner {
			grid-template-columns: minmax(0, 1fr);
		}
		.br-portrait {
			width: min(70%, 13rem);
		}
		.br-frame :global(.br-stamp) {
			right: -0.6rem;
		}
	}
	@media (max-width: 420px) {
		.br-counts {
			grid-template-columns: minmax(0, 1fr);
			gap: 0.6rem;
		}
		.br-counts li {
			grid-template-columns: 2.4rem minmax(0, 1fr);
			align-items: baseline;
		}
	}
</style>
