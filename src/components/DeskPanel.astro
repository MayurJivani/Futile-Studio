---
/**
 * The desk drawer. Guideline B's feature bank calls for a settings panel done
 * "properly (actual accessibility controls, not just a theme switch)", so these
 * are real: text scaling drives the root font size and every scrapbook rule is
 * authored in rem, high contrast collapses the partial-alpha ink to solid, and
 * the motion setting overrides the OS preference in both directions rather than
 * only being able to turn motion down.
 *
 * Writes one key, `futile-desk`. Layout.astro reads it inline before first paint
 * so a chosen setting never flashes the default first.
 */
---

<div class="desk-backdrop" id="desk-backdrop" hidden></div>

<aside class="desk" id="desk-panel" aria-labelledby="desk-title" hidden>
	<div class="desk-head">
		<h2 id="desk-title">The desk</h2>
		<button class="desk-close" id="desk-close" aria-label="Close the desk">✕</button>
	</div>

	<fieldset class="desk-group">
		<legend>Lamp</legend>
		<div class="desk-row" role="radiogroup" aria-label="Lamp">
			<button class="chip" data-set="lamp" data-val="on">On</button>
			<button class="chip" data-set="lamp" data-val="off">Off</button>
		</div>
		<p class="desk-hint">Off is the same paper, later in the evening.</p>
	</fieldset>

	<fieldset class="desk-group">
		<legend>Text size</legend>
		<div class="desk-row" role="radiogroup" aria-label="Text size">
			<button class="chip" data-set="scale" data-val="1">Normal</button>
			<button class="chip" data-set="scale" data-val="1.14">Large</button>
			<button class="chip" data-set="scale" data-val="1.3">Larger</button>
		</div>
	</fieldset>

	<fieldset class="desk-group">
		<legend>Contrast</legend>
		<label class="desk-check">
			<input type="checkbox" id="desk-contrast" />
			<span>Darken every line and label</span>
		</label>
	</fieldset>

	<fieldset class="desk-group">
		<legend>Other visitors</legend>
		<label class="desk-check">
			<input type="checkbox" id="desk-cursors" />
			<span>Show other people's cursors</span>
		</label>
		<p class="desk-hint">
			Anonymous, and only while somebody else is actually on the same page. Off unless you say so.
		</p>
	</fieldset>

	<fieldset class="desk-group">
		<legend>Motion</legend>
		<div class="desk-row" role="radiogroup" aria-label="Motion">
			<button class="chip" data-set="motion" data-val="system">System</button>
			<button class="chip" data-set="motion" data-val="on">On</button>
			<button class="chip" data-set="motion" data-val="off">Off</button>
		</div>
		<p class="desk-hint">The drop-in, the tilts, the lamp fade, the ticker.</p>
	</fieldset>

	<footer class="desk-foot">
		<span>Saved on this device.</span>
		<button class="btn" id="desk-reset">Clear the desk</button>
	</footer>
</aside>

<script>
	type Desk = { lamp: string; scale: string; contrast: boolean; motion: string; cursors: boolean };

	const KEY = 'futile-desk';
	const DEFAULTS: Desk = { lamp: 'on', scale: '1', contrast: false, motion: 'system', cursors: false };
	const root = document.documentElement;

	const panel = document.getElementById('desk-panel')!;
	const backdrop = document.getElementById('desk-backdrop')!;
	const openBtn = document.getElementById('desk-open');
	const closeBtn = document.getElementById('desk-close');
	const lampBtn = document.getElementById('lamp-toggle');
	const contrastBox = document.getElementById('desk-contrast') as HTMLInputElement | null;
	const cursorBox = document.getElementById('desk-cursors') as HTMLInputElement | null;

	function read(): Desk {
		try {
			return { ...DEFAULTS, ...JSON.parse(localStorage.getItem(KEY) || '{}') };
		} catch {
			return { ...DEFAULTS };
		}
	}

	function write(next: Desk) {
		try {
			localStorage.setItem(KEY, JSON.stringify(next));
		} catch {
			/* storage blocked: the setting still applies for this page view */
		}
	}

	let desk = read();

	function apply() {
		if (desk.lamp === 'off') root.dataset.lamp = 'off';
		else delete root.dataset.lamp;

		root.style.setProperty('--text-scale', desk.scale);

		if (desk.contrast) root.dataset.contrast = 'high';
		else delete root.dataset.contrast;

		if (desk.motion === 'system') delete root.dataset.motion;
		else root.dataset.motion = desk.motion;

		/* Reflect state into every control that shows it. */
		document.querySelectorAll<HTMLElement>('.chip[data-set]').forEach((chip) => {
			const key = chip.dataset.set as keyof Desk;
			const on = String(desk[key]) === chip.dataset.val;
			chip.classList.toggle('is-on', on);
			chip.setAttribute('aria-pressed', on ? 'true' : 'false');
		});
		if (contrastBox) contrastBox.checked = desk.contrast;
		if (cursorBox) cursorBox.checked = desk.cursors;
		/* The cursor layer is its own component; tell it the switch moved. */
		window.dispatchEvent(new CustomEvent('futile-desk-change'));
		lampBtn?.setAttribute('aria-pressed', desk.lamp === 'on' ? 'true' : 'false');
	}

	function set(patch: Partial<Desk>) {
		desk = { ...desk, ...patch };
		write(desk);
		apply();
	}

	/* ---------- open / close ---------- */
	let lastFocused: HTMLElement | null = null;

	function setPanel(open: boolean) {
		panel.hidden = !open;
		backdrop.hidden = !open;
		openBtn?.setAttribute('aria-expanded', open ? 'true' : 'false');
		if (open) {
			lastFocused = document.activeElement as HTMLElement;
			(closeBtn as HTMLElement | null)?.focus();
		} else {
			lastFocused?.focus();
		}
	}

	openBtn?.addEventListener('click', () => setPanel(panel.hidden));
	closeBtn?.addEventListener('click', () => setPanel(false));
	backdrop.addEventListener('click', () => setPanel(false));
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && !panel.hidden) setPanel(false);
	});

	/* Keep focus inside the drawer while it's open. */
	panel.addEventListener('keydown', (e) => {
		if (e.key !== 'Tab') return;
		const stops = panel.querySelectorAll<HTMLElement>('button, input, [href]');
		if (!stops.length) return;
		const first = stops[0];
		const last = stops[stops.length - 1];
		if (e.shiftKey && document.activeElement === first) {
			e.preventDefault();
			last.focus();
		} else if (!e.shiftKey && document.activeElement === last) {
			e.preventDefault();
			first.focus();
		}
	});

	/* ---------- controls ---------- */
	document.querySelectorAll<HTMLElement>('.chip[data-set]').forEach((chip) => {
		chip.addEventListener('click', () => set({ [chip.dataset.set!]: chip.dataset.val } as Partial<Desk>));
	});

	contrastBox?.addEventListener('change', () => set({ contrast: !!contrastBox.checked }));
	cursorBox?.addEventListener('change', () => set({ cursors: !!cursorBox.checked }));

	/* The lamp in the tab strip is the same setting, reachable without the drawer. */
	lampBtn?.addEventListener('click', () => set({ lamp: desk.lamp === 'off' ? 'on' : 'off' }));

	document.getElementById('desk-reset')?.addEventListener('click', () => {
		try {
			localStorage.removeItem(KEY);
		} catch {
			/* nothing to clear */
		}
		desk = { ...DEFAULTS };
		apply();
	});

	apply();
</script>

<style>
	.desk-backdrop {
		position: fixed;
		inset: 0;
		z-index: 190;
		background: rgba(20, 16, 10, 0.45);
	}

	.desk {
		position: fixed;
		top: 0;
		right: 0;
		z-index: 200;
		width: min(21rem, 90vw);
		height: 100vh;
		overflow-y: auto;
		padding: 1.4rem 1.5rem 2.5rem;
		background: var(--card);
		border-left: 2px solid var(--ink-soft);
		box-shadow: -7px 0 0 var(--shadow);
		/* Ruled like a notepad, because that is what a drawer liner looks like. */
		background-image: linear-gradient(var(--ink-ghost) 1px, transparent 1px);
		background-size: 100% 1.9rem;
	}
	.desk[hidden],
	.desk-backdrop[hidden] {
		display: none;
	}

	.desk-head {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		padding-bottom: 0.9rem;
		margin-bottom: 1.2rem;
		border-bottom: 2px dashed var(--ink-ghost);
	}
	.desk-head h2 {
		font-size: 1.3rem;
	}
	.desk-close {
		background: none;
		border: none;
		cursor: pointer;
		font-size: 1rem;
		color: var(--ink-soft);
		padding: 0.2rem 0.4rem;
		border-radius: 5px;
	}
	.desk-close:hover {
		color: var(--stamp);
	}

	.desk-group {
		border: none;
		margin-bottom: 1.4rem;
	}
	.desk-group legend {
		font-family: var(--bubble);
		font-weight: 800;
		font-size: 0.78rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--ink-faint);
		margin-bottom: 0.5rem;
	}

	.desk-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}

	.chip {
		font-family: var(--hand);
		font-weight: 700;
		font-size: 0.8rem;
		color: var(--ink);
		background: var(--paper);
		border: 1.5px solid var(--ink-soft);
		border-radius: 7px;
		padding: 0.32rem 0.7rem;
		cursor: pointer;
		box-shadow: 2px 2px 0 var(--shadow);
		transition:
			transform 0.12s ease,
			box-shadow 0.12s ease;
	}
	.chip:hover {
		transform: translate(-1px, -1px);
		box-shadow: 3px 3px 0 var(--shadow);
	}
	/* The chosen chip is pressed flat into the page. */
	.chip.is-on {
		background: var(--stamp);
		border-color: var(--stamp);
		color: #fff;
		transform: translate(1px, 1px);
		box-shadow: 0 0 0 var(--shadow);
	}

	.desk-check {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.85rem;
		cursor: pointer;
	}
	.desk-check input {
		width: 1rem;
		height: 1rem;
		accent-color: var(--stamp);
		cursor: pointer;
	}

	.desk-hint {
		font-size: 0.74rem;
		font-style: italic;
		color: var(--ink-faint);
		margin-top: 0.4rem;
		line-height: 1.45;
	}

	.desk-foot {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.8rem;
		flex-wrap: wrap;
		padding-top: 1rem;
		border-top: 2px dashed var(--ink-ghost);
		font-size: 0.74rem;
		color: var(--ink-faint);
	}
</style>
