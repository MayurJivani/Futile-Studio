---
import { entries, byMonth, firstYear } from '../data/log.js';
import Sketch from './Sketch.astro';

/**
 * The log book. Guideline B's feature bank flags the reference site's calendar
 * as worth re-skinning, so this keeps the craft from it (paint behind the date,
 * inked up to today and outline after, a busy marker when a cell holds more
 * than one) and lays it out as a year per row.
 *
 * A row per year rather than one long tape: twelve columns fit any width, so
 * the whole history is on screen at once instead of behind a sideways scroll.
 */
const MONTHS = ['J', 'F', 'M', 'A', 'M', 'J', 'J', 'A', 'S', 'O', 'N', 'D'];
const FULL = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

const now = new Date();
const thisYear = now.getFullYear();
const thisMonth = now.getMonth() + 1;

const years = [];
for (let y = firstYear; y <= thisYear; y++) {
	years.push({
		year: y,
		cells: Array.from({ length: 12 }, (_, i) => {
			const m = i + 1;
			const key = `${y}-${String(m).padStart(2, '0')}`;
			return {
				key,
				label: MONTHS[i],
				full: FULL[i],
				started: byMonth[key] || [],
				future: y === thisYear && m > thisMonth,
				today: y === thisYear && m === thisMonth,
			};
		}),
	});
}

const busiest = Math.max(...Object.values(byMonth).map((m) => m.length));
---

<section id="log" class="log">
	<span class="doodle doodle-archive" aria-hidden="true"><Sketch name="archive" /></span>
	<div class="log-head">
		<h2 class="sect-label">
			The log book
			<span class="sect-doodle"><Sketch name="snips" /></span>
		</h2>
		<p class="log-intro">
			A cell a month since the first one, dated from the repository rather than from memory. Painted cells are
			months a new thing started, and the dashed ones are still ahead.
		</p>
	</div>

	<div class="log-grid" role="table" aria-label="Projects by month">
		<div class="log-row log-row-head" role="row">
			<span class="log-year" role="columnheader"></span>
			{
				MONTHS.map((m, i) => (
					<span class="log-month-head" role="columnheader" title={FULL[i]}>
						{m}
					</span>
				))
			}
		</div>

		{
			years.map((row) => (
				<div class="log-row" role="row">
					<span class="log-year" role="rowheader">
						{row.year}
					</span>
					{row.cells.map((cell) => (
						<div
							class:list={[
								'log-cell',
								{
									'is-future': cell.future,
									'is-today': cell.today,
									'has-ship': cell.started.length > 0,
									'is-busy': cell.started.length > 1,
								},
							]}
							role="cell"
							tabindex={cell.started.length ? 0 : -1}
							aria-label={`${cell.full} ${row.year}${
								cell.started.length ? `: ${cell.started.map((e) => e.name).join(', ')}` : ''
							}`}
						>
							{cell.started.length > 0 && <span class="log-blob" aria-hidden="true" />}
							{cell.started.length > 1 && <span class="log-busy" aria-hidden="true" />}
							{cell.today && (
								<span class="log-now" aria-hidden="true">
									now
								</span>
							)}

							{cell.started.length > 0 && (
								<span class="log-pop">
									{cell.started.map((e) => (
										<span class="log-pop-name">{e.name}</span>
									))}
									<span class="log-pop-date">
										{cell.full} {row.year}
									</span>
								</span>
							)}
						</div>
					))}
				</div>
			))
		}
	</div>

	<p class="log-stat">
		<span class="stamp">{entries.length} in the book</span>
		<span class="log-stat-note">
			across {years.length} years, with {busiest} starting in the busiest month.
		</span>
	</p>
</section>

<style>
	.log {
		max-width: 1140px;
		margin: 0 auto;
		padding: 3.5rem 2.2rem 4rem;
		position: relative;
	}

	.doodle-archive {
		top: 2.6rem;
		right: 3%;
		width: 2.7rem;
		height: 2.7rem;
		transform: rotate(7deg);
	}
	@media (max-width: 1000px) {
		.doodle-archive {
			display: none;
		}
	}

	.log-head {
		max-width: 44rem;
		margin-bottom: 1.8rem;
	}
	.sect-doodle {
		width: 3.2rem;
		height: 1.3rem;
		color: var(--ink-faint);
		opacity: 0.75;
	}
	.log-intro {
		font-size: 0.92rem;
		color: var(--ink-soft);
		line-height: 1.7;
		max-width: 38rem;
	}

	/* ---------- the grid ---------- */
	.log-grid {
		display: flex;
		flex-direction: column;
		gap: 4px;
		padding: 0.7rem 0.8rem 0.8rem;
		background: var(--card-2);
		border: 1.5px solid var(--ink-soft);
		border-radius: 8px;
		box-shadow: 4px 4px 0 var(--shadow);
	}

	/* Twelve fr columns, so a year always spans the width whatever it is. */
	.log-row {
		display: grid;
		grid-template-columns: 2.9rem repeat(12, minmax(0, 1fr));
		gap: 4px;
		align-items: center;
	}

	.log-month-head {
		text-align: center;
		font-family: var(--bubble);
		font-weight: 800;
		font-size: 0.62rem;
		color: var(--ink-faint);
	}
	.log-year {
		font-family: var(--bubble);
		font-weight: 800;
		font-size: 0.74rem;
		color: var(--ink-soft);
		font-variant-numeric: tabular-nums;
	}

	.log-cell {
		position: relative;
		height: 1.9rem;
		border-radius: 4px;
		background: var(--card);
		border: 1.5px solid transparent;
	}

	/* Months still ahead: outline only, waiting to be inked. */
	.log-cell.is-future {
		background: transparent;
		border-color: var(--ink-ghost);
		border-style: dashed;
	}

	.log-cell.is-today {
		border-color: var(--ink);
		border-style: solid;
	}
	.log-now {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		font-family: var(--bubble);
		font-weight: 800;
		font-size: 0.5rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--ink);
		z-index: 3;
	}
	.log-cell.has-ship .log-now {
		color: #fff;
	}

	/* Paint, brushed on rather than a tidy rectangle. */
	.log-blob {
		position: absolute;
		inset: 2px;
		z-index: 1;
		background: var(--stamp);
		opacity: 0.85;
		border-radius: 58% 42% 55% 45% / 50% 56% 44% 50%;
		transform: rotate(-4deg);
	}

	/* More than one that month: a corner dot rather than a crowded cell. */
	.log-busy {
		position: absolute;
		top: 3px;
		right: 3px;
		z-index: 3;
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: #fff;
	}

	/* ---------- what landed ---------- */
	.log-pop {
		position: absolute;
		bottom: calc(100% + 0.45rem);
		left: 50%;
		z-index: 20;
		transform: translateX(-50%) rotate(-1.5deg);
		display: flex;
		flex-direction: column;
		gap: 1px;
		min-width: 6.5rem;
		padding: 0.4rem 0.6rem;
		background: var(--marker);
		color: #1b2132;
		border: 1.5px solid var(--ink);
		border-radius: 5px;
		box-shadow: 3px 3px 0 var(--shadow-deep);
		opacity: 0;
		pointer-events: none;
		translate: 0 4px;
		transition:
			opacity 0.18s ease,
			translate 0.18s ease;
	}
	.log-cell:hover .log-pop,
	.log-cell:focus-visible .log-pop {
		opacity: 1;
		translate: 0 0;
	}

	/* A centred popup on January or December hangs off the side of the grid and,
	   on a narrow screen, off the page. Anchor the outer columns to their own
	   edge instead. Cells are children 2-13 of the row. */
	.log-cell:nth-child(-n + 4) .log-pop {
		left: 0;
		transform: translateX(0) rotate(-1.5deg);
	}
	.log-cell:nth-child(n + 11) .log-pop {
		left: auto;
		right: 0;
		transform: translateX(0) rotate(-1.5deg);
	}
	.log-pop-name {
		font-family: var(--bubble);
		font-weight: 800;
		font-size: 0.78rem;
		white-space: nowrap;
	}
	.log-pop-date {
		font-size: 0.64rem;
		opacity: 0.7;
		white-space: nowrap;
	}

	.log-stat {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		flex-wrap: wrap;
		margin-top: 1.6rem;
	}
	.log-stat-note {
		font-size: 0.82rem;
		font-style: italic;
		color: var(--ink-faint);
	}

	@media (max-width: 760px) {
		.log {
			padding: 2.8rem 1.4rem 3rem;
		}
		.log-grid {
			padding: 0.5rem 0.5rem 0.6rem;
		}
		.log-row {
			grid-template-columns: 2.2rem repeat(12, minmax(0, 1fr));
			gap: 3px;
		}
		.log-cell {
			height: 1.5rem;
		}
		.log-year {
			font-size: 0.62rem;
		}
		.log-month-head {
			font-size: 0.5rem;
		}
	}
</style>
