---
import { url } from '../lib/url.js';
/**
 * The Field Guide's ears. Mounted once by the layout on every scrapbook page,
 * so a clue on /jinx counts as much as one on the homepage.
 *
 * Anything carrying `data-clue="id"` earns that stamp when clicked. Two clues
 * are not clicks: visiting /jinx, and the lamp actually changing state (the
 * cord can be dragged as well as clicked, so the lamp is watched instead).
 * A small paper slip confirms each new stamp, read out politely.
 */
import { stamps } from '../data/stamps.js';

const names = Object.fromEntries(stamps.map((s) => [s.id, s.title]));
const total = stamps.length;
---

<!-- The live region stays put and the slip appears inside it, which screen
     readers announce more reliably than a region that unhides itself. -->
<div role="status" aria-live="polite">
	<div class="slip on-paper" id="stamp-slip" hidden>
		<span class="slip-art" id="stamp-slip-art" aria-hidden="true"><span class="slip-ring"></span></span>
		<span class="slip-copy">
			<span class="slip-head">Added to the album</span>
			<span class="slip-name" id="stamp-slip-name"></span>
		</span>
		<a class="slip-link" href={url('#guide')} id="stamp-slip-count"></a>
	</div>
</div>

<script define:vars={{ names, total }} is:inline>
	window.__futileStampNames = names;
	window.__futileStampTotal = total;
</script>

<script>
	import { animate } from 'motion';
	import { collect, collected } from '../lib/guide.js';

	const names: Record<string, string> = (window as any).__futileStampNames || {};
	const total: number = (window as any).__futileStampTotal || 0;
	const slip = document.getElementById('stamp-slip')!;
	const nameEl = document.getElementById('stamp-slip-name')!;
	const countEl = document.getElementById('stamp-slip-count')!;
	const artEl = document.getElementById('stamp-slip-art')!;

	/* A stamp hidden in the page peels away once it is in the album, leaving
	   its cancellation mark where it was stuck. */
	const peel = (fresh?: string) => {
		const got = collected();
		document.querySelectorAll<HTMLElement>('.hidden-stamp[data-clue]').forEach((el) => {
			const on = got.has(el.dataset.clue!);
			const art = el.querySelector<SVGElement>('.stamp-art')!;
			/* lifted by one corner: it springs up and away, fading as it goes */
			if (on && el.dataset.clue === fresh && !still())
				animate(
					art,
					{ x: [0, 10], y: [0, -22], rotate: [0, 24], opacity: [1, 0] },
					{ type: 'spring', stiffness: 260, damping: 14, opacity: { duration: 0.4, delay: 0.12 } },
				);
			/* a clean album puts it back where it was stuck */
			if (!on) art.style.opacity = art.style.transform = '';
			el.classList.toggle('is-peeled', on);
			/* Collected: the mark left behind is decoration, not a control. */
			el.tabIndex = on ? -1 : 0;
			el.toggleAttribute('aria-hidden', on);
		});
	};
	const root = document.documentElement;
	const still = () =>
		root.dataset.motion === 'off' ||
		(root.dataset.motion !== 'on' && matchMedia('(prefers-reduced-motion: reduce)').matches);
	peel();
	window.addEventListener('futile-stamp', (e) => peel((e as CustomEvent).detail?.id));
	const two = (n: number) => String(n).padStart(2, '0');

	let hideTimer = 0;
	window.addEventListener('futile-stamp', (e) => {
		const id = (e as CustomEvent).detail?.id;
		if (!id || !names[id]) return;
		nameEl.textContent = names[id];
		/* Show the actual stamp when this page has its artwork to copy: the
		   album's postmarked copy first, else any (a hidden one mid-peel). */
		const art = document.querySelector(`.slot[data-stamp="${id}"] .stamp-art`) ?? document.querySelector(`[data-stamp-art="${id}"]`);
		const copy = art?.cloneNode(true) as SVGElement | undefined;
		/* the copy must not inherit a running animation's half-way inline state */
		copy?.style.removeProperty('opacity');
		copy?.style.removeProperty('transform');
		artEl.replaceChildren(copy ?? Object.assign(document.createElement('span'), { className: 'slip-ring' }));
		countEl.textContent = `${two(collected().size)} / ${two(total)} in the album`;
		slip.hidden = false;
		if (!still()) {
			animate(slip, { y: [-16, 0], opacity: [0, 1] }, { type: 'spring', stiffness: 380, damping: 26 });
			animate(
				artEl,
				{ scale: [1.6, 1], rotate: [-30, -8] },
				{ type: 'spring', stiffness: 500, damping: 18 },
			);
			const mark = artEl.querySelector('.stamp-cancel');
			if (mark) animate(mark, { opacity: [0, 0.7] }, { duration: 0.45, delay: 0.3 });
		}
		clearTimeout(hideTimer);
		hideTimer = window.setTimeout(() => (slip.hidden = true), 4200);
	});

	document.addEventListener('click', (e) => {
		const el = (e.target as HTMLElement).closest<HTMLElement>('[data-clue]');
		if (el?.dataset.clue) collect(el.dataset.clue);
	});

	if (location.pathname.replace(/\/$/, '').endsWith('/jinx')) collect('jinx');

	new MutationObserver(() => collect('lamp')).observe(root, { attributes: true, attributeFilter: ['data-lamp'] });
</script>

<style is:global>
	/* A printed slip from the post office: perforated along the top, the
	   stamp pressed on, title in catalogue capitals, the tally in mono. */
	.slip {
		/* top right, under the nav: well away from whatever was just pressed */
		position: fixed;
		right: max(1rem, env(safe-area-inset-right, 0px));
		top: 4.8rem;
		z-index: 950;
		display: flex;
		align-items: center;
		gap: 0.9rem;
		max-width: calc(100vw - 2rem);
		padding: 0.9rem 1rem 0.75rem 0.9rem;
		background: var(--card);
		color: var(--ink);
		border-radius: 0 0 2px 2px;
		box-shadow: var(--lift-high);
		/* torn off a perforated pad: a row of punched dots along the top */
		background-image: radial-gradient(circle, var(--ink-ghost) 1.6px, transparent 2px);
		background-size: 9px 8px;
		background-repeat: repeat-x;
	}
	.slip[hidden] {
		display: none;
	}
	.slip-art {
		flex: none;
		width: 2.8rem;
		rotate: -8deg;
	}
	.slip-ring {
		display: block;
		width: 2.4rem;
		height: 2.4rem;
		border-radius: 50%;
		border: 2px solid var(--stamp);
		box-shadow: inset 0 0 0 3px var(--card), inset 0 0 0 4.5px var(--stamp);
	}
	.slip-copy {
		display: flex;
		flex-direction: column;
		line-height: 1.2;
	}
	.slip-head {
		font-family: var(--mono);
		font-size: 0.6rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-soft);
	}
	.slip-name {
		font-family: var(--label-face);
		font-size: 1.5rem;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		line-height: 1;
	}
	.slip-link {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		margin-left: 0.4rem;
		padding-left: 0.9rem;
		border-left: 1px dashed var(--ink-ghost);
		font-family: var(--mono);
		font-size: 0.66rem;
		font-variant-numeric: tabular-nums lining-nums;
		color: var(--ink-soft);
		white-space: nowrap;
	}
</style>
