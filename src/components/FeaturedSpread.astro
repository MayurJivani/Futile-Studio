---
/**
 * One featured project as a magazine spread. The structure is shared (title,
 * facts, the real screenshot, the links, a pencilled note and a tucked stamp)
 * and the `variant` decides the layout and the paper it is printed on, so
 * seven spreads in a row never read as one card repeated.
 *
 * The screenshot is itself a link to the running thing. The stamp is a
 * separate button beside it, never inside the link.
 */
import HiddenStamp from './HiddenStamp.astro';
import PixelArt from './PixelArt.astro';
import { patinaScene, patinaPalette, patinaWet } from '../data/pixelArt.js';
import { url } from '../lib/url.js';
import { shelfOf, sourceOf } from '../data/studio.js';

interface Props {
	p: any;
	f: any;
	index: number;
}
const { p, f, index } = Astro.props;
const source = sourceOf[p.id] && sourceOf[p.id] !== p.href ? sourceOf[p.id] : undefined;
const year = p.shipped?.slice(0, 4);
const titleId = `spread-${p.id}`;
---

<article class:list={['spread', `v-${f.variant}`]} aria-labelledby={titleId} data-spread>
	<div class="spread-inner wrap">
		<header class="spread-text">
			<p class="spread-meta label">
				<span class="spread-live">Live</span>
				<span>{shelfOf[p.id]}, {p.kind}</span>
				{year && <span>{year}</span>}
			</p>
			<h3 class="spread-title" id={titleId}>{p.name}</h3>
			<p class="spread-desc">{p.desc}</p>
			<p class="spread-stack label">{p.stack}</p>
			<p class="spread-actions">
				<a class="btn btn-stamp" href={p.href} target="_blank" rel="noopener" data-clue={`p-${p.id}`}>
					{p.cta}
					<span class="visually-hidden">: {p.name}, opens in a new tab</span>
					<svg viewBox="0 0 16 16" aria-hidden="true">
						<path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
					</svg>
				</a>
				{
					source && (
						<a class="spread-src" href={source} target="_blank" rel="noopener">
							Source<span class="visually-hidden"> for {p.name}, opens in a new tab</span>
						</a>
					)
				}
			</p>
		</header>

		<div class="spread-stage" data-depth-stage>
			{
				f.art === 'patina' ? (
					<a class="spread-shot spread-canvas" href={p.href} target="_blank" rel="noopener" data-clue={`p-${p.id}`} data-depth="0.6" tabindex="-1">
						<span class="canvas-px">
						<PixelArt
							rows={patinaScene}
							palette={patinaPalette}
							label="Pixel art in the spirit of a Patina canvas: a house, a tree and a lake under the moon, a heart and an HI from other painters, and rust and verdigris where the paint was fought over. An illustration, not a screenshot."
						/>
						<span class="canvas-wet" aria-hidden="true" style={`--x:${patinaWet.x}; --y:${patinaWet.y}`} />
						</span>
						<span class="canvas-cap label" aria-hidden="true">64 × 40 cells of 4096 × 4096 · drawn, not captured</span>
					</a>
				) : (
			<a
					class="spread-shot"
					href={p.href}
					target="_blank"
					rel="noopener"
					data-clue={`p-${p.id}`}
					data-depth="0.6"
					tabindex="-1"
				>
					<img
						src={url(f.shot.src)}
						alt={f.shot.alt}
						width={f.shot.w ?? 1280}
						height={f.shot.h ?? 800}
						loading={index === 0 ? 'eager' : 'lazy'}
						decoding="async"
					/>
				</a>
				)
			}
			{
				f.phone && (
					<figure class="spread-phone" data-depth="1.4">
						<img src={url(f.phone.src)} alt={f.phone.alt} width={f.phone.w ?? 390} height={f.phone.h ?? 780} loading="lazy" decoding="async" />
					</figure>
				)
			}
			{
				f.live && (
					<figure class="spread-live-clip" data-depth="1.4">
						<picture>
							{/* Reduced motion gets the last frame: the same finished stage, without the replay. */}
							<source srcset={url(f.live.still)} media="(prefers-reduced-motion: reduce)" />
							<img src={url(f.live.src)} alt={f.live.alt} width="640" height="360" loading="lazy" decoding="async" />
						</picture>
						<figcaption class="label"><span class="spread-live-dot" aria-hidden="true"></span>The stage, as a mod works it</figcaption>
					</figure>
				)
			}
			<p class="spread-note script" aria-hidden="true" data-depth="1">
				<svg viewBox="0 0 60 30" class="spread-arrow">
					<path d="M2 6c14-4 34 0 44 16m0 0-8-2m8 2 1-8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
				</svg>
				{f.note}
			</p>
			{
				f.variant === 'poster' ? (
					<div class="spread-tuck">
						<span class="spread-ticket label" aria-hidden="true">Admit one · {p.name}</span>
						<HiddenStamp id={`p-${p.id}`} class="spread-stamp" />
					</div>
				) : (
					<HiddenStamp id={`p-${p.id}`} class="spread-stamp" />
				)
			}
		</div>
	</div>
</article>

<style>
	.spread {
		position: relative;
		/* the collage may hang past the column, never past the page */
		overflow-x: clip;
		padding-block: clamp(4rem, 9vw, 7.5rem);
		color: var(--ink);
	}
	.spread-inner {
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
		gap: clamp(2rem, 5vw, 5rem);
		align-items: center;
	}

	.spread-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem 1rem;
		margin-bottom: 1rem;
	}
	.spread-live {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--live);
	}
	.spread-live::before {
		content: '';
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: currentColor;
	}
	.spread-title {
		font-size: clamp(3.2rem, 8vw, 7rem);
		font-weight: 800;
		font-variation-settings: 'wdth' 75, 'opsz' 96;
		letter-spacing: -0.035em;
		line-height: 0.88;
		margin-bottom: 1.2rem;
	}
	.spread-desc {
		max-width: 34rem;
		font-size: 1.02rem;
		color: var(--ink-soft);
	}
	.spread-stack {
		margin-top: 1rem;
		text-transform: none;
		letter-spacing: 0.02em;
	}
	.spread-actions {
		display: flex;
		align-items: center;
		gap: 1.2rem;
		margin-top: 1.6rem;
	}
	.spread-src {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		font-size: 0.92rem;
		color: var(--ink-soft);
	}

	.spread-stage {
		position: relative;
		min-height: 18rem;
	}
	.spread-shot {
		display: block;
		position: relative;
		z-index: 1;
		border-radius: 4px;
		overflow: hidden;
		box-shadow: var(--lift-high);
		translate: var(--dx, 0) var(--dy, 0);
		transition: translate 0.6s var(--ease-out);
	}
	.spread-shot img,
	.spread-phone img {
		display: block;
		width: 100%;
		height: auto;
	}
	.spread-shot:hover {
		outline: 2px solid var(--stamp);
		outline-offset: 4px;
	}
	.spread-phone {
		position: absolute;
		z-index: 2;
		width: 26%;
		border: 6px solid #1b1d22;
		border-radius: 18px;
		overflow: hidden;
		box-shadow: var(--lift-high);
		translate: var(--dx, 0) var(--dy, 0);
		transition: translate 0.6s var(--ease-out);
	}
	.spread-note {
		position: absolute;
		z-index: 3;
		display: flex;
		align-items: flex-start;
		gap: 0.3rem;
		max-width: 14rem;
		font-size: 1.4rem;
		color: var(--stamp);
		translate: var(--dx, 0) var(--dy, 0);
		transition: translate 0.6s var(--ease-out);
	}
	/* The arrow is drawn heading right and down. A note above its picture
	   puts the arrow first and mirrors it, so it heads down-left onto the
	   picture; a note below flips it upright, so it climbs back up to it. */
	.spread-arrow {
		flex: none;
		width: 3rem;
		order: 2;
		scale: 1 -1;
	}
	:is(.v-dark, .v-poster, .v-crop) .spread-arrow {
		order: -1;
		scale: -1 1;
		margin-top: 0.6rem;
	}
	/* Stuck over a corner of the photo, never under it: a hidden stamp must
	   still be the thing a click lands on. */
	.spread-stage :global(.spread-stamp) {
		z-index: 4;
	}

	/* ---------- the drawn canvas ---------- */
	.spread-canvas {
		position: relative;
		padding: 0;
		background: #0a1424;
		border: 6px solid #0f1b2e;
		border-radius: 2px;
	}
	/* the drawing must be seen whole, so the phone stands beside it, not on it */
	.spread-canvas {
		width: 78%;
	}
	.spread-stage:has(.spread-canvas) .spread-phone {
		left: auto;
		right: 0;
		top: 12%;
		bottom: auto;
		width: 20%;
		rotate: 4deg;
	}
	.canvas-px {
		position: relative;
		display: block;
	}
	.canvas-cap {
		display: block;
		padding: 0.45rem 0.6rem 0.4rem;
		background: #0f1b2e;
		color: rgba(236, 228, 210, 0.72);
		font-size: 0.62rem;
	}
	/* the newest cell, still wet: one pixel breathing, nothing else moves */
	.canvas-wet {
		position: absolute;
		left: calc(var(--x) / 64 * 100%);
		top: calc(var(--y) / 40 * 100%);
		width: calc(100% / 64);
		aspect-ratio: 1;
		background: #f0d36b;
		animation: wet 2.4s ease-in-out infinite;
		pointer-events: none;
	}
	@keyframes wet {
		50% {
			opacity: 0.25;
		}
	}

	/* ---------- dark: Patina, printed on the night side ---------- */
	.v-dark {
		background: var(--night);
		color: var(--forest-ink);
		--ink-soft: rgba(236, 228, 210, 0.74);
		--live: #7ad48a;
	}
	.v-dark .label {
		color: rgba(236, 228, 210, 0.7);
	}
	.v-dark .spread-src {
		color: rgba(236, 228, 210, 0.78);
	}
	.v-dark .spread-shot {
		rotate: 1.2deg;
	}
	.v-dark .spread-phone {
		left: -6%;
		bottom: -10%;
		rotate: -5deg;
	}
	.v-dark .spread-note {
		right: -1rem;
		top: -3rem;
		color: var(--marker);
	}
	.v-dark :global(.spread-stamp) {
		right: -1.2rem;
		bottom: -1.6rem;
		--peek-tilt: 14deg;
	}

	/* ---------- offset: Orbitle, a photo laid on the page, text to the right ---------- */
	.v-offset .spread-inner {
		grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
	}
	.v-offset .spread-stage {
		order: -1;
	}
	.v-offset .spread-stage::before {
		/* the ring the game asks you to place, drawn on the paper behind the photo */
		content: '';
		position: absolute;
		inset: -12% 8% -12% 20%;
		border: 1.5px dashed var(--ink-faint);
		border-radius: 50%;
	}
	.v-offset .spread-shot {
		rotate: -2deg;
		border: 10px solid var(--card);
		border-bottom-width: 36px;
		border-radius: 2px;
	}
	.v-offset .spread-note {
		left: 2rem;
		bottom: -2.6rem;
	}
	.v-offset :global(.spread-stamp) {
		right: 4%;
		top: -1.8rem;
		--peek-tilt: -10deg;
	}

	/* ---------- poster: Noggin', the title runs over the screen like a bill ---------- */
	.v-poster {
		background: #121214;
		color: #f1e6c8;
		--ink-soft: rgba(241, 230, 200, 0.76);
		--live: #7ad48a;
	}
	.v-poster .label,
	.v-poster .spread-src {
		color: rgba(241, 230, 200, 0.74);
	}
	.v-poster .spread-inner {
		grid-template-columns: 1fr;
	}
	.v-poster .spread-text {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 0 3rem;
		align-items: end;
	}
	.v-poster .spread-title {
		grid-column: 1 / -1;
		font-size: clamp(4rem, 15vw, 13rem);
		color: #d6a640;
		margin-bottom: 0.4rem;
	}
	.v-poster .spread-meta,
	.v-poster .spread-desc,
	.v-poster .spread-stack {
		grid-column: 1;
	}
	.v-poster .spread-actions {
		grid-column: 2;
		grid-row: 3 / span 2;
		justify-self: end;
	}
	/* The TV is the board and the phone stands beside it, never on top of
	   the point values. */
	.v-poster .spread-shot {
		width: 80%;
	}
	.v-poster .spread-phone {
		right: 0;
		top: 10%;
		width: 17%;
		rotate: 4deg;
	}
	/* The ticket and the stamp it hides travel together. */
	.spread-tuck {
		position: absolute;
		z-index: 4;
		left: 2%;
		bottom: -1.4rem;
	}
	.v-poster .spread-ticket {
		position: relative;
		display: inline-block;
		padding: 0.7rem 1.4rem;
		background: #f1e6c8;
		color: #121214;
		rotate: -6deg;
		/* lies over the stamp it is hiding; clicks fall through to the stamp */
		z-index: 5;
		pointer-events: none;
		/* a torn ticket stub: notched ends */
		clip-path: polygon(0 0, 100% 0, 100% 35%, 96% 50%, 100% 65%, 100% 100%, 0 100%, 0 65%, 4% 50%, 0 35%);
	}
	.v-poster .spread-note {
		right: 3%;
		top: -3.4rem;
		color: #d6a640;
	}
	.v-poster :global(.spread-stamp) {
		left: 18%;
		bottom: 0.9rem;
		--peek-tilt: -18deg;
	}

	/* ---------- phones: Chorusify, a phone held up in front of the page ---------- */
	.v-phones .spread-shot {
		width: 82%;
		margin-left: auto;
		rotate: 1deg;
	}
	.v-phones .spread-phone {
		left: 0;
		top: 12%;
		width: 30%;
		rotate: -6deg;
	}
	/* clear of the phone, which hangs below the screenshot on the left */
	.v-phones .spread-note {
		left: 38%;
		bottom: -3.6rem;
	}
	.v-phones :global(.spread-stamp) {
		left: 25%;
		top: 6%;
		--peek-tilt: 8deg;
	}

	/* ---------- vivid: Qno, in its own violet ---------- */
	.v-vivid {
		background: #2b1466;
		color: #f4eefe;
		--ink-soft: rgba(244, 238, 254, 0.8);
		--live: #8ff0a4;
	}
	.v-vivid .label,
	.v-vivid .spread-src {
		color: rgba(244, 238, 254, 0.78);
	}
	.v-vivid .spread-title {
		color: var(--lime);
	}
	.v-vivid .spread-shot {
		rotate: -1.5deg;
		border-radius: 10px;
	}
	.v-vivid .spread-note {
		left: -1rem;
		bottom: -3rem;
		color: var(--lime);
	}
	.v-vivid :global(.spread-stamp) {
		right: 12%;
		bottom: -1.8rem;
		--peek-tilt: 16deg;
	}

	/* ---------- paper: Knock, a phone propped up on the desk ---------- */
	.v-paper .spread-inner {
		grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
	}
	.v-paper .spread-stage {
		order: -1;
		min-height: 30rem;
	}
	.v-paper .spread-shot {
		width: 72%;
		rotate: -1deg;
	}
	.v-paper .spread-phone {
		right: 4%;
		top: 4%;
		width: 34%;
		rotate: 4deg;
	}
	.v-paper .spread-note {
		left: 10%;
		bottom: 0;
	}
	.v-paper :global(.spread-stamp) {
		right: 0;
		bottom: 8%;
		--peek-tilt: -6deg;
	}

	/* ---------- crop: Mosaic, a close-up of the one button that matters ---------- */
	.v-crop {
		background: var(--forest);
		color: var(--forest-ink);
		--ink-soft: rgba(236, 228, 210, 0.76);
		--live: #8fe39e;
	}
	.v-crop .label,
	.v-crop .spread-src {
		color: rgba(236, 228, 210, 0.74);
	}
	.v-crop .spread-shot {
		rotate: 0.8deg;
	}
	/* The moving part, pinned over the corner of the board like a monitor
	   clip: the stage as a mod drags things onto it. */
	.spread-live-clip {
		position: absolute;
		z-index: 2;
		left: -5%;
		bottom: -16%;
		width: 48%;
		margin: 0;
		padding: 0.4rem 0.4rem 0;
		background: #0c0f0d;
		border: 1px solid rgba(200, 240, 74, 0.35);
		border-radius: 8px;
		box-shadow: var(--lift-high);
		rotate: -2deg;
		translate: var(--dx, 0) var(--dy, 0);
		transition: translate 0.6s var(--ease-out);
	}
	.spread-live-clip img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 4px;
	}
	.spread-live-clip figcaption {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.35rem 0.2rem 0.45rem;
		color: rgba(236, 228, 210, 0.8);
	}
	.spread-live-dot {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: var(--lime);
	}
	.v-crop .spread-note {
		right: 0;
		top: -3rem;
		color: var(--lime);
	}
	.v-crop :global(.spread-stamp) {
		right: 3%;
		top: -1.6rem;
		--peek-tilt: -12deg;
	}

	@media (max-width: 860px) {
		.spread-inner,
		.v-offset .spread-inner,
		.v-paper .spread-inner,
		.v-poster .spread-text {
			grid-template-columns: 1fr;
		}
		.v-offset .spread-stage,
		.v-paper .spread-stage {
			order: 0;
		}
		.v-paper .spread-stage {
			min-height: 0;
		}
		.v-poster .spread-actions {
			grid-column: 1;
			grid-row: auto;
			justify-self: start;
		}
		.spread-stage {
			margin-top: 1rem;
			margin-bottom: 2rem;
		}
		.spread-note {
			font-size: 1.2rem;
		}
		/* On a phone a stamp hanging off the column is a stamp half off the
		   screen, so they tuck inside the edge instead. */
		.v-dark :global(.spread-stamp) {
			right: 0.3rem;
		}
		.v-poster .spread-shot {
			width: 78%;
		}
		.v-poster .spread-phone {
			width: 22%;
			top: 4%;
		}
		/* Stacked rather than layered on a phone: the clip and the pencilled
		   note each get their own line under the screenshot, so neither covers
		   it. The phone frames keep their deliberate overlap. */
		.spread-stage {
			min-height: 0;
		}
		.spread-live-clip {
			position: relative;
			left: auto;
			bottom: auto;
			width: 82%;
			margin: -1.5rem 0 0 auto;
		}
		.spread-note,
		.v-dark .spread-note,
		.v-offset .spread-note,
		.v-poster .spread-note,
		.v-phones .spread-note,
		.v-vivid .spread-note,
		.v-paper .spread-note,
		.v-crop .spread-note {
			position: relative;
			inset: auto;
			margin-top: 1.4rem;
			translate: none;
		}
		.spread-tuck {
			position: relative;
			left: auto;
			bottom: auto;
			margin-top: 2.4rem;
		}
		.v-dark .spread-phone {
			bottom: -4%;
			width: 30%;
		}
		/* left, so it stays clear of the stamp tucked at the right */
		.v-dark .spread-note {
			margin: 1.6rem 0 0;
		}
		/* on a phone every note sits under its picture, so every arrow points up */
		:is(.v-dark, .v-poster, .v-crop) .spread-arrow {
			order: 2;
			scale: 1 -1;
			margin-top: 0;
		}
		/* the Chorusify phone hangs below the screenshot: the note waits under it */
		.v-phones .spread-note {
			margin-top: 24%;
		}
		.spread-stage:has(.spread-canvas) .spread-phone {
			width: 21%;
			top: 6%;
			bottom: auto;
		}
		/* the real phone capture is tall; keep it inside its own band */
		.v-paper .spread-phone {
			top: -4%;
			width: 28%;
		}
	}
</style>
