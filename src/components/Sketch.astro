---
/**
 * The sketch bank. Stroke-only line art, rounded caps, drawn at a size that
 * survives being shrunk into a card corner.
 *
 * Two families:
 *  - project sketches (patina, noggin, qno, mosaic, chorus), carried over from
 *    the blueprint theme's hover previews, where they were already doing this job
 *  - desk motifs (scissors, glue, pencil, clip, mug, lamp, snips), the studio
 *    equivalent of Lab's contraption bank. Deliberately not Lab's gear/pulley/
 *    flask set: Guideline B asks each page's motifs to match what the page is about.
 */
interface Props {
	name: string;
	class?: string;
}
const { name, class: className } = Astro.props;
