---
/**
 * Selected work: the projects worth opening first, as spreads.
 *
 * Three motions, all optional and all off under reduced motion:
 *   - each artefact's pieces settle onto the page as it scrolls in, then its
 *     red annotations are inked;
 *   - on a wide screen a layer or two drift with the scroll, like paper at
 *     different heights;
 *   - on a fine pointer, the layers of a spread shift a few pixels with the
 *     pointer, by depth, so the collage reads as stacked paper.
 */
import FeaturedSpread from './FeaturedSpread.astro';
import { open } from '../data/board.js';
import { featured } from '../data/studio.js';

const byId = Object.fromEntries(open.map((p) => [p.id, p]));
const spreads = featured.filter((f) => byId[f.id]);
---

<section id="work" class="featured" aria-labelledby="work-title">
	<div class="featured-head wrap">
		<h2 id="work-title" class="sect-label">Selected work</h2>
		<p class="sect-lede">
			A few things worth opening first. Every screenshot is the running product, and every link goes to it.
		</p>
	</div>
	{spreads.map((f, i) => <FeaturedSpread p={byId[f.id]} f={f} index={i} />)}
</section>

<script>
	import { animate, inView, scroll } from 'motion';

	const root = document.documentElement;
	const still =
		root.dataset.motion === 'off' ||
		(root.dataset.motion !== 'on' && matchMedia('(prefers-reduced-motion: reduce)').matches);

	/* Noggin's buzzer: really pressable. It times you from the moment your
	   pointer (or focus) arrived on the phone, like the race in the game,
	   and buzzes the phone you are holding if it can. */
	document.querySelectorAll<HTMLButtonElement>('[data-buzz]').forEach((btn) => {
		const out = btn.querySelector<HTMLElement>('[data-buzz-ms]')!;
		const hand = btn.closest('figure')!;
		let armed = performance.now();
		const arm = () => (armed = performance.now());
		hand.addEventListener('pointerenter', arm);
		btn.addEventListener('focus', arm);
		btn.addEventListener('click', () => {
			const s = ((performance.now() - armed) / 1000).toFixed(2);
			out.textContent = `buzzed in ${s}s`;
			navigator.vibrate?.(40);
			btn.classList.add('is-hit');
			hand.classList.add('is-buzzed');
			setTimeout(() => btn.classList.remove('is-hit'), 160);
			setTimeout(() => hand.classList.remove('is-buzzed'), 700);
			if (!still) animate(hand, { rotate: [-7, -10, -5, -7] }, { duration: 0.3 });
			arm();
		});
	});

	/* The site's own motion switch is not a media query, so the still frame the
	   <picture> picks for reduced motion is swapped in by hand when it is off. */
	if (still) {
		document.querySelectorAll<HTMLImageElement>('.onair-clip img').forEach((img) => {
			const s = img.parentElement?.querySelector<HTMLSourceElement>('source');
			if (s) img.src = s.srcset;
			s?.remove();
		});
	}

	if (!still) {
		document.querySelectorAll<HTMLElement>('[data-spread]').forEach((spread) => {
			/* already on screen at load: leave it where it lies */
			if (spread.getBoundingClientRect().top < innerHeight) return;
			const pieces = [...spread.querySelectorAll<HTMLElement>('[data-piece]')];
			const lines = [...spread.querySelectorAll<SVGPathElement>('[data-draw]')];
			/* hidden only now, just before they arrive, so no JS means no gap */
			pieces.forEach((el) => (el.style.opacity = '0'));
			lines.forEach((l) => {
				l.style.strokeDasharray = '1';
				l.style.strokeDashoffset = '1';
			});
			inView(
				spread,
				() => {
					pieces.forEach((el, i) => {
						const delay = i * 0.13;
						animate(el, { opacity: [0, 1] }, { duration: 0.35, delay });
						/* slid in from below and a little askew, settling on a spring */
						animate(el, { y: [56, 0], rotate: [i % 2 ? -4 : 4, 0] }, { type: 'spring', stiffness: 140, damping: 16, delay });
					});
					lines.forEach((l, i) =>
						animate(l, { strokeDashoffset: [1, 0] }, { duration: 0.7, ease: 'easeOut', delay: pieces.length * 0.13 + 0.3 + i * 0.15 }),
					);
				},
				{ amount: 0.2 },
			);
		});

		if (matchMedia('(min-width: 901px)').matches) {
			document.querySelectorAll<HTMLElement>('[data-drift]').forEach((el) => {
				const d = parseFloat(el.dataset.drift!);
				scroll((p: number) => el.style.setProperty('--drift', `${(d * (1 - 2 * p)).toFixed(1)}px`), {
					target: el.closest('[data-spread]')!,
					offset: ['start end', 'end start'],
				});
			});
		}

		if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
			document.querySelectorAll<HTMLElement>('[data-depth-stage]').forEach((stage) => {
				const layers = [...stage.querySelectorAll<HTMLElement>('[data-depth]')];
				stage.addEventListener('pointermove', (e) => {
					const r = stage.getBoundingClientRect();
					const nx = (e.clientX - r.left) / r.width - 0.5;
					const ny = (e.clientY - r.top) / r.height - 0.5;
					for (const l of layers) {
						const d = parseFloat(l.dataset.depth!) * 6;
						l.style.setProperty('--dx', `${(nx * d).toFixed(1)}px`);
						l.style.setProperty('--dy', `${(ny * d).toFixed(1)}px`);
					}
				});
				stage.addEventListener('pointerleave', () =>
					layers.forEach((l) => {
						l.style.removeProperty('--dx');
						l.style.removeProperty('--dy');
					}),
				);
			});
		}
	}
</script>

<style>
	.featured {
		padding-top: clamp(4rem, 9vw, 7rem);
	}
	.featured-head {
		margin-bottom: clamp(1rem, 3vw, 2rem);
	}
</style>
