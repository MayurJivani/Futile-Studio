---
// Turntable modal — populated and controlled by /collection page script.
// Expects a shared <audio id="media-audio"> to exist on the page.
---

<div class="player vinyl-player" id="vinyl-player" data-format="vinyl" aria-hidden="true">
	<div class="player-panel">
		<button class="player-close" id="vinyl-close" aria-label="Close player" data-magnetic="0.4">✕</button>

		<div class="player-label">/ TURNTABLE — DWG 01</div>

		<div class="turntable">
			<div class="platter">
				<div class="record" id="vinyl-record">
					<svg viewBox="0 0 200 200" class="grooves">
						<circle cx="100" cy="100" r="98"></circle>
						<circle cx="100" cy="100" r="88"></circle>
						<circle cx="100" cy="100" r="78"></circle>
						<circle cx="100" cy="100" r="68"></circle>
						<circle cx="100" cy="100" r="58"></circle>
						<circle cx="100" cy="100" r="48"></circle>
						<circle cx="100" cy="100" r="38"></circle>
					</svg>
					<div class="vinyl-label">
						<span id="vinyl-title">Album Title</span>
						<span id="vinyl-artist">Artist</span>
					</div>
					<div class="spindle"></div>
				</div>
			</div>
			<div class="tonearm" id="tonearm">
				<div class="tonearm-arm">
					<div class="tonearm-head"></div>
				</div>
				<div class="tonearm-pivot"></div>
			</div>
		</div>

		<div class="player-meta">
			<div>
				<div class="meta-title" id="vinyl-meta-title">Album Title</div>
				<div class="meta-sub" id="vinyl-meta-sub">Artist · Year</div>
			</div>
			<div class="format-badge" id="vinyl-format-badge">VINYL</div>
		</div>

		<div class="player-controls">
			<button class="transport-btn transport-skip" id="vinyl-prev" aria-label="Previous track" data-magnetic="0.3">
				<svg viewBox="0 0 16 16" fill="currentColor"><path d="M4 2.5v11L14 8 4 2.5zM12 2.5v11h1.5v-11H12z" opacity="0" /><path d="M11 2.5v11L1 8l10-5.5zM13 2.5v11h1v-11h-1z"></path></svg>
			</button>
			<button class="transport-btn" id="vinyl-play" aria-label="Play / pause" data-magnetic="0.3">
				<svg id="vinyl-play-icon" viewBox="0 0 16 16" fill="currentColor"
					><path d="M4 2.5v11l10-5.5-10-5.5z"></path></svg
				>
				<svg id="vinyl-pause-icon" viewBox="0 0 16 16" fill="currentColor" style="display:none"
					><path d="M4 2.5h3v11H4zM9 2.5h3v11H9z"></path></svg
				>
			</button>
			<button class="transport-btn transport-skip" id="vinyl-next" aria-label="Next track" data-magnetic="0.3">
				<svg viewBox="0 0 16 16" fill="currentColor"><path d="M5 2.5v11l10-5.5L5 2.5zM3 2.5v11h1v-11H3z"></path></svg>
			</button>
			<div class="scrub">
				<span class="time" id="vinyl-time-current">00:00</span>
				<div class="scrub-track"><div class="scrub-fill" id="vinyl-scrub-fill"></div></div>
				<span class="time" id="vinyl-time-total">00:00</span>
			</div>
		</div>

		<div class="volume">
			<span class="volume-label">VOLUME</span>
			<svg class="volume-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2"
				><path d="M3 6v4h3l3-3V5L6 6H3z"></path><path d="M11 5.5a4 4 0 010 5"></path
				><path d="M13 3.5a7 7 0 010 9"></path
			></svg>
			<input
				type="range"
				class="volume-slider"
				id="vinyl-volume"
				min="0"
				max="1"
				step="0.01"
				value="1"
				aria-label="Volume"
			/>
		</div>

		<div class="tracklist-wrap" id="vinyl-tracklist" hidden>
			<div class="tracklist-label">/ TRACKLIST</div>
			<ol class="tracklist" id="vinyl-tracklist-ol"></ol>
		</div>

		<p class="player-note" id="vinyl-note"></p>
	</div>
</div>

<style>
	.player {
		position: fixed;
		inset: 0;
		z-index: 300;
		display: none;
		align-items: center;
		justify-content: center;
		padding: 24px;
		background: rgba(4, 8, 16, 0.86);
		backdrop-filter: blur(6px);
	}
	.player.is-open {
		display: flex;
	}

	.player-panel {
		position: relative;
		width: min(560px, 100%);
		background: var(--surface);
		border: 1px solid var(--line-strong);
		padding: 36px;
		max-height: calc(100vh - 48px);
		overflow-y: auto;
	}

	.player-close {
		position: absolute;
		top: 16px;
		right: 16px;
		background: none;
		border: 1px solid var(--line);
		color: var(--muted);
		width: 30px;
		height: 30px;
		cursor: pointer;
		font-size: 12px;
	}
	.player-close:hover {
		color: var(--cyan);
		border-color: var(--cyan);
	}

	.player-label {
		font-size: 10px;
		letter-spacing: 0.14em;
		color: var(--cyan);
		margin-bottom: 28px;
	}

	.turntable {
		position: relative;
		width: 100%;
		aspect-ratio: 1.15;
		background: var(--bg-2);
		border: 1px solid var(--line);
		display: grid;
		place-items: center;
		margin-bottom: 24px;
	}

	.platter {
		width: 62%;
		aspect-ratio: 1;
		border-radius: 50%;
		border: 1px solid var(--line-strong);
		display: grid;
		place-items: center;
	}

	.record {
		width: 92%;
		aspect-ratio: 1;
		border-radius: 50%;
		background: #0a0f1a;
		position: relative;
		display: grid;
		place-items: center;
		animation: vinylspin 2.2s linear infinite paused;
		box-shadow: 0 0 0 1px var(--line);
	}
	.record.is-spinning {
		animation-play-state: running;
	}

	@keyframes vinylspin {
		to {
			transform: rotate(360deg);
		}
	}

	.grooves {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}
	.grooves circle {
		fill: none;
		stroke: rgba(120, 179, 255, 0.16);
		stroke-width: 0.6;
	}

	.vinyl-label {
		width: 42%;
		aspect-ratio: 1;
		border-radius: 50%;
		background: var(--surface-lt);
		border: 1px solid var(--line-strong);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		gap: 4px;
		padding: 8px;
		position: relative;
		z-index: 1;
	}
	.vinyl-label span:first-child {
		font-family: var(--display);
		font-weight: 700;
		text-transform: uppercase;
		font-size: 12px;
		color: var(--white);
		line-height: 1.1;
	}
	.vinyl-label span:last-child {
		font-size: 9px;
		color: var(--muted);
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.spindle {
		position: absolute;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--cyan);
		z-index: 2;
	}

	.tonearm {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}
	.tonearm-pivot {
		position: absolute;
		top: 5%;
		right: 5%;
		width: 16px;
		height: 16px;
		border-radius: 50%;
		border: 1px solid var(--line-strong);
		background: var(--bg-2);
	}
	.tonearm-arm {
		position: absolute;
		top: calc(5% + 7px);
		right: calc(5% + 7px);
		width: 2px;
		height: 46%;
		background: var(--cyan-soft);
		transform-origin: 50% 0;
		transform: rotate(0deg);
		transition: transform 0.6s cubic-bezier(0.65, 0, 0.35, 1);
	}
	.tonearm.is-playing .tonearm-arm {
		transform: rotate(30deg);
	}
	.tonearm-head {
		position: absolute;
		bottom: -3px;
		left: -4px;
		width: 10px;
		height: 6px;
		background: var(--cyan);
	}

	.player-meta {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 24px;
		gap: 12px;
	}
	.meta-title {
		font-family: var(--display);
		font-weight: 700;
		text-transform: uppercase;
		font-size: 20px;
		color: var(--white);
	}
	.meta-sub {
		font-size: 11px;
		color: var(--muted);
		letter-spacing: 0.04em;
		margin-top: 4px;
	}
	.format-badge {
		font-size: 10px;
		letter-spacing: 0.12em;
		color: var(--cyan);
		border: 1px solid var(--line-strong);
		padding: 5px 10px;
		flex-shrink: 0;
	}
	.format-badge.is-hires {
		color: #0b1e33;
		background: var(--cyan);
		border-color: var(--cyan);
	}

	.player-controls {
		display: flex;
		align-items: center;
		gap: 10px;
	}
	.transport-btn {
		width: 46px;
		height: 46px;
		flex-shrink: 0;
		border: 1px solid var(--line-strong);
		background: var(--bg-2);
		color: var(--white);
		cursor: pointer;
		display: grid;
		place-items: center;
		transition:
			border-color 0.2s,
			color 0.2s;
	}
	.transport-skip {
		width: 34px;
		height: 34px;
	}
	.transport-skip svg {
		width: 12px;
		height: 12px;
	}
	.transport-btn svg {
		width: 16px;
		height: 16px;
	}
	.transport-btn:hover {
		border-color: var(--cyan);
		color: var(--cyan);
	}

	.volume {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-top: 16px;
	}
	.volume-label {
		font-size: 9px;
		letter-spacing: 0.14em;
		color: var(--faint);
		flex-shrink: 0;
	}
	.volume-icon {
		width: 14px;
		height: 14px;
		color: var(--muted);
		flex-shrink: 0;
	}
	.volume-slider {
		flex: 1;
		appearance: none;
		-webkit-appearance: none;
		height: 2px;
		background: var(--line);
		outline: none;
		cursor: pointer;
	}
	.volume-slider::-webkit-slider-thumb {
		appearance: none;
		-webkit-appearance: none;
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--cyan);
		border: 1px solid rgba(11, 30, 51, 0.8);
		transition: transform 0.15s;
	}
	.volume-slider::-moz-range-thumb {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--cyan);
		border: 1px solid rgba(11, 30, 51, 0.8);
	}
	.volume-slider::-moz-range-track {
		height: 2px;
		background: var(--line);
	}
	.volume-slider:hover::-webkit-slider-thumb,
	.volume-slider:focus-visible::-webkit-slider-thumb {
		transform: scale(1.25);
	}
	.volume-slider:focus-visible {
		outline: 1px solid var(--cyan);
		outline-offset: 4px;
	}

	.tracklist-wrap {
		margin-top: 22px;
		border-top: 1px solid var(--line);
		padding-top: 16px;
	}
	.tracklist-label {
		font-size: 10px;
		letter-spacing: 0.14em;
		color: var(--cyan);
		margin-bottom: 8px;
	}
	.tracklist {
		list-style: none;
		margin: 0;
		padding: 0;
		max-height: 220px;
		overflow-y: auto;
	}

	.player-panel,
	.tracklist {
		scrollbar-width: thin;
		scrollbar-color: var(--line-strong) transparent;
	}
	.player-panel::-webkit-scrollbar,
	.tracklist::-webkit-scrollbar {
		width: 6px;
		height: 6px;
	}
	.player-panel::-webkit-scrollbar-thumb,
	.tracklist::-webkit-scrollbar-thumb {
		background: var(--line-strong);
	}
	.player-panel::-webkit-scrollbar-thumb:hover,
	.tracklist::-webkit-scrollbar-thumb:hover {
		background: var(--cyan);
	}
	.player-panel::-webkit-scrollbar-track,
	.tracklist::-webkit-scrollbar-track {
		background: transparent;
	}

	.scrub {
		flex: 1;
		display: flex;
		align-items: center;
		gap: 10px;
	}
	.time {
		font-size: 11px;
		color: var(--muted);
		min-width: 36px;
	}
	.scrub-track {
		flex: 1;
		height: 2px;
		background: var(--line);
		position: relative;
	}
	.scrub-fill {
		position: absolute;
		top: 0;
		left: 0;
		height: 100%;
		width: 0%;
		background: var(--cyan);
	}

	.player-note {
		margin-top: 18px;
		font-size: 11px;
		color: var(--faint);
		text-align: center;
	}

	@media (max-width: 560px) {
		.player-panel {
			padding: 24px 18px;
		}
	}
</style>

<!-- Tracklist items are created at runtime by JS, so their styles must be
     global — scoped CSS never reaches the dynamic <li> elements. -->
<style is:global>
	.tracklist li {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 8px 10px;
		margin: 0 -10px;
		border: 1px solid transparent;
		cursor: pointer;
		font-size: 12px;
		transition:
			background 0.15s,
			border-color 0.15s;
	}
	.tracklist li:hover {
		background: var(--bg-2);
	}
	.tracklist li.is-current {
		border-color: var(--cyan);
		background: var(--bg-2);
	}
	.tracklist .tl-num {
		font-family: var(--mono);
		color: var(--faint);
		width: 20px;
		flex-shrink: 0;
	}
	.tracklist .tl-title {
		flex: 1;
		color: var(--white);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.tracklist li.is-current .tl-title {
		color: var(--cyan);
	}
	.tracklist .tl-time {
		font-family: var(--mono);
		color: var(--faint);
		flex-shrink: 0;
	}
	.tracklist .tl-hr {
		flex-shrink: 0;
		font-size: 9px;
		letter-spacing: 0.08em;
		color: var(--cyan);
		border: 1px solid var(--line-strong);
		padding: 2px 5px;
	}
	.tracklist .tl-heart {
		flex-shrink: 0;
		font-size: 11px;
		line-height: 1;
		color: #ff5b8a;
	}
</style>
