---
interface Props {
	items: string[];
	speed?: number; // seconds per loop
}
const { items, speed = 26 } = Astro.props;

// Short item lists (e.g. 2 phrases) don't fill wide viewports even doubled,
// so the translateX(-50%) reset point ends up visible mid-screen instead of
// off past the edge. Repeat until there's enough width to hide the seam,
// and scale the loop distance to match.
const repeats = Math.max(2, Math.ceil(20 / items.length));
const repeated = Array.from({ length: repeats }, () => items).flat();
const loopEnd = 100 / repeats;
---

<div class="marquee" style={`--speed:${speed}s;--loop-end:${loopEnd}%`}>
	<div class="marquee-track">
		{repeated.map((item, i) => <span class={i % 2 === 0 ? 'is-fill' : 'is-outline'}>{item}</span>)}
	</div>
</div>

<style>
	/* ---------- structure, shared by both themes ---------- */
	.marquee {
		width: 100%;
		overflow: hidden;
	}

	.marquee-track {
		display: flex;
		width: max-content;
		animation: marquee var(--speed) linear infinite;
	}

	.marquee-track span {
		display: flex;
		align-items: center;
		flex-shrink: 0;
		white-space: nowrap;
	}

	.marquee:hover .marquee-track {
		animation-play-state: paused;
	}

	/* ---------- Guideline B: a strip of ticker tape ---------- */
	:global([data-theme='scrapbook']) .marquee {
		padding: 0.7rem 0;
		background: var(--card-2);
		border-top: 1.5px solid var(--ink-soft);
		border-bottom: 1.5px solid var(--ink-soft);
		/* Torn top and bottom edge, cut with a repeating gradient. */
		box-shadow:
			inset 0 3px 0 var(--paper),
			inset 0 -3px 0 var(--paper);
	}

	:global([data-theme='scrapbook']) .marquee-track span {
		padding: 0 0.9rem;
		font-family: var(--bubble);
		font-weight: 800;
		font-size: clamp(1rem, 2.4vw, 1.5rem);
		color: var(--ink);
	}

	/* Alternating words sit slightly off the line, like hand-set type. */
	:global([data-theme='scrapbook']) .marquee-track span.is-outline {
		color: var(--ink-faint);
		transform: rotate(1.2deg);
	}
	:global([data-theme='scrapbook']) .marquee-track span.is-fill {
		transform: rotate(-1deg);
	}

	/* Snipped-tape separator between items. */
	:global([data-theme='scrapbook']) .marquee-track span::before {
		content: '✂';
		margin-right: 0.9rem;
		font-family: var(--hand);
		font-size: 0.7rem;
		color: var(--stamp);
		transform: rotate(0deg);
	}

	/* ---------- Guideline A: the blueprint ticker ---------- */
	:global([data-theme='booth']) .marquee {
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
		padding: 18px 0;
		background: var(--bg-2);
	}

	:global([data-theme='booth']) .marquee-track span {
		padding: 0 22px;
		font-family: var(--display);
		font-weight: 800;
		text-transform: uppercase;
		font-size: clamp(20px, 3vw, 34px);
		letter-spacing: 0.01em;
	}

	:global([data-theme='booth']) .marquee-track span.is-outline {
		color: transparent;
		-webkit-text-stroke: 1px var(--line-strong);
	}

	:global([data-theme='booth']) .marquee-track span.is-fill {
		color: var(--cyan);
	}

	:global([data-theme='booth']) .marquee-track span::before {
		content: '◆';
		margin-right: 22px;
		font-size: 10px;
		color: var(--cyan);
		-webkit-text-stroke: 0;
	}

	@keyframes marquee {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(calc(-1 * var(--loop-end, 50%)));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		:global(html:not([data-motion='on'])) .marquee-track {
			animation: none;
		}
	}
	/* The desk's motion setting wins over the OS one in both directions. */
	:global(html[data-motion='off']) .marquee-track {
		animation: none;
	}
</style>
