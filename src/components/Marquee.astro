---
interface Props {
	items: string[];
	speed?: number; // seconds per loop
}
const { items, speed = 26 } = Astro.props;

// Short item lists (e.g. 2 phrases) don't fill wide viewports even doubled,
// so the translateX(-50%) reset point ends up visible mid-screen instead of
// off past the edge. Repeat until there's enough width to hide the seam,
// and scale the loop distance to match.
const repeats = Math.max(2, Math.ceil(20 / items.length));
const repeated = Array.from({ length: repeats }, () => items).flat();
const loopEnd = 100 / repeats;
---

<div class="marquee" style={`--speed:${speed}s;--loop-end:${loopEnd}%`}>
	<div class="marquee-track">
		{repeated.map((item, i) => <span class={i % 2 === 0 ? 'is-fill' : 'is-outline'}>{item}</span>)}
	</div>
</div>

<style>
	.marquee {
		width: 100%;
		overflow: hidden;
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
		padding: 18px 0;
		background: var(--bg-2);
	}

	.marquee-track {
		display: flex;
		width: max-content;
		animation: marquee var(--speed) linear infinite;
	}

	.marquee-track span {
		display: flex;
		align-items: center;
		flex-shrink: 0;
		padding: 0 22px;
		font-family: var(--display);
		font-weight: 800;
		text-transform: uppercase;
		font-size: clamp(20px, 3vw, 34px);
		letter-spacing: 0.01em;
		white-space: nowrap;
	}

	.marquee-track span.is-outline {
		color: transparent;
		-webkit-text-stroke: 1px var(--line-strong);
	}

	.marquee-track span.is-fill {
		color: var(--cyan);
	}

	.marquee-track span::before {
		content: '◆';
		margin-right: 22px;
		font-size: 10px;
		color: var(--cyan);
		-webkit-text-stroke: 0;
	}

	.marquee:hover .marquee-track {
		animation-play-state: paused;
	}

	@keyframes marquee {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(calc(-1 * var(--loop-end, 50%)));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.marquee-track {
			animation: none;
		}
	}
</style>
