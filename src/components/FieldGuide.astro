---
/**
 * The Futile Field Guide: a stamp album, a map of the studio, and a postcard
 * for whichever stamp you are looking at.
 *
 * Dressed as a philatelic stockbook: an ink-black drawer lining that stays
 * dark under either lamp, two ivory leaves on it, glassine strips across the
 * right-hand leaf and a numbered space printed for every stamp.
 *
 * Everything comes from the registry in `src/data/stamps.js`. A slot is
 * either hinted (the stamp's outline printed on the leaf, the hint under it)
 * or collected (the stamp, cancelled with a postmark, pressable to read its
 * postcard). The collection itself lives in this browser only
 * (`src/lib/guide.js`).
 *
 * Server rendered with every stamp in place, so with no script the album still
 * lists what there is to find; the script only marks what you have.
 */
import StampArt from './StampArt.astro';
import { url } from '../lib/url.js';
import { stamps, places } from '../data/stamps.js';
import { open } from '../data/board.js';

const hrefOf = Object.fromEntries(open.map((p) => [p.id, p.href]));
const total = stamps.length;

/* Where each place sits on the hand-drawn map (viewBox 600 x 400). */
const spots: Record<string, [number, number, number, number]> = {
	door: [24, 300, 120, 76],
	work: [168, 230, 196, 146],
	archive: [384, 282, 108, 94],
	about: [24, 150, 120, 120],
	backroom: [508, 230, 70, 146],
	studio: [168, 40, 230, 160],
	contact: [420, 40, 158, 120],
};
const inPlace = (id: string) => stamps.filter((s) => s.where === id).length;
---

<section id="guide" class="guide drawer" aria-labelledby="guide-title">
	<div class="album wrap">
		<div class="album-page album-left on-paper">
			<h2 id="guide-title" class="guide-title">The Futile Field&nbsp;Guide</h2>
			<p class="guide-copy">
				Stamps from every corner of the studio. Some are for opening things, some are hidden, all of them are
				optional. The album lives in this browser and nowhere else.
			</p>

			<div class="guide-progress">
				<p class="guide-count" aria-live="polite">
					<span class="guide-have" id="guide-have">00</span>
					<span class="guide-of">/ {String(total).padStart(2, '0')}</span>
					<span class="guide-word">collected</span>
				</p>
				<ol class="guide-strip" aria-hidden="true">
					{stamps.map((s) => <li data-strip={s.id} />)}
				</ol>
			</div>

			<figure class="map">
				<svg viewBox="0 0 600 400" role="group" aria-label="A map of the studio. Each room links to its section.">
					<path
						class="map-route"
						d="M84 340 C140 330 180 320 240 300 S360 330 420 320 S520 300 540 260 S500 120 470 100 S330 140 280 120 S120 140 84 200"
					></path>
					{
						places.map((pl) => {
							const [x, y, w, h] = spots[pl.id];
							return (
								<a href={url(pl.href)} class:list={['map-room', `room-${pl.id}`]} data-place={pl.id}>
									<rect x={x} y={y} width={w} height={h} rx="3" />
									{/* a narrow room gets its name on two lines rather than past its wall */}
									<text x={x + 10} y={y + 22} class="map-name">
										{w < 100
											? pl.name.split(' ').map((word, i) => (
													<tspan x={x + 10} dy={i ? 20 : 0}>
														{word}
													</tspan>
												))
											: pl.name}
									</text>
									<text x={x + 10} y={y + h - 12} class="map-n">
										<tspan data-place-have={pl.id}>0</tspan>/{inPlace(pl.id)}
									</text>
								</a>
							);
						})
					}
					<text x="556" y="392" class="map-compass" text-anchor="end">N ↑ roughly</text>
				</svg>
			</figure>

			<div class="guide-reward" id="guide-reward" hidden>
				<p class="script">All of them. That was a lot of clicking for nothing, which is rather the point.</p>
				<a class="btn btn-stamp" href={url('ascii')}>Open the door to the field</a>
			</div>

			<div class="guide-actions">
				<button class="btn" type="button" id="guide-share">Share my album</button>
				<button class="guide-reset" type="button" id="guide-reset">Start a clean album</button>
			</div>
			<p class="guide-msg" id="guide-msg" role="status"></p>
		</div>

		<div class="album-page album-right on-paper">
			<p class="leaf-head" aria-hidden="true">
				<span>Futile Post</span>
				<span>{total} spaces</span>
			</p>
			<ul class="slots" role="list">
				{
					stamps.map((s) => (
						<li class:list={['slot', `slot-${s.format}`]} data-stamp={s.id}>
							<span class="slot-no">No. {s.serial}</span>
							<button
								type="button"
								class="slot-btn"
								data-inspect={s.id}
								aria-describedby={`slot-state-${s.id}`}
							>
								{/* the strip of glassine the stamp is tucked behind */}
								<span class="slot-mount">
									<span class="slot-art">
										<StampArt stamp={s} cancelled />
									</span>
									<span class="slot-empty" aria-hidden="true" />
								</span>
								<span class="slot-name">{s.title}</span>
							</button>
							<span class="slot-hint" id={`slot-state-${s.id}`}>
								<span class="visually-hidden" data-state>
									Not found yet.{' '}
								</span>
								{s.hint}
							</span>
						</li>
					))
				}
			</ul>

			<article class="postcard" id="postcard" aria-live="polite" hidden>
				<div class="postcard-msg">
					<p class="label" id="pc-serial"></p>
					<h3 class="postcard-title" id="pc-title"></h3>
					<p class="postcard-note script" id="pc-note"></p>
					<p class="postcard-how" id="pc-how"></p>
					<a class="postcard-link" id="pc-link" href="#" target="_blank" rel="noopener" hidden>Open the project</a>
				</div>
				<div class="postcard-side">
					<div class="postcard-stamp" id="pc-stamp"></div>
					<p class="postcard-to script" aria-hidden="true">To whoever<br />found this</p>
				</div>
				<button class="postcard-close" type="button" id="pc-close" aria-label="Put the postcard away">✕</button>
			</article>
		</div>
	</div>
</section>

<script define:vars={{ total, registry: stamps.map((s) => ({ id: s.id, title: s.title, note: s.note, unlock: s.unlock, serial: s.serial, edition: s.edition ?? '', denom: s.denom, project: s.project ?? '', where: s.where })), hrefOf }} is:inline>
	window.__futileGuide = { total, registry, hrefOf };
</script>

<script>
	import { animate } from 'motion';
	import { collected, resetGuide } from '../lib/guide.js';

	type Entry = { id: string; title: string; note: string; unlock: string; serial: string; edition: string; denom: string; project: string; where: string };
	const { total, registry, hrefOf } = (window as any).__futileGuide as { total: number; registry: Entry[]; hrefOf: Record<string, string> };
	const byId = Object.fromEntries(registry.map((e) => [e.id, e]));

	const slots = document.querySelectorAll<HTMLElement>('.slot');
	const have = document.getElementById('guide-have')!;
	const reward = document.getElementById('guide-reward')!;
	const msg = document.getElementById('guide-msg')!;
	const card = document.getElementById('postcard')!;
	const root = document.documentElement;
	const still = () =>
		root.dataset.motion === 'off' ||
		(root.dataset.motion !== 'on' && matchMedia('(prefers-reduced-motion: reduce)').matches);
	const two = (n: number) => String(n).padStart(2, '0');

	function render(fresh?: string) {
		const got = collected();
		let n = 0;
		slots.forEach((slot) => {
			const id = slot.dataset.stamp!;
			const on = got.has(id);
			if (on) n++;
			slot.classList.toggle('is-got', on);
			slot.querySelector('[data-state]')!.textContent = on ? 'Collected. ' : 'Not found yet. ';
			document.querySelector(`[data-strip="${id}"]`)?.classList.toggle('is-got', on);
			if (on && id === fresh && !still()) {
				/* The press: the stamp drops into its strip and settles, then the
				   postmark inks over it (CSS, keyed to .is-fresh). The mount moves,
				   not .slot-art, so anything cloning .slot-art gets it at rest. */
				animate(
					slot.querySelector('.slot-mount')!,
					{ y: [-26, 0], scale: [1.15, 1], rotate: [-7, 0] },
					{ type: 'spring', stiffness: 420, damping: 15 },
				);
				slot.classList.add('is-fresh');
				setTimeout(() => slot.classList.remove('is-fresh'), 1400);
			}
		});
		document.querySelectorAll<SVGTSpanElement>('[data-place-have]').forEach((t) => {
			t.textContent = String(registry.filter((e) => e.where === t.dataset.placeHave && got.has(e.id)).length);
		});
		have.textContent = two(n);
		reward.hidden = n < total;
	}

	/* The postcard goes back into its slot before another comes out. */
	async function stow() {
		if (card.hidden) return;
		if (!still()) await animate(card, { opacity: 0, scale: 0.94, y: 10 }, { duration: 0.18, ease: 'easeIn' });
		card.hidden = true;
		card.style.opacity = card.style.transform = '';
	}

	let turn = 0;
	async function inspect(id: string) {
		const e = byId[id];
		if (!e) return;
		const mine = ++turn;
		await stow();
		if (mine !== turn) return;
		const on = collected().has(id);
		slots.forEach((sl) => sl.classList.toggle('is-open', sl.dataset.stamp === id));
		card.hidden = false;
		card.classList.toggle('is-locked', !on);
		document.getElementById('pc-serial')!.textContent = `${e.serial} · ${e.denom}${e.edition ? ` · ${e.edition}` : ''}`;
		document.getElementById('pc-title')!.textContent = on ? e.title : 'Not found yet';
		document.getElementById('pc-note')!.textContent = on ? e.note : 'This card is still in the post.';
		document.getElementById('pc-how')!.textContent = `How to find it: ${e.unlock}`;
		const link = document.getElementById('pc-link') as HTMLAnchorElement;
		const href = e.project && hrefOf[e.project];
		link.hidden = !href;
		if (href) {
			link.href = href;
			link.textContent = `Open ${e.title}`;
		}
		const art = document.querySelector(`.slot[data-stamp="${id}"] .slot-art`)!;
		document.getElementById('pc-stamp')!.replaceChildren(art.cloneNode(true));
		if (still()) return card.scrollIntoView({ block: 'nearest' });
		/* The card grows out of the stamp you pressed: start at the slot's box. */
		const from = document.querySelector(`.slot[data-stamp="${id}"] .slot-mount`)!.getBoundingClientRect();
		const to = card.getBoundingClientRect();
		card.style.transformOrigin = '0 0';
		animate(
			card,
			{ x: [from.left - to.left, 0], y: [from.top - to.top, 0], scale: [from.width / to.width, 1], opacity: [0, 1] },
			{ type: 'spring', stiffness: 240, damping: 26, opacity: { duration: 0.2 } },
		);
		card.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
	}

	document.querySelectorAll<HTMLButtonElement>('[data-inspect]').forEach((b) =>
		b.addEventListener('click', () => inspect(b.dataset.inspect!)),
	);
	document.getElementById('pc-close')!.addEventListener('click', async () => {
		const back = document.querySelector<HTMLElement>('.slot.is-open .slot-btn');
		turn++;
		await stow();
		slots.forEach((sl) => sl.classList.remove('is-open'));
		/* keyboard users land back on the stamp they opened, not at the top */
		back?.focus();
	});

	render();
	window.addEventListener('futile-stamp', (e) => render((e as CustomEvent).detail?.id));
	/* A stamp earned in another tab (a project opened, then back here). */
	window.addEventListener('storage', (e) => e.key === 'futile-guide' && render());

	document.getElementById('guide-share')!.addEventListener('click', async () => {
		const n = collected().size;
		const text = `My Futile Field Guide: ${n} of ${total} stamps. Nothing matters, build cool shit anyway.`;
		const link = 'https://futile.studio/#guide';
		try {
			if (navigator.share) {
				await navigator.share({ text, url: link });
				return;
			}
			await navigator.clipboard.writeText(`${text} ${link}`);
			msg.textContent = 'Copied. It only says how many stamps, nothing else.';
		} catch (err) {
			if ((err as Error).name === 'AbortError') return;
			msg.textContent = `Could not copy. Here it is to copy by hand: ${text} ${link}`;
		}
	});

	const resetBtn = document.getElementById('guide-reset')!;
	let armed = false;
	resetBtn.addEventListener('click', () => {
		if (!armed) {
			armed = true;
			resetBtn.textContent = 'Press again to empty it';
			setTimeout(() => {
				armed = false;
				resetBtn.textContent = 'Start a clean album';
			}, 3000);
			return;
		}
		resetGuide();
		armed = false;
		turn++;
		card.hidden = true;
		resetBtn.textContent = 'Start a clean album';
		msg.textContent = 'Clean album. Every stamp is back in the post.';
	});
</script>

<style>
	/* The drawer lining: black stockbook board, dark under either lamp. */
	.guide {
		--gap: clamp(0.7rem, 1.6vw, 1.3rem);
		background: var(--ink-fixed);
		color: var(--ivory);
		padding-block: clamp(4rem, 9vw, 7rem);
	}
	/* the shared felt is dark noise; lifted to light so it shows on black */
	#guide.drawer::before {
		filter: invert(1);
		mix-blend-mode: screen;
		opacity: 0.07;
	}
	.album {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		gap: var(--gap);
	}
	.album-page {
		position: relative;
		padding: clamp(1.4rem, 3.6vw, 2.8rem);
		background: var(--card);
		color: var(--ink);
		border-radius: 2px;
		box-shadow:
			0 1px 0 rgba(0, 0, 0, 0.5),
			0 24px 40px -24px rgba(0, 0, 0, 0.9);
	}
	/* stitching down the spine, in the lining between the two leaves */
	.album-right::before {
		content: '';
		position: absolute;
		top: 1.4rem;
		bottom: 1.4rem;
		left: calc(var(--gap) / -2);
		border-left: 1px dashed color-mix(in srgb, var(--ivory) 30%, transparent);
	}
	/* the printed hinge line every stockbook leaf has near its binding */
	.album-right::after {
		content: '';
		position: absolute;
		top: 0;
		bottom: 0;
		left: 0.7rem;
		width: 3px;
		border-inline: 1px solid var(--ink-ghost);
		pointer-events: none;
	}

	.guide-title {
		font-size: clamp(2.4rem, 4.6vw, 4rem);
		line-height: 0.92;
		margin-bottom: 1rem;
	}
	.guide-copy {
		max-width: 28rem;
		color: var(--ink-soft);
	}

	/* The tally, printed: 07 / 17 collected. */
	.guide-progress {
		margin: 1.8rem 0 1.4rem;
		padding-top: 1rem;
		border-top: 1px solid var(--ink);
	}
	.guide-count {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0.5rem;
		font-family: var(--label-face);
		font-size: clamp(3rem, 6vw, 4.2rem);
		line-height: 0.9;
		font-variant-numeric: tabular-nums lining-nums;
	}
	.guide-have {
		color: var(--stamp);
	}
	.guide-word {
		font-family: var(--mono);
		font-size: 0.7rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-soft);
	}
	/* One perforated square per stamp: the progress you can count. */
	.guide-strip {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 4px;
		margin-top: 0.8rem;
	}
	.guide-strip li {
		width: 14px;
		height: 17px;
		border: 1px dashed var(--ink-faint);
		border-radius: 1px;
		transition: background 0.3s ease;
	}
	.guide-strip li.is-got {
		background: var(--stamp);
		border: 1px solid var(--stamp);
	}

	.map {
		margin: 0 0 1.4rem;
	}
	.map svg {
		width: 100%;
		height: auto;
		display: block;
	}
	.map-route {
		fill: none;
		stroke: var(--stamp);
		stroke-width: 2;
		stroke-dasharray: 2 7;
		stroke-linecap: round;
		opacity: 0.7;
	}
	.map-room rect {
		fill: color-mix(in srgb, var(--card-2) 70%, transparent);
		stroke: var(--ink);
		stroke-width: 1.5;
		transition: fill 0.2s ease;
	}
	.room-backroom rect {
		fill: var(--night);
	}
	.room-backroom text {
		fill: var(--forest-ink);
	}
	.map-room:hover rect,
	.map-room:focus-visible rect {
		fill: color-mix(in srgb, var(--marker) 45%, transparent);
	}
	.room-backroom:hover rect {
		fill: #2a3142;
	}
	.map-room:focus-visible {
		outline: none;
	}
	.map-room:focus-visible rect {
		stroke: var(--stamp);
		stroke-width: 3;
	}
	.map-name {
		font-family: var(--script);
		font-size: 21px;
		fill: var(--ink);
	}
	.map-n {
		font-family: var(--mono);
		font-size: 12px;
		fill: var(--ink-soft);
	}
	.map-compass {
		font-family: var(--script);
		font-size: 15px;
		fill: var(--ink-soft);
	}

	.guide-reward {
		margin-bottom: 1.4rem;
	}
	.guide-reward .script {
		margin-bottom: 0.8rem;
	}
	.guide-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.8rem 1.2rem;
	}
	.guide-reset {
		min-height: 44px;
		background: none;
		border: none;
		font: inherit;
		font-size: 0.85rem;
		color: var(--ink-soft);
		text-decoration: underline;
		text-underline-offset: 0.2em;
		cursor: pointer;
	}
	.guide-msg {
		margin-top: 0.8rem;
		min-height: 1.4em;
		font-size: 0.85rem;
		color: var(--ink-soft);
	}

	/* ---------- the stockbook leaf ---------- */
	.leaf-head {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		margin: 0 0 1.4rem 0.8rem;
		padding-bottom: 0.4rem;
		border-bottom: 1px solid var(--ink);
		font-family: var(--mono);
		font-size: 0.62rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-soft);
	}
	.slots {
		--side: 0.45rem;
		list-style: none;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(6.6rem, 1fr));
		row-gap: 1.6rem;
		margin-left: 0.8rem;
	}
	.slot {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.3rem;
		padding-inline: var(--side);
		text-align: center;
	}
	.slot-no {
		font-family: var(--mono);
		font-size: 0.56rem;
		letter-spacing: 0.06em;
		font-variant-numeric: tabular-nums lining-nums;
		color: var(--ink-soft);
	}
	.slot-btn {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.45rem;
		width: 100%;
		padding: 0;
		background: none;
		border: none;
		font: inherit;
		color: inherit;
		cursor: pointer;
	}
	/* Every mount is the same height, so the glassine runs level across a row. */
	.slot-mount {
		position: relative;
		display: flex;
		align-items: flex-end;
		justify-content: center;
		width: 100%;
		aspect-ratio: 1;
	}
	/* The glassine strip: a pocket over the lower half of the stamps, its
	   top edge catching the light. It spans the slot's side padding too, so
	   neighbours join into one strip per row. */
	.slot-mount::after {
		content: '';
		position: absolute;
		left: calc(var(--side) * -1);
		right: calc(var(--side) * -1);
		bottom: -0.3rem;
		height: 52%;
		background: linear-gradient(rgba(255, 255, 255, 0.45), rgba(255, 255, 255, 0.12) 40%, rgba(120, 128, 140, 0.1));
		border-top: 1px solid rgba(23, 24, 22, 0.24);
		border-bottom: 1px solid var(--ink-ghost);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.8);
		pointer-events: none;
	}
	.slot-art,
	.slot-empty {
		width: 78%;
	}
	.slot-landscape .slot-art,
	.slot-landscape .slot-empty {
		width: 100%;
	}
	.slot-tall .slot-art,
	.slot-tall .slot-empty {
		width: 64%;
	}
	.slot-art {
		display: none;
	}
	/* Not found: the stamp's outline printed on the leaf, a space to fill. */
	.slot-empty {
		display: block;
		aspect-ratio: 100 / 124;
		border: 1px solid color-mix(in srgb, var(--ink) 45%, transparent);
		box-shadow:
			inset 0 0 0 4px var(--card),
			inset 0 0 0 4.75px color-mix(in srgb, var(--ink) 22%, transparent);
	}
	.slot-landscape .slot-empty {
		aspect-ratio: 128 / 100;
	}
	.slot-square .slot-empty {
		aspect-ratio: 1;
	}
	.slot-tall .slot-empty {
		aspect-ratio: 88 / 132;
	}
	.slot-name {
		font-family: var(--label-face);
		font-size: 1.1rem;
		letter-spacing: 0.03em;
		text-transform: uppercase;
		line-height: 1;
		color: var(--ink-soft);
	}
	.slot-hint {
		font-size: 0.72rem;
		font-style: italic;
		line-height: 1.3;
		color: var(--ink-soft);
	}
	.is-got .slot-art {
		display: block;
		transition:
			rotate 0.35s var(--ease-out),
			translate 0.35s var(--ease-out);
	}
	.is-got .slot-empty,
	.is-got .slot-hint {
		display: none;
	}
	.is-got .slot-name {
		color: var(--ink);
	}
	.is-got .slot-btn:hover .slot-art,
	.is-got .slot-btn:focus-visible .slot-art {
		rotate: -3deg;
		translate: 0 -6px;
	}
