---
interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
	/**
	 * 'scrapbook' — Guideline B, the paper studio spread. The main site.
	 * 'booth'     — Guideline A, the dark blueprint. Kept for /collection,
	 *               whose shelf and two players are styled against these
	 *               tokens end to end. See FRC/Lab/THEME-B.md for both.
	 */
	theme?: 'scrapbook' | 'booth';
}

const {
	title = 'Futile Studio — Mayur Jivani',
	description = 'The studio scrapbook of Mayur Jivani: small software, built and shipped, pasted in as it lands.',
	noindex = false,
	theme = 'scrapbook',
} = Astro.props;

const isScrapbook = theme === 'scrapbook';

const fonts = isScrapbook
	? 'family=Sniglet:wght@400;800&family=Shantell+Sans:ital,wght@0,400;0,600;0,700;1,400'
	: 'family=Big+Shoulders+Display:wght@400;600;700;800;900&family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;1,400';
const fontHref = `https://fonts.googleapis.com/css2?${fonts}&display=swap`;
---

<!doctype html>
<html lang="en" data-theme={theme}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href={fontHref} rel="stylesheet" media="print" onload="this.media='all'" />
		<noscript><link href={fontHref} rel="stylesheet" /></noscript>
		<!-- Desk settings are applied before first paint, so a chosen lamp, text
		     size or contrast never flashes the default first. Inline on purpose,
		     and a no-op on the blueprint theme, which has no desk. -->
		<script is:inline>
			try {
				const root = document.documentElement;
				if (root.dataset.theme === 'scrapbook') {
					const s = JSON.parse(localStorage.getItem('futile-desk') || '{}');
					if (s.lamp === 'off') root.dataset.lamp = 'off';
					if (s.scale) root.style.setProperty('--text-scale', s.scale);
					if (s.contrast) root.dataset.contrast = 'high';
					if (s.motion) root.dataset.motion = s.motion;
				}
			} catch {
				/* first visit, or storage blocked: the defaults are already correct */
			}
		</script>
	</head>
	<body>
		{
			!isScrapbook && (
				<Fragment>
					{/* ---- Guideline A chrome: blueprint instrumentation ---- */}
					<div class="preloader" id="preloader" aria-hidden="true">
						<svg class="preloader-diagram" viewBox="0 0 200 200" fill="none">
							<circle cx="100" cy="100" r="70" stroke="currentColor" stroke-width="0.6" />
							<circle cx="100" cy="100" r="46" stroke="currentColor" stroke-width="0.6" />
							<circle cx="100" cy="100" r="22" stroke="currentColor" stroke-width="0.6" />
							<line
								x1="100"
								y1="10"
								x2="100"
								y2="190"
								stroke="currentColor"
								stroke-width="0.4"
								stroke-dasharray="2 6"
							/>
							<line
								x1="10"
								y1="100"
								x2="190"
								y2="100"
								stroke="currentColor"
								stroke-width="0.4"
								stroke-dasharray="2 6"
							/>
						</svg>
						<div class="preloader-tag" id="preloader-tag">
							INITIALIZING
						</div>
						<div class="preloader-count">
							<>
								<span id="preloader-pct">00</span>
								<span>%</span>
							</>
						</div>
						<div class="preloader-bar">
							<div class="preloader-bar-fill" id="preloader-bar-fill" />
						</div>
					</div>

					<div class="cursor" id="cursor" aria-hidden="true">
						<div class="cursor-ring" id="cursor-ring" />
						<div class="cursor-dot" id="cursor-dot" />
						<div class="cursor-coord" id="cursor-coord">
							X 0000 · Y 0000
						</div>
					</div>

					<div class="scroll-progress" id="scroll-progress" />
					<div class="rule rule-top" aria-hidden="true">
						<span>FUTILE.STUDIO</span>
						<span>N 51.7189° / E 8.7575° — PADERBORN, DE</span>
					</div>
					<div class="mark mark-tl" aria-hidden="true">
						+
					</div>
					<div class="mark mark-tr" aria-hidden="true">
						+
					</div>
					<div class="mark mark-bl" aria-hidden="true">
						+
					</div>
					<div class="mark mark-br" aria-hidden="true">
						+
					</div>
				</Fragment>
			)
		}

		<slot />

		<script>
			import { gsap } from 'gsap';
			import { ScrollTrigger } from 'gsap/ScrollTrigger';
			gsap.registerPlugin(ScrollTrigger);

			const root = document.documentElement;
			const booth = root.dataset.theme === 'booth';

			/* The scrapbook's motion setting overrides the OS one in both
			   directions, so 'on' is honoured on a reduce-motion machine too. */
			const motionPref = root.dataset.motion;
			const reduceMotion =
				motionPref === 'off'
					? true
					: motionPref === 'on'
						? false
						: window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

			/* ---------- Guideline A only: preloader, cursor, progress ---------- */
			if (booth) {
				(function preloader() {
					const el = document.getElementById('preloader');
					const pct = document.getElementById('preloader-pct');
					const bar = document.getElementById('preloader-bar-fill');
					const tag = document.getElementById('preloader-tag');
					if (!el || !pct || !bar || !tag) return;
					const fast = sessionStorage.getItem('futile-visited') === '1';

					document.body.classList.add('is-loading');
					const finish = () => {
						document.body.classList.remove('is-loading');
						sessionStorage.setItem('futile-visited', '1');
						gsap.to(el, {
							yPercent: -100,
							duration: fast || reduceMotion ? 0.3 : 0.6,
							ease: 'power4.inOut',
							onComplete: () => el.remove(),
						});
					};

					if (reduceMotion || fast) {
						pct.textContent = '100';
						bar.style.width = '100%';
						gsap.delayedCall(0.15, finish);
						return;
					}

					const tags = ['INITIALIZING', 'LOADING ASSETS', 'SPINNING UP', 'READY'];
					const proxy = { v: 0 };
					gsap.to(proxy, {
						v: 100,
						duration: 1.0,
						ease: 'power2.inOut',
						onUpdate: () => {
							const v = Math.round(proxy.v);
							pct.textContent = String(v).padStart(2, '0');
							bar.style.width = v + '%';
							const idx = Math.min(tags.length - 1, Math.floor((v / 100) * tags.length));
							if (tag.textContent !== tags[idx]) tag.textContent = tags[idx];
						},
						onComplete: () => gsap.delayedCall(0.15, finish),
					});
				})();

				if (canHover && !reduceMotion) {
					root.classList.add('has-custom-cursor');
					const cursor = document.getElementById('cursor')!;
					const ring = document.getElementById('cursor-ring')!;
					const dot = document.getElementById('cursor-dot')!;
					const coord = document.getElementById('cursor-coord')!;

					const dotX = gsap.quickTo(dot, 'x', { duration: 0.08, ease: 'power3' });
					const dotY = gsap.quickTo(dot, 'y', { duration: 0.08, ease: 'power3' });
					const ringX = gsap.quickTo(ring, 'x', { duration: 0.35, ease: 'power3' });
					const ringY = gsap.quickTo(ring, 'y', { duration: 0.35, ease: 'power3' });

					window.addEventListener('mousemove', (e) => {
						cursor.classList.add('has-moved');
						dotX(e.clientX);
						dotY(e.clientY);
						ringX(e.clientX);
						ringY(e.clientY);
						coord.style.transform = `translate(${e.clientX + 18}px, ${e.clientY + 14}px)`;
						coord.textContent = `X ${String(Math.round(e.clientX)).padStart(4, '0')} · Y ${String(Math.round(e.clientY)).padStart(4, '0')}`;
					});

					document.addEventListener('mouseover', (e) => {
						const t = (e.target as HTMLElement).closest('a, button, [data-magnetic], .shelf-tile');
						cursor.classList.toggle('is-active', !!t);
					});
				}

				const progress = document.getElementById('scroll-progress');
				const onScroll = () => {
					const h = document.documentElement;
					const p = (h.scrollTop / (h.scrollHeight - h.clientHeight)) * 100;
					if (progress) progress.style.width = p + '%';
				};
				document.addEventListener('scroll', onScroll, { passive: true });
				onScroll();
			}

			/* ---------- shared: magnetic hover ---------- */
			if (canHover && !reduceMotion) {
				document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((el) => {
					const strength = parseFloat(el.dataset.magnetic || '0.35');
					const xTo = gsap.quickTo(el, 'x', { duration: 0.5, ease: 'power3' });
					const yTo = gsap.quickTo(el, 'y', { duration: 0.5, ease: 'power3' });
					el.addEventListener('mousemove', (e) => {
						const r = el.getBoundingClientRect();
						xTo((e.clientX - r.left - r.width / 2) * strength);
						yTo((e.clientY - r.top - r.height / 2) * strength);
					});
					el.addEventListener('mouseleave', () => {
						xTo(0);
						yTo(0);
					});
				});
			}

			/* ---------- shared: auto word-split ---------- */
			document.querySelectorAll<HTMLElement>('[data-split]').forEach((el) => {
				const words = el.textContent!.trim().split(/\s+/);
				el.innerHTML = words
					.map((w) => `<span class="split-mask"><span class="split-word">${w}</span></span> `)
					.join('');
			});

			/* ---------- shared: scroll reveal ---------- */
			if (reduceMotion) {
				/* Nothing animates in, so nothing may start hidden. */
				document.querySelectorAll<HTMLElement>('[data-reveal], [data-paste]').forEach((el) => {
					el.style.opacity = '1';
					el.style.transform = 'none';
				});
			} else {
				gsap.utils.toArray<HTMLElement>('[data-reveal]:not([data-reveal="line"])').forEach((el) => {
					const delay = (parseFloat(getComputedStyle(el).getPropertyValue('--d')) || 0) / 1000;
					gsap.set(el, { opacity: 0, y: 28 });
					gsap.to(el, {
						opacity: 1,
						y: 0,
						duration: 0.8,
						delay,
						ease: 'power3.out',
						scrollTrigger: { trigger: el, start: 'top 88%' },
					});
				});

				gsap.utils
					.toArray<SVGPathElement | SVGLineElement>('[data-reveal="line"] .draw-path')
					.forEach((path) => {
						gsap.set(path, { strokeDashoffset: 1 });
						gsap.to(path, {
							strokeDashoffset: 0,
							duration: 1.1,
							ease: 'power3.out',
							scrollTrigger: { trigger: path, start: 'top 92%' },
						});
					});

				document.querySelectorAll<HTMLElement>('[data-split-group]').forEach((group) => {
					const words = group.querySelectorAll('.split-word');
					if (!words.length) return;
					gsap.set(words, { yPercent: 120 });
					gsap.to(words, {
						yPercent: 0,
						duration: 0.9,
						stagger: 0.045,
						ease: 'power4.out',
						scrollTrigger: { trigger: group, start: 'top 85%' },
					});
				});

				/* ---------- scrapbook: paste-in, settling to a hand-placed tilt ----------
				   The resting tilt is randomised per load from one shared range, so a
				   wall of cards reads as placed by hand rather than patterned. The
				   range is fixed; only the value inside it varies. (Guideline B) */
				gsap.utils.toArray<HTMLElement>('[data-paste]').forEach((el) => {
					const rot = parseFloat(el.dataset.paste || '') || Math.random() * 7 - 3.5;
					el.style.setProperty('--rot', `${rot.toFixed(2)}deg`);
					gsap.set(el, { opacity: 0, y: 22, rotate: rot - 4, scale: 0.97 });
					gsap.to(el, {
						opacity: 1,
						y: 0,
						rotate: rot,
						scale: 1,
						duration: 0.55,
						ease: 'back.out(1.4)',
						scrollTrigger: { trigger: el, start: 'top 92%' },
					});
				});
			}

			/* Reduced motion still wants the hand-placed tilt, just not the flight in. */
			if (reduceMotion) {
				document.querySelectorAll<HTMLElement>('[data-paste]').forEach((el) => {
					const rot = parseFloat(el.dataset.paste || '') || Math.random() * 7 - 3.5;
					el.style.setProperty('--rot', `${rot.toFixed(2)}deg`);
				});
			}

			window.addEventListener('load', () => ScrollTrigger.refresh());
		</script>
	</body>
</html>

<style is:global>
	*,
	*::before,
	*::after {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		scroll-behavior: smooth;
		overflow-x: hidden;
		width: 100%;
	}

	a {
		color: inherit;
	}

	/* ===================================================================
	   GUIDELINE B — the studio scrapbook
	   Kraft ground, bright paper pasted onto it, flat hard-offset shadows
	   so everything reads as cut paper rather than floating UI. Spec and
	   rationale: FRC/Lab/THEME-B.md
	   =================================================================== */

	[data-theme='scrapbook'] {
		/* Shared with lab.futile.studio so the two read as one studio: paper,
		   cream, ink and both accents are Lab's exact tokens. (FRC/Lab/THEME-B.md) */
		--paper: #f7f4ec;
		--paper-2: #efeade;
		--card: #f8f4e7;
		--card-2: #f1ecdd;

		--ink: #1b2132;
		--ink-soft: rgba(27, 33, 50, 0.68);
		--ink-faint: rgba(27, 33, 50, 0.4);
		--ink-ghost: rgba(27, 33, 50, 0.16);

		--stamp: #e0574a;
		--live: #3fa34d;
		--marker: #f5d547;
		--thread: #9a6b4f;

		--shadow: rgba(27, 33, 50, 0.26);
		--shadow-deep: rgba(27, 33, 50, 0.3);

		--bubble: 'Sniglet', 'Comic Sans MS', cursive;
		--hand: 'Shantell Sans', 'Segoe Print', cursive;

		--text-scale: 1;
		font-size: calc(16px * var(--text-scale));
	}

	/* The desk lamp, switched off: same paper, late in the evening. */
	[data-theme='scrapbook'][data-lamp='off'] {
		--paper: #2a2620;
		--paper-2: #221e19;
		--card: #39332b;
		--card-2: #322c25;

		--ink: #f2ead8;
		--ink-soft: rgba(242, 234, 216, 0.7);
		--ink-faint: rgba(242, 234, 216, 0.42);
		--ink-ghost: rgba(242, 234, 216, 0.16);

		--stamp: #ef7565;
		--live: #5fbf6c;
		--marker: #b2922c;
		--thread: #b08a68;

		--shadow: rgba(0, 0, 0, 0.5);
		--shadow-deep: rgba(0, 0, 0, 0.58);
	}

	/* Real contrast, not a darker grey: borders and secondary ink go solid. */
	[data-theme='scrapbook'][data-contrast='high'] {
		--ink-soft: var(--ink);
		--ink-faint: var(--ink);
		--ink-ghost: rgba(27, 33, 50, 0.4);
		--shadow: var(--ink);
		--shadow-deep: var(--ink);
	}
	[data-theme='scrapbook'][data-contrast='high'][data-lamp='off'] {
		--ink-ghost: rgba(242, 234, 216, 0.4);
	}

	[data-theme='scrapbook'] body {
		background-color: var(--paper);
		/* Faint ledger grid: the page is still a working sheet. */
		background-image:
			linear-gradient(var(--ink-ghost) 1px, transparent 1px),
			linear-gradient(90deg, var(--ink-ghost) 1px, transparent 1px);
		background-size: 34px 34px;
		color: var(--ink);
		font-family: var(--hand);
		font-size: 0.93rem;
		line-height: 1.65;
		min-height: 100vh;
		overflow-x: hidden;
		transition:
			background-color 0.45s ease,
			color 0.45s ease;
	}

	/* Paper grain, multiplied into the stock. */
	[data-theme='scrapbook'] body::before {
		content: '';
		position: fixed;
		inset: 0;
		background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
		opacity: 0.055;
		mix-blend-mode: multiply;
		pointer-events: none;
		z-index: 900;
	}
	[data-theme='scrapbook'][data-lamp='off'] body::before {
		mix-blend-mode: screen;
		opacity: 0.04;
	}

	[data-theme='scrapbook'] ::selection {
		background: var(--marker);
		color: #1b2132;
	}

	[data-theme='scrapbook'] h1,
	[data-theme='scrapbook'] h2,
	[data-theme='scrapbook'] h3 {
		font-family: var(--bubble);
		font-weight: 800;
		letter-spacing: 0;
		line-height: 1.14;
	}

	[data-theme='scrapbook'] :focus-visible {
		outline: 3px solid var(--stamp);
		outline-offset: 3px;
	}

	/* ---------- Guideline B primitives ---------- */

	/* A sheet of bright paper pasted onto the kraft ground. Flat offset
	   shadow, no blur, thin ink border at partial alpha, softly rounded. */
	[data-theme='scrapbook'] .sheet {
		position: relative;
		background: var(--card);
		border: 1.5px solid var(--ink-soft);
		border-radius: 7px;
		box-shadow: 4px 4px 0 var(--shadow);
		transform: rotate(var(--rot, 0deg));
	}

	/* Cat-eared corner, cut from a gradient rather than an image asset. */
	[data-theme='scrapbook'] .sheet-catear::after {
		content: '';
		position: absolute;
		right: 0;
		bottom: 0;
		width: 20px;
		height: 20px;
		background: linear-gradient(
			135deg,
			transparent 50%,
			rgba(0, 0, 0, 0.14) 50%,
			rgba(0, 0, 0, 0.07) 55%,
			var(--paper) 55%
		);
	}

	/* Mounts. Assigned in markup, never randomised: a mix of pin, tape and
	   photo corners reads as a deliberate choice; a random one reads as noise. */
	[data-theme='scrapbook'] .mount {
		position: absolute;
		z-index: 2;
		pointer-events: none;
	}
	[data-theme='scrapbook'] .mount-pin {
		top: -9px;
		left: 50%;
		transform: translateX(-50%);
		width: 15px;
		height: 15px;
		border-radius: 50%;
		background: radial-gradient(circle at 35% 30%, #fff, var(--stamp) 45%, #8f2c1b 100%);
		box-shadow: 0 2px 3px rgba(0, 0, 0, 0.35);
	}
	[data-theme='scrapbook'] .mount-tape {
		top: -11px;
		left: 50%;
		width: 68px;
		height: 22px;
		transform: translateX(-50%) rotate(-3deg);
		background: rgba(255, 255, 255, 0.5);
		border: 1px solid rgba(255, 255, 255, 0.22);
		box-shadow: inset 0 0 0 1px rgba(27, 33, 50, 0.05);
	}
	[data-theme='scrapbook'][data-lamp='off'] .mount-tape {
		background: rgba(255, 255, 255, 0.14);
	}
	/* Photo corner: a paper triangle the sheet tucks into. */
	[data-theme='scrapbook'] .mount-corner {
		width: 22px;
		height: 22px;
		background: var(--ink-soft);
		opacity: 0.55;
	}
	[data-theme='scrapbook'] .mount-corner-tl {
		top: -1px;
		left: -1px;
		clip-path: polygon(0 0, 100% 0, 0 100%);
	}
	[data-theme='scrapbook'] .mount-corner-br {
		right: -1px;
		bottom: -1px;
		clip-path: polygon(100% 100%, 100% 0, 0 100%);
	}
	/* Paperclip, bent over the top edge. */
	[data-theme='scrapbook'] .mount-clip {
		top: -14px;
		left: 22px;
		width: 16px;
		height: 34px;
		border: 2px solid var(--ink-faint);
		border-radius: 8px;
		background: transparent;
	}
	[data-theme='scrapbook'] .mount-clip::after {
		content: '';
		position: absolute;
		inset: 4px 4px 10px;
		border: 2px solid var(--ink-ghost);
		border-radius: 5px;
		border-bottom: none;
	}

	/* A pressed rubber stamp. Slightly rotated, ink never quite solid. */
	[data-theme='scrapbook'] .stamp {
		display: inline-block;
		font-family: var(--bubble);
		font-weight: 800;
		font-size: 0.6rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--stamp);
		border: 2px solid var(--stamp);
		border-radius: 4px;
		padding: 2px 7px;
		opacity: 0.8;
		transform: rotate(-4deg);
	}

	/* Highlighter swipe behind inline text. */
	[data-theme='scrapbook'] .marker {
		background: linear-gradient(to top, var(--marker) 0 42%, transparent 42%);
		padding: 0 2px;
	}

	/* Hand-drawn underline under a headline fragment. */
	[data-theme='scrapbook'] .underline-wrap {
		position: relative;
		display: inline-block;
	}
	[data-theme='scrapbook'] .underline-wrap svg {
		position: absolute;
		left: -4px;
		bottom: -0.16em;
		width: calc(100% + 8px);
		height: 0.22em;
		overflow: visible;
		color: var(--stamp);
	}

	/* The shared scrapbook button: a small paper tab you can press. */
	[data-theme='scrapbook'] .btn {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		background: var(--card);
		color: var(--ink);
		border: 1.5px solid var(--ink-soft);
		border-radius: 8px;
		padding: 0.5rem 0.9rem;
		font-family: var(--hand);
		font-weight: 700;
		font-size: 0.82rem;
		text-decoration: none;
		cursor: pointer;
		box-shadow: 3px 3px 0 var(--shadow);
		transition:
			transform 0.12s ease,
			box-shadow 0.12s ease,
			background 0.2s ease;
	}
