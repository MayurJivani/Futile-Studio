---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import DeskPanel from '../components/DeskPanel.astro';
import Cursors from '../components/Cursors.astro';
import DeskToys from '../components/DeskToys.astro';
import Stickers from '../components/Stickers.astro';
import DeskClock from '../components/DeskClock.astro';
import Legend from '../components/Legend.astro';
import ShippingLog from '../components/ShippingLog.astro';
import Marquee from '../components/Marquee.astro';
import Sketch from '../components/Sketch.astro';
import { open, workbench } from '../data/projects.js';

const spec = [
	['Makes', 'Web things, mostly games and small tools'],
	['Studying', 'M.Sc. Computer Science at Paderborn'],
	['Speaks', 'English, and German if you are patient'],
	['Plays', 'Vinyl, cassettes, and whatever Chorusify picks'],
	['Sits in', 'Paderborn, Germany'],
];

/* What I actually reach for. Grouped the way I think about it rather than the
   way a keyword filter would like it. */
const kit = [
	{ group: 'Front of house', items: ['React', 'Astro', 'TypeScript', 'Next.js', 'Tailwind', 'Vite'] },
	{ group: 'Back of house', items: ['Node', 'Express', 'Python', 'Flask', 'WebSockets', 'REST'] },
	{ group: 'Where things are kept', items: ['Postgres', 'SQLite', 'MongoDB', 'MySQL', 'Redis'] },
	{
		group: 'Getting it out there',
		items: ['Docker', 'Proxmox', 'Caddy', 'Nginx', 'Cloudflare', 'CI/CD', 'Git', 'AWS'],
	},
];
---

<Layout>
	<Nav />
	<DeskPanel />
	<Cursors />

	<!-- ============ HERO: the inside cover ============ -->
	<header class="cover">
		<DeskToys />

		<div class="cover-meta" data-reveal>
			<p class="cover-tag">studio scrapbook · Paderborn, DE</p>
			<DeskClock />
		</div>

		<h1 class="cover-title" data-split-group>
			<span class="split-mask"><span class="split-word">A</span></span>
			<span class="split-mask"><span class="split-word">paper</span></span>
			<span class="split-mask"><span class="split-word">trail</span></span><br />
			<span class="underline-wrap">
				<span class="split-mask"><span class="split-word">of</span></span>
				<span class="split-mask"><span class="split-word">small</span></span>
				<span class="split-mask"><span class="split-word">software.</span></span>
				<svg viewBox="0 0 300 12" preserveAspectRatio="none" aria-hidden="true">
					<path
						d="M2 7c44-7 214-7 296 2"
						fill="none"
						stroke="currentColor"
						stroke-width="4"
						stroke-linecap="round"></path>
				</svg>
			</span>
		</h1>

		<p class="cover-sub" data-reveal style="--d:140ms">
			I'm Mayur. I make small things for the web, mostly games and tools, and stick them in here as they land. <span
				class="marker">{open.length} are open to anyone</span
			> right now.
		</p>

		<div class="cover-actions" data-reveal style="--d:220ms">
			<a href="#work" class="btn btn-stamp" data-magnetic="0.2">
				See the board
				<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
					<path d="M8 3v10M4 9l4 4 4-4"></path>
				</svg>
			</a>
			<a href="/jinx" class="btn" data-magnetic="0.2">
				Meet the server
				<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
					<path d="M3 8h10M9 4l4 4-4 4"></path>
				</svg>
			</a>
			<a href="/cv.pdf" download="Mayur_Jivani_CV.pdf" class="btn" data-magnetic="0.2">
				Take the CV
				<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
					<path d="M8 3v7M5 7l3 3 3-3M3 13h10"></path>
				</svg>
			</a>
		</div>

		<Stickers />
	</header>

	<Legend />

	<!-- ============ ABOUT ============ -->
	<section id="about" class="about">
		<span class="doodle doodle-vinyl" aria-hidden="true"><Sketch name="vinyl" /></span>
		<h2 class="sect-label" data-annotate>Who is sticking all this up</h2>

		<div class="about-grid">
			<article class="card-index sheet sheet-catear" data-paste="-1.2">
				<span class="mount mount-corner mount-corner-tl" aria-hidden="true"></span>
				<span class="mount mount-corner mount-corner-br" aria-hidden="true"></span>

				<p>
					I like knowing how things work, so I tend to build one until it does. Most of this page began as a
					scribble that could have stayed a scribble, and the interesting part was carrying on past the point
					where it stopped being fun.
				</p>
				<p>
					Everything here runs on a machine I can walk over to, which keeps the whole chain within reach: the
					metal, the containers, the routing, the backups. At 1am the problem is on this side of the wall,
					which is the quickest way I know to learn how any of it holds together.
				</p>
				<p>
					Away from a keyboard I collect vinyl and cassettes, and record a little under
					<span class="marker">Futile Rec. Co</span>. A record is a thing you can hand to somebody, and a
					shelf says more about a few years than a listening history does.
				</p>
			</article>

			<aside class="card-spec sheet" data-paste="1.8">
				<span class="mount mount-clip" aria-hidden="true"></span>
				<h3 class="card-spec-head">The short version</h3>
				<dl class="spec-list">
					{
						spec.map(([k, v]) => (
							<div class="spec-row">
								<dt>{k}</dt>
								<dd>{v}</dd>
							</div>
						))
					}
				</dl>
				<a href="/cv.pdf" download="Mayur_Jivani_CV.pdf" class="btn spec-cv">
					Full CV, one page
					<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
						<path d="M8 3v7M5 7l3 3 3-3M3 13h10"></path>
					</svg>
				</a>
			</aside>
		</div>
	</section>

	<!-- ============ THE KIT ============ -->
	<section id="kit" class="kit">
		<span class="doodle doodle-can" aria-hidden="true"><Sketch name="can" /></span>
		<h2 class="sect-label" data-annotate>What I reach for</h2>
		<p class="kit-intro">
			The things I keep picking up. Most of the board above is some arrangement of these.
		</p>
		<div class="kit-grid">
			{
				kit.map((k) => (
					<div class="kit-card sheet" data-paste>
						<span class="mount mount-tape" aria-hidden="true" />
						<h3 class="kit-group">{k.group}</h3>
						<ul class="kit-items">
							{k.items.map((i) => (
								<li class="kit-item">{i}</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</section>

	<!-- ============ THE BOARD ============ -->
	<section id="work" class="board">
		<span class="doodle doodle-postcard" aria-hidden="true"><Sketch name="postcard" /></span>
		<div class="board-head">
			<h2 class="sect-label" data-annotate>The board</h2>
			<p class="board-intro">
				Everything anyone can open, newest first. Each link goes straight to the running thing, so you can
				judge it the way anybody else would.
			</p>
		</div>

		<div class="board-grid">
			{
				open.map((p) => (
					<a
						class:list={['proj', 'sheet', 'sheet-catear', { 'is-pick': p.pick }]}
						href={p.href}
						target="_blank"
						rel="noopener"
						data-paste
					>
						<span
							class:list={['mount', `mount-${p.mount === 'corner' ? 'corner mount-corner-tl' : p.mount}`]}
							aria-hidden="true"
						/>

						<span class="proj-sketch" aria-hidden="true">
							<Sketch name={p.art} class="proj-sketch-svg" />
						</span>

						<span class="proj-meta">
							<span class="proj-dot" aria-hidden="true" />
							{p.kind}
							{p.shipped && <span class="proj-year">{p.shipped.slice(0, 4)}</span>}
						</span>

						<h3 class="proj-name">{p.name}</h3>
						{p.pick && <span class="proj-pick stamp">start here</span>}

						<p class="proj-desc">{p.desc}</p>
						<p class="proj-stack">{p.stack}</p>
						<span class="proj-cta">{p.cta} →</span>
					</a>
				))
			}
		</div>

		<!-- the half-built half -->
		<div class="bench">
			<span class="doodle doodle-crate" aria-hidden="true"><Sketch name="crate" /></span>
			<p class="bench-head">
				Still on the workbench
				<span class="bench-rule"></span>
			</p>
			<p class="bench-note margin-note">
				Some half-built, some finished and waiting for somewhere to live. Here because a page showing only the
				flattering half would be a brochure.
			</p>
			<div class="bench-grid">
				{
					workbench.map((p) => (
						<article class="proj proj-bench sheet" data-paste>
							<span class:list={['mount', `mount-${p.mount}`]} aria-hidden="true" />
							<span class="proj-sketch" aria-hidden="true">
								<Sketch name={p.art} class="proj-sketch-svg" />
							</span>
							<span class="proj-meta">
								<span class="proj-dot proj-dot-off" aria-hidden="true" />
								{p.kind}
							</span>
							<h3 class="proj-name">{p.name}</h3>
							<p class="proj-desc">{p.desc}</p>
							<p class="proj-stack">{p.stack}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<ShippingLog />

	<!-- ============ JINX TEASER ============ -->
	<section class="jinx-card-wrap">
		<span class="doodle doodle-plant" aria-hidden="true"><Sketch name="plant" /></span>
		<a href="/jinx" class="jinx-card sheet sheet-catear" data-paste="-1.4">
			<span class="mount mount-tape" aria-hidden="true"></span>
			<span class="jinx-card-art" aria-hidden="true"><Sketch name="cat" /></span>
			<div class="jinx-card-copy">
				<h2 class="jinx-card-head">Everything here sits on one box</h2>
				<p>
					Jinx, bare metal in my flat. Its own page has the layers it is built from, and how it is doing
					today.
				</p>
				<span class="proj-cta">Go and look →</span>
			</div>
		</a>
	</section>

	<Marquee items={['Cut out', 'Stuck down', 'Annotated', 'Cat-eared', 'Filed']} speed={30} />

	<!-- ============ FOOTER ============ -->
	<footer class="foot">
		<span class="doodle doodle-reel" aria-hidden="true"><Sketch name="tape-reel" /></span>
		<div class="foot-left">
			<p class="foot-logo">futile<span class="nav-dot">.</span>studio</p>
			<p class="foot-copy">© 2026 Mayur Jivani · cut and pasted by hand</p>
			<p class="margin-note foot-wink">Named in a mood. Kept out of habit.</p>
		</div>

		<ul class="foot-links">
			<li><a class="btn" href="https://github.com/mayurjivani" target="_blank" rel="noopener">GitHub</a></li>
			<li>
				<a class="btn" href="https://linkedin.com/in/mayurjivani" target="_blank" rel="noopener">LinkedIn</a>
			</li>
			<li><a class="btn" href="mailto:mayur@futile.studio">Email</a></li>
			<li><a class="btn" href="/cv.pdf" download="Mayur_Jivani_CV.pdf">CV</a></li>
		</ul>
	</footer>
</Layout>

<style>
	/* ============ hero ============ */
	.cover {
		position: relative;
		max-width: 1140px;
		margin: 0 auto;
		padding: 3.2rem 2.2rem 3rem;
	}

	.cover-meta {
		display: flex;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
		margin-bottom: 1.5rem;
	}
	.cover-tag {
		display: inline-block;
		font-family: var(--hand);
		font-weight: 700;
		font-size: 0.82rem;
		background: var(--card);
		border: 1.5px solid var(--ink-soft);
		border-radius: 8px;
		padding: 0.3rem 0.8rem;
		transform: rotate(-2deg);
		box-shadow: 3px 3px 0 var(--shadow);
	}

	.cover-title {
		font-size: clamp(2.1rem, 6.6vw, 4.1rem);
		max-width: 30ch;
		margin-bottom: 1.6rem;
	}

	.cover-sub {
		max-width: 36rem;
		font-size: 1.02rem;
		font-weight: 600;
		line-height: 1.75;
		color: var(--ink-soft);
	}

	.cover-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
		margin-top: 1.8rem;
	}
	.cover-actions .btn {
		font-size: 0.9rem;
		padding: 0.6rem 1.1rem;
	}

	/* ============ about ============ */
	.about {
		max-width: 1140px;
		margin: 0 auto;
		padding: 3.5rem 2.2rem 1rem;
		position: relative;
	}

	.about-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
		gap: 2.4rem;
		align-items: start;
	}
	@media (max-width: 880px) {
		.about-grid {
			grid-template-columns: 1fr;
			gap: 2.8rem;
		}
	}

	/* An index card: ruled, with a red margin line down the left. */
	.card-index {
		padding: 1.6rem 1.8rem 1.6rem 2.6rem;
		background-image:
			linear-gradient(var(--ink-ghost) 1px, transparent 1px),
			linear-gradient(
				90deg,
				transparent 1.9rem,
				rgba(194, 69, 45, 0.3) 1.9rem,
				transparent calc(1.9rem + 2px)
			);
		background-size:
			100% 1.75rem,
			100% 100%;
		background-position:
			0 1.2rem,
			0 0;
	}
	.card-index p + p {
		margin-top: 1.1rem;
	}
	.card-index p {
		font-size: 0.93rem;
		line-height: 1.75;
		color: var(--ink-soft);
	}

	.card-spec {
		padding: 1.5rem 1.4rem 1.4rem;
		background: var(--card-2);
	}
	.card-spec-head {
		font-size: 1rem;
		margin-bottom: 0.9rem;
		padding-bottom: 0.5rem;
		border-bottom: 2px dashed var(--ink-ghost);
	}

	.spec-list {
		display: flex;
		flex-direction: column;
	}
	.spec-row {
		display: grid;
		grid-template-columns: 5.4rem 1fr;
		gap: 0.6rem;
		padding: 0.5rem 0;
		border-bottom: 1px solid var(--ink-ghost);
		font-size: 0.84rem;
	}
	.spec-row:last-child {
		border-bottom: none;
	}
	.spec-row dt {
		font-family: var(--bubble);
		font-weight: 800;
		font-size: 0.78rem;
		color: var(--ink);
	}
	.spec-row dd {
		color: var(--ink-soft);
	}
	.spec-cv {
		margin-top: 1.1rem;
	}

	/* ---- doodles down the page, one per section, kept sparse on purpose ---- */
	.about,
	.kit,
	.board,
	.jinx-card-wrap,
	.foot {
		position: relative;
	}
	.doodle-vinyl {
		top: 1.6rem;
		right: 2.5%;
		width: 3.4rem;
		height: 3.4rem;
		transform: rotate(9deg);
	}
	.doodle-can {
		top: 2.4rem;
		right: 6%;
		width: 2.5rem;
		height: 2.5rem;
		transform: rotate(-11deg);
	}
	.doodle-postcard {
		top: 1.1rem;
		right: 3%;
		width: 3.8rem;
		height: 2.8rem;
		transform: rotate(5deg);
	}
	.bench {
		position: relative;
	}
	.doodle-crate {
		top: -0.4rem;
		right: 1%;
		width: 2.5rem;
		height: 2.5rem;
		transform: rotate(-8deg);
	}
	.doodle-plant {
		bottom: 1.2rem;
		left: 3%;
		width: 2.6rem;
		height: 2.6rem;
		transform: rotate(-4deg);
	}
	.doodle-reel {
		top: 0.6rem;
		right: 8%;
		width: 3.4rem;
		height: 2.4rem;
		transform: rotate(-7deg);
	}
	/* Below this the copy needs the room more than the decoration does. */
	@media (max-width: 1000px) {
		.doodle-can,
		.doodle-postcard,
		.bench {
			position: relative;
		}
		.doodle-crate {
			top: -0.4rem;
			right: 1%;
			width: 2.5rem;
			height: 2.5rem;
			transform: rotate(-8deg);
		}
		.doodle-plant {
			display: none;
		}
	}

	/* ============ the kit ============ */
	.kit {
		max-width: 1140px;
		margin: 0 auto;
		padding: 3.5rem 2.2rem 1rem;
	}
	.kit-intro {
		font-size: 0.92rem;
		line-height: 1.7;
		color: var(--ink-soft);
		max-width: 38rem;
		margin-bottom: 2rem;
	}
	.kit-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
		gap: 2.4rem 1.6rem;
		padding-top: 0.5rem;
	}
	.kit-card {
		padding: 1.4rem 1.2rem 1.2rem;
		background: var(--card-2);
	}
	.kit-group {
		font-size: 0.95rem;
		margin-bottom: 0.8rem;
		padding-bottom: 0.45rem;
		border-bottom: 2px dashed var(--ink-ghost);
	}
	.kit-items {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}
	/* Each one a little torn-off label rather than a progress bar: I am not
	   going to pretend a percentage means anything here. */
	.kit-item {
		font-family: var(--hand);
		font-weight: 700;
		font-size: 0.78rem;
		color: var(--ink);
		background: var(--card);
		border: 1.5px solid var(--ink-soft);
		border-radius: 6px;
		padding: 0.18rem 0.5rem;
		box-shadow: 2px 2px 0 var(--shadow);
	}

	/* ============ the board ============ */
	.board {
		max-width: 1140px;
		margin: 0 auto;
		padding: 3.5rem 2.2rem 1rem;
	}
	.board-head {
		max-width: 44rem;
		margin-bottom: 2.2rem;
	}
	.board-intro {
		font-size: 0.92rem;
		line-height: 1.7;
		color: var(--ink-soft);
		max-width: 38rem;
	}

	.board-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(15.5rem, 1fr));
		gap: 2.8rem 1.7rem;
		padding-top: 0.5rem;
	}

	.proj {
		display: block;
		padding: 1.5rem 1.2rem 1.3rem;
		text-decoration: none;
		color: var(--ink);
		transition:
			transform 0.15s ease,
			box-shadow 0.15s ease;
	}
	/* Hover straightens the card and lifts it. Every card behaves the same
	   on hover; only the resting tilt is random. (Guideline B) */
	a.proj:hover {
		transform: rotate(0deg) translateY(-5px);
		box-shadow: 5px 8px 0 var(--shadow-deep);
	}
	.proj.is-pick {
		background: var(--card);
		border-color: var(--ink);
	}

	.proj-sketch {
		display: block;
		height: 3.2rem;
		margin-bottom: 1rem;
		color: var(--ink-soft);
	}
	.proj-sketch :global(.proj-sketch-svg) {
		height: 100%;
		width: auto;
		max-width: 100%;
	}

	.proj-meta {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		font-size: 0.74rem;
		font-weight: 700;
		color: var(--ink-faint);
		margin-bottom: 0.3rem;
	}
	.proj-year {
		margin-left: auto;
		font-variant-numeric: tabular-nums;
	}
	.proj-dot {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: var(--live);
		flex-shrink: 0;
	}
	.proj-dot-off {
		background: var(--ink-ghost);
	}

	.proj-name {
		font-size: 1.25rem;
		margin-bottom: 0.4rem;
	}
	.proj-pick {
		margin-bottom: 0.6rem;
	}
	.proj-desc {
		font-size: 0.84rem;
		line-height: 1.65;
		color: var(--ink-soft);
	}
	.proj-stack {
		margin-top: 0.7rem;
		font-size: 0.74rem;
		font-style: italic;
		color: var(--ink-faint);
	}
	.proj-cta {
		display: block;
		margin-top: 0.9rem;
		font-family: var(--bubble);
		font-weight: 800;
		font-size: 0.84rem;
		color: var(--stamp);
	}

	/* ---- workbench ---- */
	.bench {
		margin-top: 3.4rem;
	}
	.bench-head {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		font-family: var(--bubble);
		font-weight: 800;
		font-size: 1.05rem;
		color: var(--ink-soft);
	}
	.bench-rule {
		flex: 1;
		height: 0;
		border-top: 2px dashed var(--ink-ghost);
	}
	.bench-note {
		margin: 0.5rem 0 1.5rem;
		max-width: 34rem;
	}
	.bench-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: 2.4rem 1.7rem;
	}
	.proj-bench {
		background: transparent;
		border-style: dashed;
		box-shadow: none;
	}
	.proj-bench .proj-sketch,
	.proj-bench .proj-name {
		opacity: 0.75;
	}

	/* ============ jinx teaser ============ */
	.jinx-card-wrap {
		max-width: 1140px;
		margin: 0 auto;
		padding: 2rem 2.2rem 3.5rem;
	}
	.jinx-card {
		display: flex;
		align-items: center;
		gap: 1.6rem;
		padding: 1.6rem 1.8rem;
		text-decoration: none;
