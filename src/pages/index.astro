---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import DeskPanel from '../components/DeskPanel.astro';
import Cursors from '../components/Cursors.astro';
import DeskToys from '../components/DeskToys.astro';
import Stickers from '../components/Stickers.astro';
import DeskClock from '../components/DeskClock.astro';
import Legend from '../components/Legend.astro';
import ShippingLog from '../components/ShippingLog.astro';
import Marquee from '../components/Marquee.astro';
import Sketch from '../components/Sketch.astro';
import { open, workbench } from '../data/projects.js';

const spec = [
	['Makes', 'Web things, mostly games and small tools'],
	['Studying', 'M.Sc. Computer Science at Paderborn'],
	['Speaks', 'English, and German if you are patient'],
	['Plays', 'Vinyl, cassettes, and whatever Chorusify picks'],
	['Sits in', 'Paderborn, Germany'],
];

/* What I actually reach for. Grouped the way I think about it rather than the
   way a keyword filter would like it. */
const kit = [
	{ group: 'Front of house', items: ['React', 'Astro', 'TypeScript', 'Next.js', 'Tailwind', 'Vite'] },
	{ group: 'Back of house', items: ['Node', 'Express', 'Python', 'Flask', 'WebSockets', 'REST'] },
	{ group: 'Where things are kept', items: ['Postgres', 'SQLite', 'MongoDB', 'MySQL', 'Redis'] },
	{
		group: 'Getting it out there',
		items: ['Docker', 'Proxmox', 'Caddy', 'Nginx', 'Cloudflare', 'CI/CD', 'Git', 'AWS'],
	},
];
---

<Layout>
	<Nav />
	<DeskPanel />
	<Cursors />

	<!-- ============ HERO: the inside cover ============ -->
	<header class="cover">
		<DeskToys />

		<div class="cover-meta" data-reveal>
			<p class="cover-tag">studio scrapbook · Paderborn, DE</p>
			<DeskClock />
		</div>

		<h1 class="cover-title" data-split-group>
			<span class="split-mask"><span class="split-word">A</span></span>
			<span class="split-mask"><span class="split-word">paper</span></span>
			<span class="split-mask"><span class="split-word">trail</span></span><br />
			<span class="underline-wrap">
				<span class="split-mask"><span class="split-word">of</span></span>
				<span class="split-mask"><span class="split-word">small</span></span>
				<span class="split-mask"><span class="split-word">software.</span></span>
				<svg viewBox="0 0 300 12" preserveAspectRatio="none" aria-hidden="true">
					<path
						d="M2 7c44-7 214-7 296 2"
						fill="none"
						stroke="currentColor"
						stroke-width="4"
						stroke-linecap="round"></path>
				</svg>
			</span>
		</h1>

		<p class="cover-sub" data-reveal style="--d:140ms">
			I'm Mayur. I make things for the web, mostly games and small tools, then cut them out and stick them in
			here. <span class="marker">{open.length} of them are open to anyone</span> right now; the rest of this page
			is how they got made and what they sit on.
		</p>

		<div class="cover-actions" data-reveal style="--d:220ms">
			<a href="#work" class="btn btn-stamp" data-magnetic="0.2">
				See the board
				<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
					<path d="M8 3v10M4 9l4 4 4-4"></path>
				</svg>
			</a>
			<a href="/jinx" class="btn" data-magnetic="0.2">
				Meet the server
				<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
					<path d="M3 8h10M9 4l4 4-4 4"></path>
				</svg>
			</a>
			<a href="/cv.pdf" download="Mayur_Jivani_CV.pdf" class="btn" data-magnetic="0.2">
				Take the CV
				<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
					<path d="M8 3v7M5 7l3 3 3-3M3 13h10"></path>
				</svg>
			</a>
		</div>

		<Stickers />
	</header>

	<Legend />

	<!-- ============ ABOUT ============ -->
	<section id="about" class="about">
		<h2 class="sect-label" data-annotate>Who is sticking all this up</h2>

		<div class="about-grid">
			<article class="card-index sheet sheet-catear" data-paste="-1.2">
				<span class="mount mount-corner mount-corner-tl" aria-hidden="true"></span>
				<span class="mount mount-corner mount-corner-br" aria-hidden="true"></span>

				<p>
					I build things and then do the unglamorous half, which turns out to be the rare bit. Most of what is
					on this page could have stayed a sketch in a notebook, and the only interesting decision was
					carrying on past the point where it stopped being fun.
				</p>
				<p>
					I like owning the whole line. The code is mine, the box under it is mine, the domain routing and the
					nightly backups are mine. None of this sits in somebody else's cloud, which means at 1am it is
					unambiguously my problem. That is the trade, and it is the fastest way I know to find out how any of
					it actually works.
				</p>
				<p>
					Away from a keyboard I collect vinyl and cassettes and record a little under
					<span class="marker">Futile Rec. Co</span>. Physical media mostly, because a record is a thing you
					can put in somebody's hands, and because a shelf is a nicer record of a few years than a listening
					history is.
				</p>
			</article>

			<aside class="card-spec sheet" data-paste="1.8">
				<span class="mount mount-clip" aria-hidden="true"></span>
				<h3 class="card-spec-head">The short version</h3>
				<dl class="spec-list">
					{
						spec.map(([k, v]) => (
							<div class="spec-row">
								<dt>{k}</dt>
								<dd>{v}</dd>
							</div>
						))
					}
				</dl>
				<a href="/cv.pdf" download="Mayur_Jivani_CV.pdf" class="btn spec-cv">
					Full CV, one page
					<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
						<path d="M8 3v7M5 7l3 3 3-3M3 13h10"></path>
					</svg>
				</a>
			</aside>
		</div>
	</section>

	<!-- ============ THE KIT ============ -->
	<section id="kit" class="kit">
		<h2 class="sect-label" data-annotate>What I reach for</h2>
		<p class="kit-intro">
			Not a ranking and not a complete list, just the things I keep picking up. Most of the board above is
			some arrangement of these.
		</p>
		<div class="kit-grid">
			{
				kit.map((k) => (
					<div class="kit-card sheet" data-paste>
						<span class="mount mount-tape" aria-hidden="true" />
						<h3 class="kit-group">{k.group}</h3>
						<ul class="kit-items">
							{k.items.map((i) => (
								<li class="kit-item">{i}</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</section>

	<!-- ============ THE BOARD ============ -->
	<section id="work" class="board">
		<div class="board-head">
			<h2 class="sect-label" data-annotate>The board</h2>
			<p class="board-intro">
				Everything anyone can open, newest nearest the top. No mockups and no case studies: each link below
				goes straight to the thing itself, so you can judge it the way anybody else would.
			</p>
		</div>

		<div class="board-grid">
			{
				open.map((p) => (
					<a
						class:list={['proj', 'sheet', 'sheet-catear', { 'is-pick': p.pick }]}
						href={p.href}
						target="_blank"
						rel="noopener"
						data-paste
					>
						<span
							class:list={['mount', `mount-${p.mount === 'corner' ? 'corner mount-corner-tl' : p.mount}`]}
							aria-hidden="true"
						/>

						<span class="proj-sketch" aria-hidden="true">
							<Sketch name={p.art} class="proj-sketch-svg" />
						</span>

						<span class="proj-meta">
							<span class="proj-dot" aria-hidden="true" />
							{p.kind}
							{p.shipped && <span class="proj-year">{p.shipped.slice(0, 4)}</span>}
						</span>

						<h3 class="proj-name">{p.name}</h3>
						{p.pick && <span class="proj-pick stamp">start here</span>}

						<p class="proj-desc">{p.desc}</p>
						<p class="proj-stack">{p.stack}</p>
						<span class="proj-cta">{p.cta} →</span>
					</a>
				))
			}
		</div>

		<!-- the half-built half -->
		<div class="bench">
			<p class="bench-head">
				Still on the workbench
				<span class="bench-rule"></span>
			</p>
			<p class="bench-note margin-note">
				On the board because a page with only the flattering half of the drawer on it would be a brochure.
			</p>
			<div class="bench-grid">
				{
					workbench.map((p) => (
						<article class="proj proj-bench sheet" data-paste>
							<span class:list={['mount', `mount-${p.mount}`]} aria-hidden="true" />
							<span class="proj-sketch" aria-hidden="true">
								<Sketch name={p.art} class="proj-sketch-svg" />
							</span>
							<span class="proj-meta">
								<span class="proj-dot proj-dot-off" aria-hidden="true" />
								{p.kind}
							</span>
							<h3 class="proj-name">{p.name}</h3>
							<p class="proj-desc">{p.desc}</p>
							<p class="proj-stack">{p.stack}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<ShippingLog />

	<!-- ============ JINX TEASER ============ -->
	<section class="jinx-card-wrap">
		<a href="/jinx" class="jinx-card sheet sheet-catear" data-paste="-1.4">
			<span class="mount mount-tape" aria-hidden="true"></span>
			<span class="jinx-card-art" aria-hidden="true"><Sketch name="cat" /></span>
			<div class="jinx-card-copy">
				<h2 class="jinx-card-head">Everything here sits on one box</h2>
				<p>
					It is called Jinx, it is bare metal in my flat, and it has its own page: what it is made of, what it
					hands out, and how awake it has been lately.
				</p>
				<span class="proj-cta">Go and look →</span>
			</div>
		</a>
	</section>

	<Marquee items={['Cut out', 'Stuck down', 'Annotated', 'Cat-eared', 'Filed']} speed={30} />

	<!-- ============ FOOTER ============ -->
	<footer class="foot">
		<div class="foot-left">
			<p class="foot-logo">futile<span class="nav-dot">.</span>studio</p>
			<p class="foot-copy">© 2026 Mayur Jivani · cut and pasted by hand</p>
			<p class="margin-note foot-wink">Named in a mood. Kept out of habit.</p>
		</div>

		<ul class="foot-links">
			<li><a class="btn" href="https://github.com/mayurjivani" target="_blank" rel="noopener">GitHub</a></li>
			<li>
				<a class="btn" href="https://linkedin.com/in/mayurjivani" target="_blank" rel="noopener">LinkedIn</a>
			</li>
			<li><a class="btn" href="mailto:mayur@futile.studio">Email</a></li>
			<li><a class="btn" href="/cv.pdf" download="Mayur_Jivani_CV.pdf">CV</a></li>
		</ul>
	</footer>
</Layout>

<style>
	/* ============ hero ============ */
	.cover {
		position: relative;
		max-width: 1140px;
		margin: 0 auto;
		padding: 3.2rem 2.2rem 3rem;
	}

	.cover-meta {
		display: flex;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
		margin-bottom: 1.5rem;
	}
	.cover-tag {
		display: inline-block;
		font-family: var(--hand);
		font-weight: 700;
		font-size: 0.82rem;
		background: var(--card);
		border: 1.5px solid var(--ink-soft);
		border-radius: 8px;
		padding: 0.3rem 0.8rem;
		transform: rotate(-2deg);
		box-shadow: 3px 3px 0 var(--shadow);
	}

	.cover-title {
		font-size: clamp(2.1rem, 6.6vw, 4.1rem);
		max-width: 30ch;
		margin-bottom: 1.6rem;
	}

	.cover-sub {
		max-width: 36rem;
		font-size: 1.02rem;
		font-weight: 600;
		line-height: 1.75;
		color: var(--ink-soft);
	}

	.cover-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
		margin-top: 1.8rem;
	}
	.cover-actions .btn {
		font-size: 0.9rem;
		padding: 0.6rem 1.1rem;
	}

	/* ============ about ============ */
	.about {
		max-width: 1140px;
		margin: 0 auto;
		padding: 3.5rem 2.2rem 1rem;
		position: relative;
	}

	.about-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
		gap: 2.4rem;
		align-items: start;
	}
	@media (max-width: 880px) {
		.about-grid {
			grid-template-columns: 1fr;
			gap: 2.8rem;
		}
	}

	/* An index card: ruled, with a red margin line down the left. */
	.card-index {
		padding: 1.6rem 1.8rem 1.6rem 2.6rem;
		background-image:
			linear-gradient(var(--ink-ghost) 1px, transparent 1px),
			linear-gradient(
				90deg,
				transparent 1.9rem,
				rgba(194, 69, 45, 0.3) 1.9rem,
				transparent calc(1.9rem + 2px)
			);
		background-size:
			100% 1.75rem,
			100% 100%;
		background-position:
			0 1.2rem,
			0 0;
	}
	.card-index p + p {
		margin-top: 1.1rem;
	}
	.card-index p {
		font-size: 0.93rem;
		line-height: 1.75;
		color: var(--ink-soft);
	}

	.card-spec {
		padding: 1.5rem 1.4rem 1.4rem;
		background: var(--card-2);
	}
	.card-spec-head {
		font-size: 1rem;
		margin-bottom: 0.9rem;
		padding-bottom: 0.5rem;
		border-bottom: 2px dashed var(--ink-ghost);
	}

	.spec-list {
		display: flex;
		flex-direction: column;
	}
	.spec-row {
		display: grid;
		grid-template-columns: 5.4rem 1fr;
		gap: 0.6rem;
		padding: 0.5rem 0;
		border-bottom: 1px solid var(--ink-ghost);
		font-size: 0.84rem;
	}
	.spec-row:last-child {
		border-bottom: none;
	}
	.spec-row dt {
		font-family: var(--bubble);
		font-weight: 800;
		font-size: 0.78rem;
		color: var(--ink);
	}
	.spec-row dd {
		color: var(--ink-soft);
	}
	.spec-cv {
		margin-top: 1.1rem;
	}

	/* ============ the kit ============ */
	.kit {
		max-width: 1140px;
		margin: 0 auto;
		padding: 3.5rem 2.2rem 1rem;
	}
	.kit-intro {
		font-size: 0.92rem;
		line-height: 1.7;
		color: var(--ink-soft);
		max-width: 38rem;
		margin-bottom: 2rem;
	}
	.kit-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
		gap: 2.4rem 1.6rem;
		padding-top: 0.5rem;
	}
	.kit-card {
		padding: 1.4rem 1.2rem 1.2rem;
		background: var(--card-2);
	}
	.kit-group {
		font-size: 0.95rem;
		margin-bottom: 0.8rem;
		padding-bottom: 0.45rem;
		border-bottom: 2px dashed var(--ink-ghost);
	}
	.kit-items {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}
	/* Each one a little torn-off label rather than a progress bar: I am not
	   going to pretend a percentage means anything here. */
	.kit-item {
		font-family: var(--hand);
		font-weight: 700;
		font-size: 0.78rem;
		color: var(--ink);
		background: var(--card);
		border: 1.5px solid var(--ink-soft);
		border-radius: 6px;
		padding: 0.18rem 0.5rem;
		box-shadow: 2px 2px 0 var(--shadow);
	}

	/* ============ the board ============ */
	.board {
		max-width: 1140px;
		margin: 0 auto;
		padding: 3.5rem 2.2rem 1rem;
	}
	.board-head {
		max-width: 44rem;
		margin-bottom: 2.2rem;
	}
	.board-intro {
		font-size: 0.92rem;
		line-height: 1.7;
		color: var(--ink-soft);
		max-width: 38rem;
	}

	.board-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(15.5rem, 1fr));
		gap: 2.8rem 1.7rem;
		padding-top: 0.5rem;
	}

	.proj {
		display: block;
		padding: 1.5rem 1.2rem 1.3rem;
		text-decoration: none;
		color: var(--ink);
		transition:
			transform 0.15s ease,
			box-shadow 0.15s ease;
	}
	/* Hover straightens the card and lifts it. Every card behaves the same
	   on hover; only the resting tilt is random. (Guideline B) */
	a.proj:hover {
		transform: rotate(0deg) translateY(-5px);
		box-shadow: 5px 8px 0 var(--shadow-deep);
	}
	.proj.is-pick {
		background: var(--card);
		border-color: var(--ink);
	}

	.proj-sketch {
		display: block;
		height: 3.2rem;
		margin-bottom: 1rem;
		color: var(--ink-soft);
	}
	.proj-sketch :global(.proj-sketch-svg) {
		height: 100%;
		width: auto;
		max-width: 100%;
	}

	.proj-meta {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		font-size: 0.74rem;
		font-weight: 700;
		color: var(--ink-faint);
		margin-bottom: 0.3rem;
	}
	.proj-year {
		margin-left: auto;
		font-variant-numeric: tabular-nums;
	}
	.proj-dot {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: var(--live);
		flex-shrink: 0;
	}
	.proj-dot-off {
		background: var(--ink-ghost);
	}

	.proj-name {
		font-size: 1.25rem;
		margin-bottom: 0.4rem;
	}
	.proj-pick {
		margin-bottom: 0.6rem;
	}
	.proj-desc {
		font-size: 0.84rem;
		line-height: 1.65;
		color: var(--ink-soft);
	}
	.proj-stack {
		margin-top: 0.7rem;
		font-size: 0.74rem;
		font-style: italic;
		color: var(--ink-faint);
	}
	.proj-cta {
		display: block;
		margin-top: 0.9rem;
		font-family: var(--bubble);
		font-weight: 800;
		font-size: 0.84rem;
		color: var(--stamp);
	}

	/* ---- workbench ---- */
	.bench {
		margin-top: 3.4rem;
	}
	.bench-head {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		font-family: var(--bubble);
		font-weight: 800;
		font-size: 1.05rem;
		color: var(--ink-soft);
	}
	.bench-rule {
		flex: 1;
		height: 0;
		border-top: 2px dashed var(--ink-ghost);
	}
	.bench-note {
		margin: 0.5rem 0 1.5rem;
		max-width: 34rem;
	}
	.bench-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: 2.4rem 1.7rem;
	}
	.proj-bench {
		background: transparent;
		border-style: dashed;
		box-shadow: none;
	}
	.proj-bench .proj-sketch,
	.proj-bench .proj-name {
		opacity: 0.75;
	}

	/* ============ jinx teaser ============ */
	.jinx-card-wrap {
		max-width: 1140px;
		margin: 0 auto;
		padding: 2rem 2.2rem 3.5rem;
	}
	.jinx-card {
		display: flex;
		align-items: center;
		gap: 1.6rem;
		padding: 1.6rem 1.8rem;
		text-decoration: none;
		color: var(--ink);
		background: var(--card);
		transition:
			transform 0.15s ease,
			box-shadow 0.15s ease;
	}
	.jinx-card:hover {
		transform: rotate(0deg) translateY(-4px);
		box-shadow: 6px 8px 0 var(--shadow-deep);
	}
	.jinx-card-art {
		flex: 0 0 auto;
		width: 4.2rem;
		height: 4.2rem;
		color: var(--ink-soft);
	}
	.jinx-card-head {
		font-size: 1.2rem;
		margin-bottom: 0.4rem;
	}
	.jinx-card-copy p {
		font-size: 0.88rem;
		line-height: 1.65;
		color: var(--ink-soft);
		max-width: 44rem;
	}
	.jinx-card .proj-cta {
		margin-top: 0.6rem;
	}
	@media (max-width: 640px) {
		.jinx-card {
			flex-direction: column;
			align-items: flex-start;
			gap: 1rem;
		}
	}

	/* ============ footer ============ */
	.foot {
		max-width: 1140px;
		margin: 0 auto;
		padding: 2.6rem 2.2rem 4rem;
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		flex-wrap: wrap;
		gap: 1.6rem;
	}
	.foot-logo {
		font-family: var(--bubble);
		font-weight: 800;
		font-size: 1.15rem;
	}
	.foot-copy {
		font-size: 0.8rem;
		color: var(--ink-soft);
		margin-top: 0.2rem;
	}
	.foot-wink {
		margin-top: 0.5rem;
	}
	.nav-dot {
		color: var(--stamp);
	}

	.foot-links {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	@media (max-width: 640px) {
		.cover,
		.about,
		.kit,
		.board,
		.jinx-card-wrap,
		.foot {
			padding-left: 1.4rem;
			padding-right: 1.4rem;
		}
		.cover {
