---
import { url } from '../lib/url.js';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import DeskPanel from '../components/DeskPanel.astro';
import Cursors from '../components/Cursors.astro';
import DeskToys from '../components/DeskToys.astro';
import Logbook from '../components/Logbook.astro';
import Explorer from '../components/Explorer.astro';
import Featured from '../components/Featured.astro';
import Board from '../components/Board.astro';
import FieldGuide from '../components/FieldGuide.astro';
import BackRoom from '../components/BackRoom.astro';
import SharedStudio from '../components/SharedStudio.astro';
import { workbench } from '../data/board.js';
import { ideas } from '../data/studio.js';

const spec = [
	['Makes', 'Web things, mostly games and small tools'],
	['Studying', 'M.Sc. Computer Science at Paderborn'],
	['Speaks', 'English, and German if you are patient'],
	['Plays', 'Vinyl, cassettes, and whatever Chorusify picks'],
];

/* What I actually reach for, grouped the way the work is split. */
const kit = [
	{ group: 'Frontend', items: ['React', 'Astro', 'TypeScript', 'Next.js', 'Tailwind', 'Vite'] },
	{ group: 'Backend', items: ['Node', 'Express', 'Python', 'Flask', 'WebSockets', 'REST'] },
	{ group: 'Data', items: ['Postgres', 'SQLite', 'MongoDB', 'MySQL', 'Redis'] },
	{ group: 'Infrastructure', items: ['Docker', 'Proxmox', 'Caddy', 'Nginx', 'Cloudflare', 'CI/CD', 'Git', 'AWS'] },
];

/* "Currently tinkering with": only things genuinely on the bench or on the
   shared studio's list, never invented. */
const tinkering = [
	...workbench.map((p) => `${p.name}. ${p.desc.split('. ')[0]}.`),
	...ideas.map((i) => `${i.name}: ${i.note}.`),
];
---

<Layout>
	<a class="skip" href="#work">Skip to the projects</a>
	<Nav />
	<DeskPanel />
	<Cursors />

	<main id="main">
		<!-- ============ 1. the door ============ -->
		<header id="top" class="door wrap">
			<div class="door-copy">
				<p class="door-status label">
					<span class="door-status-dot" aria-hidden="true"></span>Currently making things
				</p>

				<h1 class="wordmark" aria-label="Futile Studio">
					{
						['Futile', 'Studio'].map((word, w) => (
							<span class:list={['wm-line', { 'wm-line-2': w }]} aria-hidden="true">
								{[...word].map((ch, i) => (
									<span class="cut" style={`--i:${w * 6 + i}; --r:${[-4, 3, -2, 5, -3, 2][(i + w) % 6]}deg`}>
										{ch}
									</span>
								))}
							</span>
						))
					}
					<span class="brandmark wm-sticker" aria-hidden="true">futile<b>.</b>studio</span>
				</h1>

				<p class="manifesto" data-reveal style="--d:150ms">
					Nothing matters. <span class="manifesto-2">Build cool shit anyway.</span>
				</p>
				<p class="door-sub" data-reveal style="--d:250ms">
					I'm Mayur. I build small games, tools and odd experiments, and run every one on a server in my flat.
				</p>

				<div class="door-actions" data-reveal style="--d:330ms">
					<a href="#work" class="btn btn-stamp">
						Browse projects
						<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
							<path d="M8 3v10M4 9l4 4 4-4"></path>
						</svg>
					</a>
					<a href={url('cv.pdf')} class="btn" target="_blank" rel="noopener">
						View CV<span class="visually-hidden">, PDF, opens in a new tab</span>
					</a>
				</div>
			</div>

			<div class="collage" data-depth-stage>
				<a class="c-photo" href="#spread-orbitle" data-depth="0.6" aria-label="Orbitle, the newest one. Jump to it.">
					<span class="mount mount-tape c-tape-a" aria-hidden="true"></span>
					<img src={url('shots/orbitle-d.webp')} alt="" width="1280" height="800" fetchpriority="high" />
					<span class="c-caption script" aria-hidden="true">orbitle, newest</span>
				</a>

				<a class="c-phone" href="#spread-chorusify" data-depth="1.3" aria-label="Chorusify on a phone. Jump to it.">
					<span class="c-corner c-corner-tl" aria-hidden="true"></span>
					<span class="c-corner c-corner-br" aria-hidden="true"></span>
					<img src={url('shots/chorusify-m.webp')} alt="" width="390" height="780" />
				</a>

				<div class="c-ticket" data-depth="1.8">
					<div class="tk-card">
						<a class="tk-face tk-front" href="#spread-noggin" aria-label="Noggin', a quiz for a room of phones. Jump to it.">
							<span class="tk-main">
								<span class="tk-kicker">Futile Studio presents</span>
								<span class="tk-name">Noggin'</span>
								<span class="tk-sub">a quiz for a room of phones</span>
								<span class="tk-meta"><span>Seat · your phone</span><span>Screen · the TV</span></span>
							</span>
							<span class="tk-stub">
								<span class="tk-admit">Admit one</span>
								<span class="tk-code" aria-hidden="true"></span>
								<span class="tk-no">FS-003</span>
							</span>
						</a>
						<div class="tk-face tk-back" id="tk-back" inert>
							<p class="tk-back-head">Conditions of entry</p>
							<p>Good for one round. The TV is the board and every phone in the room is a buzzer.</p>
							<p class="tk-back-hint">The matching stub is stamp FS-003 in the Field Guide. The Noggin' spread is hiding it.</p>
						</div>
					</div>
					<button class="tk-flip" type="button" aria-pressed="false" aria-controls="tk-back">
						<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 8a6 6 0 0 1 11-2m1-3v3.5h-3.5M16 12a6 6 0 0 1-11 2m-1 3v-3.5h3.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path></svg>
						<span class="visually-hidden">Turn the ticket over</span>
					</button>
				</div>

				<a class="c-postmark label" href={url('post/')} data-depth="1">
					<span aria-hidden="true">Paderborn</span>
					<span id="postmark-date" aria-hidden="true">DE</span>
					<span class="visually-hidden">Write to the studio: open the postcard desk</span>
				</a>
				<button class="c-note" type="button" aria-expanded="false" aria-controls="c-note-back" aria-describedby="c-note-how" data-depth="1.6">
					<span class="c-note-front script">psst. open me</span>
					<span class="c-note-back" id="c-note-back">
						Stamps are hidden all over the studio. The little counter by the menu keeps score. None of it is
						required.
					</span>
					<span class="visually-hidden" id="c-note-how">Not stuck down: drag it, or use the arrow keys to move it.</span>
				</button>
				<button class="c-tidy" type="button" hidden>Tidy the desk</button>

				<p class="c-arrow script" aria-hidden="true">
					<svg viewBox="0 0 80 40"><path d="M76 4C50 4 20 10 8 30m0 0 10-2M8 30l-1-10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
					everything here runs
				</p>

				<button class="c-explorer" type="button" data-clue="explorer" aria-label="Wave at the explorer" aria-expanded="false" aria-controls="explorer-says">
					<Explorer class="is-idle door-explorer" />
				</button>
			</div>

			<div class="c-bubble" id="explorer-says" role="status" hidden>
				<p class="c-bubble-text script"><span data-hello>Hello. Nice of you to come in.</span></p>
				<button class="c-bubble-close" type="button" aria-label="Close the greeting">✕</button>
			</div>
		</header>

		<!-- ============ 2. selected work ============ -->
		<Featured />

		<!-- ============ 3. everything ============ -->
		<Board />

		<!-- ============ 4. the guide ============ -->
		<FieldGuide />

		<!-- ============ 5. the maker's journal ============ -->
		<section id="about" class="journal wrap" aria-labelledby="journal-title">
			<div class="journal-book">
				<div class="j-page j-left">
					<h2 id="journal-title" class="j-title" data-annotate>Who keeps this place</h2>
					<p class="j-statement" data-annotate>I like knowing how things work, so I tend to build one until it does.</p>
					<p>
						Most of this began as a scribble that could have stayed a scribble. The interesting part is carrying
						on past the point where it stopped being fun.
					</p>
					<p>
						Everything here runs on a machine I can walk over to, which keeps the whole chain within reach. At
						1am the problem is on this side of the wall.
					</p>

					<div class="tinker">
						<p class="label">Currently tinkering with</p>
						<p class="tinker-text script" id="tinker-text" aria-live="polite">{tinkering[0]}</p>
						<button class="tinker-next" type="button" id="tinker-next">Turn the page</button>
					</div>
				</div>

				<div class="j-page j-right">
					<figure class="desk-diagram">
						<svg viewBox="0 0 420 220" role="img" aria-labelledby="desk-cap">
							<title id="desk-cap">A sketch of the desk: a laptop, a turntable and a cassette tape, each labelled by hand.</title>
							<g fill="none" stroke="var(--ink)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M10 170h400M30 170v40M390 170v40"></path>
								<path d="M60 168l12-62h96l12 62z" fill="var(--card)"></path>
								<path d="M48 168h144"></path>
								<rect x="220" y="140" width="96" height="28" rx="3" fill="var(--card)"></rect>
								<ellipse cx="258" cy="140" rx="24" ry="6" fill="var(--ink)"></ellipse>
								<path d="M300 140l-14-14"></path>
								<rect x="334" y="148" width="40" height="20" rx="2" fill="var(--card)"></rect>
								<circle cx="346" cy="158" r="4"></circle>
								<circle cx="362" cy="158" r="4"></circle>
							</g>
							<g fill="none" stroke="var(--stamp)" stroke-width="1.4" stroke-dasharray="3 4">
								<path d="M110 100C100 70 90 60 70 52"></path>
								<path d="M262 132C270 100 284 84 300 72"></path>
								<path d="M356 146C366 120 378 110 392 104"></path>
							</g>
							<g class="desk-notes">
								<text x="20" y="46">where the code happens</text>
								<text x="250" y="64">vinyl, mostly</text>
								<text x="296" y="98">Futile Rec. Co</text>
							</g>
						</svg>
					</figure>

					<dl class="j-spec">
						{
							spec.map(([k, v]) => (
								<div>
									<dt class="label">{k}</dt>
									<dd>{v}</dd>
								</div>
							))
						}
					</dl>

					<div class="j-links">
						<a href={url('cv.pdf')} class="btn btn-stamp" target="_blank" rel="noopener">
							View CV<span class="visually-hidden">, PDF, opens in a new tab</span>
						</a>
						<a class="btn" href="https://github.com/mayurjivani" target="_blank" rel="noopener">GitHub</a>
						<a class="btn" href="https://linkedin.com/in/mayurjivani" target="_blank" rel="noopener">LinkedIn</a>
						<a class="btn" href="mailto:mayur@futile.studio">Email</a>
					</div>
				</div>
			</div>

			<div class="kit" aria-labelledby="kit-title">
				<h3 id="kit-title" class="kit-title">What I reach for</h3>
				<div class="kit-grid">
					{
						kit.map((k) => (
							<div class="kit-col">
								<h4 class="label kit-group">{k.group}</h4>
								<ul class="kit-items" role="list">
									{k.items.map((i) => (
										<li>{i}</li>
									))}
								</ul>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<Logbook />

		<!-- ============ 6. the back room ============ -->
		<BackRoom />

		<!-- ============ 7. together ============ -->
		<SharedStudio />
	</main>

	<!-- ============ 8. the post office ============ -->
	<footer id="contact" class="post" aria-labelledby="post-title">
		<div class="wrap post-inner">
			<div class="post-copy">
				<h2 id="post-title" class="post-title" data-annotate>Write to the studio.</h2>
				<p class="post-sub">Work, questions, or an idea that sounds slightly pointless. All of it gets read.</p>
				<a class="post-mail" href="mailto:mayur@futile.studio" data-annotate>mayur@futile.studio</a>
				<ul class="post-links" role="list">
					<li><a href="https://github.com/mayurjivani" target="_blank" rel="noopener">GitHub</a></li>
					<li><a href="https://linkedin.com/in/mayurjivani" target="_blank" rel="noopener">LinkedIn</a></li>
					<li>
						<a href={url('cv.pdf')} target="_blank" rel="noopener">CV<span class="visually-hidden">, PDF</span></a>
					</li>
					<li><a href={url('jinx')}>Jinx</a></li>
				</ul>
			</div>

			<div class="post-scene">
				<div class="envelope" id="envelope">
					<div class="env-stamp" id="env-stamp" aria-hidden="true"><span>your stamp here</span></div>
					<p class="env-to script">
						Mayur Jivani<br />futile.studio<br />Paderborn, DE
					</p>
					<p class="env-mark label" aria-hidden="true">Par avion · Futile Post</p>
				</div>
				<div class="post-box">
					<div class="post-explorer" aria-hidden="true"><Explorer class="is-idle" /></div>
					<a class="btn btn-stamp" href={url('post/')} id="post-it" data-clue="post">Post it</a>
				</div>
				<p class="post-hint">Opens the postcard desk: write on the back and post it to the studio.</p>
				<DeskToys />
			</div>
		</div>

		<div class="wrap post-foot">
			<p class="brandmark post-brand" aria-hidden="true">futile<b>.</b>studio</p>
			<div class="post-small">
				<a href="#top" class="post-top">Back to the door ↑</a>
				<p>
					© 2026 Mayur Jivani.{' '}
					<button class="post-wink" type="button" data-clue="wink">Named in a mood, kept out of habit.</button>
				</p>
			</div>
		</div>
	</footer>
</Layout>

<script define:vars={{ tinkering }} is:inline>
	window.__futileTinkering = tinkering;
</script>

<script>
	import { animate } from 'motion';
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { collect, collected } from '../lib/guide.js';
	gsap.registerPlugin(ScrollTrigger);

	const root = document.documentElement;
	const still = () =>
		root.dataset.motion === 'off' ||
		(root.dataset.motion !== 'on' && matchMedia('(prefers-reduced-motion: reduce)').matches);
	const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;

	/* ---------- the postmark: today, from the visitor's own clock ---------- */
	const pm = document.getElementById('postmark-date');
	if (pm) pm.textContent = new Date().toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

	/* ---------- the note: flips when tapped, moves when dragged ----------
	   A loose scrap on the desk. Dragging is pointer events on the note alone,
	   with touch-action: pan-y, so a vertical swipe still scrolls the page and
	   only a sideways or mouse drag moves paper. Arrow keys do the same for a
	   keyboard. The first move earns the Rearranged stamp; Tidy puts it back. */
	const note = document.querySelector<HTMLButtonElement>('.c-note');
	const tidy = document.querySelector<HTMLButtonElement>('.c-tidy');
	const stage = document.querySelector<HTMLElement>('.collage');
	if (note && tidy && stage) {
		let mx = 0;
		let my = 0;
		let start: { x: number; y: number; mx: number; my: number } | null = null;
		let dragging = false;
		let justDragged = false;
		const place = (nx: number, ny: number) => {
			/* stay on the desk: the note may hang a little past the edge, never leave */
			const st = stage.getBoundingClientRect();
			const r = note.getBoundingClientRect();
			const baseL = r.left - mx;
			const baseT = r.top - my;
			const slack = 24;
			mx = Math.min(st.right + slack - r.width - baseL, Math.max(st.left - slack - baseL, nx));
			my = Math.min(st.bottom + slack - r.height - baseT, Math.max(st.top - slack - baseT, ny));
			note.style.setProperty('--mx', `${Math.round(mx)}px`);
			note.style.setProperty('--my', `${Math.round(my)}px`);
			tidy.hidden = !mx && !my;
		};
		const moved = () => collect('desk');
		note.addEventListener('pointerdown', (e) => {
			if (e.button !== 0) return;
			start = { x: e.clientX, y: e.clientY, mx, my };
			dragging = false;
		});
		note.addEventListener('pointermove', (e) => {
			if (!start) return;
			const dx = e.clientX - start.x;
			const dy = e.clientY - start.y;
			if (!dragging && Math.hypot(dx, dy) > 6) {
				dragging = true;
				note.setPointerCapture(e.pointerId);
				note.classList.add('is-lifted');
			}
			if (dragging) place(start.mx + dx, start.my + dy);
		});
		const drop = () => {
			if (dragging) {
				justDragged = true;
				note.classList.remove('is-lifted');
				moved();
			}
			start = null;
			dragging = false;
		};
		note.addEventListener('pointerup', drop);
		/* the browser took the gesture for a scroll: let it, and leave the note */
		note.addEventListener('pointercancel', () => {
			note.classList.remove('is-lifted');
			start = null;
			dragging = false;
		});
		note.addEventListener('click', () => {
			if (justDragged) return void (justDragged = false);
			note.setAttribute('aria-expanded', String(note.getAttribute('aria-expanded') !== 'true'));
		});
		note.addEventListener('keydown', (e) => {
			const step = e.shiftKey ? 36 : 12;
			const d = { ArrowLeft: [-step, 0], ArrowRight: [step, 0], ArrowUp: [0, -step], ArrowDown: [0, step] }[e.key];
			if (!d) return;
			e.preventDefault();
			place(mx + d[0], my + d[1]);
			moved();
		});
		tidy.addEventListener('click', () => {
			place(0, 0);
			note.focus();
		});
	}

	/* ---------- the ticket: a front and a reverse ---------- */
	const ticket = document.querySelector<HTMLElement>('.c-ticket');
	ticket?.querySelector('.tk-flip')?.addEventListener('click', (e) => {
		const flipped = ticket.classList.toggle('is-flipped');
		(e.currentTarget as HTMLElement).setAttribute('aria-pressed', String(flipped));
		ticket.querySelector<HTMLElement>('.tk-front')!.inert = flipped;
		ticket.querySelector<HTMLElement>('.tk-back')!.inert = !flipped;
	});

	/* ---------- the explorer: looks at the pointer, waves when greeted, hops at a stamp ---------- */
	const door = document.querySelector<HTMLButtonElement>('.c-explorer');
	const fig = door?.querySelector<SVGElement>('.explorer');
	/* The greeting: a speech bubble that never lands on anything you might
	   want to read or press. Each candidate spot round the explorer is tried in
	   turn and the first that covers no link, button, heading or paragraph wins;
	   if none is clear (a narrow phone), it opens in the space under the
	   collage, with its tail still pointing at the explorer. */
	const bubble = document.getElementById('explorer-says')!;
	const doorEl = document.querySelector<HTMLElement>('.door')!;
	const busy = () =>
		[...doorEl.querySelectorAll<HTMLElement>('a, button, h1, p, .c-ticket, .c-note, .c-phone, .c-photo')]
			.filter((el) => !el.closest('.c-bubble') && el !== door && !door?.contains(el) && el.offsetParent)
			.map((el) => el.getBoundingClientRect());
	const hits = (a: DOMRect, b: DOMRect) => a.left < b.right && a.right > b.left && a.top < b.bottom && a.bottom > b.top;
	function placeBubble() {
		if (!door) return;
		const host = doorEl.getBoundingClientRect();
		const me = door.getBoundingClientRect();
		bubble.style.left = '0px';
		bubble.style.top = '0px';
		const w = bubble.offsetWidth;
		const h = bubble.offsetHeight;
		const gap = 14;
		const spots: Array<[string, number, number]> = [
			['above', me.left + me.width / 2 - w * 0.25, me.top - h - gap],
			['right', me.right + gap, me.top + me.height * 0.1],
			['left', me.left - w - gap, me.top + me.height * 0.1],
			['below', me.left + me.width / 2 - w * 0.25, me.bottom + gap],
		];
		const others = busy();
		const fits = ([, x, y]: [string, number, number]) => {
			const r = new DOMRect(x, y, w, h);
			return x >= 8 && x + w <= innerWidth - 8 && !others.some((o) => hits(r, o));
		};
		const pick = spots.find(fits);
		const collage = doorEl.querySelector('.collage')!.getBoundingClientRect();
		const [side, x, y] = pick ?? ['reserved', Math.max(8, Math.min(innerWidth - w - 8, me.left)), collage.bottom + gap + 8];
		bubble.dataset.side = side;
		bubble.style.left = `${x - host.left}px`;
		bubble.style.top = `${y - host.top}px`;
		/* the tail aims at the explorer's head from wherever the bubble ended up */
		bubble.style.setProperty('--tail-x', `${Math.min(w - 24, Math.max(16, me.left + me.width / 2 - x))}px`);
	}
	const setGreeting = (open: boolean) => {
		if (!door) return;
		bubble.hidden = !open;
		door.setAttribute('aria-expanded', String(open));
		if (open) placeBubble();
	};
	door?.addEventListener('click', () => {
		fig?.classList.remove('is-waving');
		requestAnimationFrame(() => fig?.classList.add('is-waving'));
		setGreeting(bubble.hidden !== false);
	});
	bubble.querySelector('.c-bubble-close')!.addEventListener('click', () => {
		setGreeting(false);
		door?.focus();
	});
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && !bubble.hidden) {
			setGreeting(false);
			door?.focus();
		}
	});
	window.addEventListener('resize', () => !bubble.hidden && placeBubble());
	/* the visitor's own name, once the studio has handed one out */
	window.addEventListener('futile-name', (e) => {
		const name = (e as CustomEvent).detail?.name;
		if (name) bubble.querySelector('[data-hello]')!.textContent = `Hello. You arrived as ${name}.`;
	});

	if (fig && fine && !still()) {
		window.addEventListener(
			'pointermove',
			(e) => {
				const r = fig.getBoundingClientRect();
				const dx = e.clientX - (r.left + r.width / 2);
				const dy = e.clientY - (r.top + r.height * 0.25);
				const d = Math.hypot(dx, dy) || 1;
				fig.style.setProperty('--look-x', `${((dx / d) * 1.4).toFixed(2)}px`);
				fig.style.setProperty('--look-y', `${((dy / d) * 1.1).toFixed(2)}px`);
			},
			{ passive: true },
		);
	}
	window.addEventListener('futile-stamp', () => {
		if (still()) return;
		document.querySelectorAll('.door-explorer, .post-explorer .explorer').forEach((f) => {
			f.classList.remove('is-hopping');
			requestAnimationFrame(() => f.classList.add('is-hopping'));
		});
	});

	/* ---------- the collage: a few pixels of depth on a fine pointer ---------- */
	if (fine && !still()) {
		const stage = document.querySelector<HTMLElement>('.collage');
		const layers = [...(stage?.querySelectorAll<HTMLElement>('[data-depth]') ?? [])];
		stage?.addEventListener('pointermove', (e) => {
			const r = stage.getBoundingClientRect();
			const nx = (e.clientX - r.left) / r.width - 0.5;
			const ny = (e.clientY - r.top) / r.height - 0.5;
			for (const l of layers) {
				const d = parseFloat(l.dataset.depth!) * 7;
				l.style.setProperty('--dx', `${(nx * d).toFixed(1)}px`);
				l.style.setProperty('--dy', `${(ny * d).toFixed(1)}px`);
			}
		});
		stage?.addEventListener('pointerleave', () =>
			layers.forEach((l) => {
				l.style.removeProperty('--dx');
				l.style.removeProperty('--dy');
			}),
		);
	}

	/* ---------- the collage separates as you leave the door ----------
	   Scrubbed by scroll, never driving it: the layers drift apart by their
	   depth, so the pile reads as paper at different heights. Wide screens
	   only, where the pile is a pile; the phone layout is a stack. */
	if (!still()) {
		gsap.matchMedia().add('(min-width: 901px)', () => {
			document.querySelectorAll<HTMLElement>('.collage [data-depth]').forEach((el) => {
				gsap.to(el, {
					y: -parseFloat(el.dataset.depth!) * 26,
					ease: 'none',
					scrollTrigger: { trigger: '.door', start: 'top top', end: 'bottom top', scrub: 0.6 },
				});
			});
		});
	}

	/* ---------- the rest of the walk: four scrubbed sequences ----------
	   All of them follow the scroll and none of them drive it; text only
	   ever moves within its own block, never across other text. */
	if (!still()) {
		const mm = gsap.matchMedia();
		mm.add('(min-width: 901px)', () => {
			/* the name shrinks back as you walk away from the door */
			gsap.to('.wordmark', {
				scale: 0.86,
				y: -24,
				transformOrigin: '0% 0%',
				ease: 'none',
				scrollTrigger: { trigger: '.door', start: 'top top', end: 'bottom 30%', scrub: 0.5 },
			});
			/* screenshots tilt a little as they pass, like prints lifted off a table */
			gsap.utils.toArray<HTMLElement>('.spread-shot, .spread-phone, .spread-live-clip').forEach((el, i) => {
				gsap.fromTo(
					el,
					{ rotation: i % 2 ? -1.6 : 1.6, y: 24 },
					{ rotation: i % 2 ? 0.8 : -0.8, y: -12, ease: 'none', scrollTrigger: { trigger: el, start: 'top bottom', end: 'bottom top', scrub: 0.6 } },
				);
			});
		});
		/* every scene title lands out of register and settles, the way a second
		   ink pass catches up with the first */
		gsap.utils.toArray<HTMLElement>('.sect-label').forEach((el) => {
			gsap.fromTo(el, { '--reg': '7px' }, { '--reg': '0px', ease: 'power2.out', scrollTrigger: { trigger: el, start: 'top 92%', end: 'top 55%', scrub: 0.4 } });
		});
		/* the post office: the envelope, the box and the desk tray arrive from
		   wherever they were and come to rest together at the end */
		gsap.utils.toArray<HTMLElement>('.post-scene > *').forEach((el, i) => {
			gsap.from(el, {
				x: [-60, 50, -30, 40][i % 4],
				y: 40,
				rotation: [-8, 6, -4, 5][i % 4],
				opacity: 0.4,
				ease: 'none',
				scrollTrigger: { trigger: '.post', start: 'top 85%', end: 'top 35%', scrub: 0.6 },
			});
		});
	}

	/* ---------- currently tinkering with ---------- */
	const items: string[] = (window as any).__futileTinkering;
	let at = 0;
	const tinkerText = document.getElementById('tinker-text')!;
	document.getElementById('tinker-next')?.addEventListener('click', () => {
		at = (at + 1) % items.length;
		tinkerText.textContent = items[at];
		if (!still()) animate(tinkerText, { opacity: [0, 1], x: [8, 0] }, { duration: 0.35 });
	});

	/* ---------- the post office: the envelope wears your latest stamp ---------- */
	const envStamp = document.getElementById('env-stamp')!;
	function stickLatest(fresh = false) {
		const got = [...collected()];
		const last = got[got.length - 1];
		const art = last && document.querySelector(`.slot[data-stamp="${last}"] .slot-art`);
		if (!art) return envStamp.replaceChildren(Object.assign(document.createElement('span'), { textContent: 'your stamp here' }));
		envStamp.replaceChildren(art.cloneNode(true));
		/* A new stamp is licked and pressed on, so the corner of the envelope
		   answers the find even from the other end of the page. */
		if (fresh && !still()) animate(envStamp, { scale: [1.5, 1], rotate: [-14, 4] }, { type: 'spring', stiffness: 420, damping: 16 });
	}
	stickLatest();
	window.addEventListener('futile-stamp', () => stickLatest(true));

</script>

