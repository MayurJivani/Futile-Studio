---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Marquee from '../components/Marquee.astro';
import VinylPlayer from '../components/VinylPlayer.astro';
import CassettePlayer from '../components/CassettePlayer.astro';
import { collection } from '../data/collection.js';

const vinyls = collection.filter((i) => i.format === 'vinyl');
const cassettes = collection.filter((i) => i.format === 'cassette');
---

<Layout
	title="Collection — Futile Studio"
	description="The Futile Recording Co physical media collection — vinyl and cassette, digitized and playable."
>
	<Nav active="collection" />

	<audio id="media-audio" preload="none"></audio>

	<div class="intro">
		<div class="sheet-label" data-reveal>SHEET 00 / 03 — FUTILE RECORDING CO</div>
		<span class="label" data-reveal>/ The Collection</span>
		<h1 data-split-group>
			<span class="split-mask"><span class="split-word">The</span></span>
			<span class="split-mask"><span class="split-word">library.</span></span><br />
			<span class="split-mask"><span class="split-word hl">Physical</span></span>
			<span class="split-mask"><span class="split-word hl">media.</span></span>
		</h1>
		<p data-reveal style="--d:120ms">
			Every vinyl and cassette I own, shelved here and playable through the turntable or tape deck below.
			Audio streams straight off <strong>my own server</strong>. Click a sleeve to drop the needle.
		</p>
	</div>

	<Marquee items={['On the turntable', 'In the deck', 'Needle drop', 'Press play']} speed={28} />

	<section id="vinyl-shelf">
		<div class="section-label" data-reveal>/ 01 — Vinyl</div>
		<h2 data-split data-split-group>On the turntable</h2>
		<div class="shelf">
			{
				vinyls.map((item, i) => (
					<button
						class="shelf-tile"
						data-format="vinyl"
						data-id={item.id}
						data-title={item.title}
						data-artist={item.artist}
						data-year={item.year}
						data-cover={item.cover}
						data-audio={item.audioSrc}
						data-reveal
						data-magnetic="0.12"
						style={`--d:${(i % 6) * 60}ms`}
					>
						<div class="tile-art">
							<svg viewBox="0 0 100 100" fill="none">
								<circle cx="50" cy="50" r="49" stroke="currentColor" stroke-width="1" />
								<circle cx="50" cy="50" r="38" stroke="currentColor" stroke-width="0.5" />
								<circle cx="50" cy="50" r="26" stroke="currentColor" stroke-width="0.5" />
								<circle cx="50" cy="50" r="14" stroke="currentColor" stroke-width="0.5" />
								<circle cx="50" cy="50" r="4" fill="currentColor" opacity="0.6" />
							</svg>
						</div>
						<div class="tile-title">{item.title}</div>
						<div class="tile-artist">{item.artist}</div>
						<div class="tile-format">Vinyl · {item.year}</div>
					</button>
				))
			}
			<div class="add-tile">+ Add to shelf</div>
		</div>
	</section>

	<div class="divider" data-reveal="line" aria-hidden="true">
		<svg width="100%" height="2" preserveAspectRatio="none"
			><line
				class="draw-path"
				x1="0"
				y1="1"
				x2="100%"
				y2="1"
				stroke="var(--line-strong)"
				stroke-width="1"
				pathLength="1"></line></svg
		>
	</div>

	<section id="cassette-shelf">
		<div class="section-label" data-reveal>/ 02 — Cassette</div>
		<h2 data-split data-split-group>In the deck</h2>
		<div class="shelf">
			{
				cassettes.map((item, i) => (
					<button
						class="shelf-tile"
						data-format="cassette"
						data-id={item.id}
						data-title={item.title}
						data-artist={item.artist}
						data-year={item.year}
						data-cover={item.cover}
						data-audio={item.audioSrc}
						data-reveal
						data-magnetic="0.12"
						style={`--d:${(i % 6) * 60}ms`}
					>
						<div class="tile-art tile-art-cassette">
							<svg viewBox="0 0 100 64" fill="none">
								<rect x="1" y="1" width="98" height="62" stroke="currentColor" stroke-width="1" />
								<circle cx="30" cy="32" r="12" stroke="currentColor" stroke-width="1" />
								<circle cx="70" cy="32" r="12" stroke="currentColor" stroke-width="1" />
								<circle cx="30" cy="32" r="3" fill="currentColor" />
								<circle cx="70" cy="32" r="3" fill="currentColor" />
							</svg>
						</div>
						<div class="tile-title">{item.title}</div>
						<div class="tile-artist">{item.artist}</div>
						<div class="tile-format">Cassette · {item.year}</div>
					</button>
				))
			}
			<div class="add-tile">+ Add to deck</div>
		</div>
	</section>

	<section id="library-shelf">
		<div class="section-label" data-reveal>/ 03 — Hi-Res library</div>
		<h2 data-split data-split-group>On the stream.</h2>
		<p class="lib-note" data-reveal style="--d:120ms">
			Streams straight off <strong>my collection</strong> — lossless playback, at its native
			sample rate.
		</p>
		<div class="shelf" id="lib-shelf">
			<div class="lib-message">Scanning the shelf…</div>
		</div>
	</section>

	<Marquee items={['Side A', 'Side B', 'Rewind', 'Play it loud']} speed={24} />

	<VinylPlayer />
	<CassettePlayer />
</Layout>

<script>
	import { API_BASE, esc, apiFetch, setCsrfToken } from '../lib/api';

	const audio = document.getElementById('media-audio') as HTMLAudioElement;

	const vinylPlayer = document.getElementById('vinyl-player')!;
	const cassettePlayer = document.getElementById('cassette-player')!;

	const record = document.getElementById('vinyl-record')!;
	const tonearm = document.getElementById('tonearm')!;
	const reelLeft = document.getElementById('reel-left')!;
	const reelRight = document.getElementById('reel-right')!;

	const libShelf = document.getElementById('lib-shelf')!;
	const vinylTracklist = document.getElementById('vinyl-tracklist')!;
	const vinylTracklistOl = document.getElementById('vinyl-tracklist-ol')!;
	const vinylBadge = document.getElementById('vinyl-format-badge')!;
	const vinylDeliveryBadge = document.getElementById('vinyl-delivery-badge')!;

	let currentFormat: 'vinyl' | 'cassette' | 'library' | null = null;

	// --- Server-discovered hi-res library -----------------------------------
	const libAlbums: any[] = [];
	let libState: { album: any; index: number } | null = null;

	// Hearts are togglable only while signed in; guests see favorites but no
	// buttons. checkAuth also primes the CSRF token for the toggle endpoint.
	let isAuthed = false;
	async function checkAuth() {
		try {
			const res = await fetch(`${API_BASE}/api/auth/me`, { credentials: 'include' });
			if (!res.ok) return;
			const data = await res.json();
			setCsrfToken(data.csrfToken);
			isAuthed = true;
		} catch {
			// backend unreachable — hearts stay display-only
		}
	}

	const probe = new Audio();
	const MIME: Record<string, string> = {
		flac: 'audio/flac',
		mp3: 'audio/mpeg',
		wav: 'audio/wav',
		ogg: 'audio/ogg',
		opus: 'audio/ogg',
		m4a: 'audio/mp4',
		aac: 'audio/aac',
	};
	const isSafari = /^((?!chrome|android).)*safari/i.test(navigator.userAgent);

	// True when the browser can decode this exact file natively (raw stream,
	// byte-range seeking, zero loss). Everything else goes through the server's
	// ffmpeg transcode: lossless FLAC where possible, AAC as last resort.
	function canPlayRaw(ext: string, sampleRate?: number | null) {
		const mime = MIME[ext];
		if (!mime) return false;
		if (ext === 'flac' && isSafari && (sampleRate || 0) > 48000) return false;
		return probe.canPlayType(mime) !== '';
	}
	// track.url is already the tokenized /api/music/stream URL minted by the
	// server. Add ?to= only when the browser can't play the raw lossless
	// format; the token is bound to the file, not the format, so it's safe.
	function trackSrc(track: any) {
		const to = canPlayRaw(track.ext, track.sampleRate)
			? ''
			: probe.canPlayType('audio/flac')
				? 'flac'
				: 'aac';
		const sep = track.url.includes('?') ? '&' : '?';
		return `${API_BASE}${track.url}${to ? `${sep}to=${to}` : ''}`;
	}
	function isHiRes(track: any) {
		return (track.sampleRate || 0) > 48000 || (track.bitDepth || 0) > 16;
	}
	function badgeText(track: any) {
		const bits = track.bitDepth
			? `${track.bitDepth}/${Math.round((track.sampleRate || 0) / 1000)}`
			: track.sampleRate
				? `${Math.round(track.sampleRate / 1000)}kHz`
				: '';
		return [track.codec || String(track.ext || '').toUpperCase(), bits].filter(Boolean).join(' · ') || 'AUDIO';
	}

	// The catalog is cached locally so revisits paint instantly. The cached
	// copy carries signed stream URLs that stay valid for ~6h (the server's
	// token TTL), so anything younger than that still plays; after that it's
	// revalidated and replaced on every load. Favorites/artists changing on
	// the server are picked up by the background refresh.
	const CATALOG_CACHE_KEY = 'futile-library-catalog';
	const CATALOG_MAX_AGE = 6 * 60 * 60 * 1000;

	function cachedCatalog(): any[] | null {
		try {
			const raw = localStorage.getItem(CATALOG_CACHE_KEY);
			if (!raw) return null;
			const { at, albums } = JSON.parse(raw);
			if (!Array.isArray(albums) || Date.now() - at > CATALOG_MAX_AGE) return null;
			return albums;
		} catch {
			return null;
		}
	}

	function saveCatalog(albums: any[]) {
		try {
			localStorage.setItem(CATALOG_CACHE_KEY, JSON.stringify({ at: Date.now(), albums }));
		} catch {
			// quota / disabled storage — cache is best-effort
		}
	}

	// Hearts: everyone sees favorited hearts, but only a signed-in user gets a
	// clickable one (toggles via POST /api/favorites/toggle). Guests don't even
	// see empty hearts.
	function heartHtml(base: string, type: 'album' | 'track', id: string, fav: boolean, label: string) {
		if (!isAuthed && !fav) return '';
		const cls = `${base}${isAuthed ? ' is-btn' : ''}${fav ? '' : ' is-off'}`;
		const attrs = isAuthed
			? ` role="button" tabindex="0" aria-pressed="${fav ? 'true' : 'false'}"`
			: '';
		return `<span class="${cls}" data-type="${type}" data-id="${esc(id)}"${attrs} aria-label="${label}">♥</span>`;
	}

	async function onHeart(el: HTMLElement) {
		if (!isAuthed) return;
		const type = (el.dataset.type || 'album') as 'album' | 'track';
		const id = el.dataset.id || '';
		try {
			const res = await apiFetch('/api/favorites/toggle', {
				method: 'POST',
				body: JSON.stringify({ type, id }),
			});
			if (!res.ok) {
				if (res.status === 401) isAuthed = false;
				return;
			}
			const data = await res.json();
			el.classList.toggle('is-off', !data.fav);
			el.setAttribute('aria-pressed', data.fav ? 'true' : 'false');
			applyFav(type, id, !!data.fav);
		} catch {
			// network failure — leave the UI as-is
		}
	}

	// Mirror the toggle into libAlbums + the catalog cache so re-renders (and
	// the next page load) reflect it without waiting on the server.
	function applyFav(type: string, id: string, fav: boolean) {
		if (type === 'album') {
			const a = libAlbums.find((x) => x.id === id);
			if (a) a.fav = fav;
		} else {
			for (const a of libAlbums) {
				const t = (a.tracks || []).find((x: any) => x.rel === id);
				if (t) {
					t.fav = fav;
					break;
				}
			}
		}
		saveCatalog(libAlbums);
	}

	async function loadLibrary() {
		// Paint the shelf from cache immediately, then revalidate below.
		const cached = cachedCatalog();
		if (cached?.length) {
			libAlbums.push(...cached);
			renderLibrary();
		}
		try {
			const res = await fetch(`${API_BASE}/api/music`, { credentials: 'include' });
			if (!res.ok) throw new Error(String(res.status));
			const data = await res.json();
			const albums = data.albums || [];
			libAlbums.length = 0;
			libAlbums.push(...albums);
			saveCatalog(albums);
			// Don't clobber a player session that's mid-playback — the audio
			// element holds its own src and the open album is referenced by
			// object, so the shelf re-renders independently.
			if (!libState) renderLibrary();
		} catch {
			if (!libAlbums.length) {
				libShelf.innerHTML =
					'<div class="lib-message">Library server unreachable — is the backend running?</div>';
			}
		}
	}

	// Covers are served downscaled on the server (?s=) so a ~200px shelf tile
	// pulls a few dozen KB instead of a multi-MB folder.jpg. Two candidates
	// cover the DPR range; the 2x one kicks in on retina screens.
	function coverImg(cover: string) {
		if (!cover) return '';
		const base = `${API_BASE}${esc(cover)}`;
		return `<img src="${base}" srcset="${base}&amp;s=400 1x, ${base}&amp;s=800 2x" alt="" loading="lazy" decoding="async" fetchpriority="low">`;
	}

	function renderLibrary() {
		if (!libAlbums.length) {
			libShelf.innerHTML =
				'<div class="lib-message">The library folder is empty — drop some FLACs in and refresh.</div>';
			return;
		}
		libShelf.innerHTML = '';
		libAlbums.forEach((album) => {
			const btn = document.createElement('button');
			btn.className = 'shelf-tile lib-tile';
			btn.innerHTML = `
				<div class="tile-art lib-art">
					${coverImg(album.cover)}
					<svg viewBox="0 0 100 100" fill="none" aria-hidden="true">
						<circle cx="50" cy="50" r="49" stroke="currentColor" stroke-width="1" />
						<circle cx="50" cy="50" r="38" stroke="currentColor" stroke-width="0.5" />
						<circle cx="50" cy="50" r="26" stroke="currentColor" stroke-width="0.5" />
						<circle cx="50" cy="50" r="14" stroke="currentColor" stroke-width="0.5" />
						<circle cx="50" cy="50" r="4" fill="currentColor" opacity="0.6" />
					</svg>
				${heartHtml('tile-heart', 'album', album.id, !!album.fav, 'Toggle favorite album')}
			</div>
			<div class="tile-title">${esc(album.title)}</div>
			<div class="tile-artist">${esc(album.artist || 'Unknown artist')}</div>
			<div class="tile-format">${esc(album.format || '')}${album.discs > 1 ? ` · ${album.discs} discs` : ''}${album.year ? ` · ${album.year}` : ''}</div>
			`;
			const img = btn.querySelector('img');
			img?.addEventListener('error', () => (img.style.display = 'none'));
			btn.addEventListener('click', () => openAlbum(album, 0, false));
			libShelf.appendChild(btn);
		});
	}

	function currentTrack() {
		return libState ? libState.album.tracks[libState.index] : null;
	}

	function setTracklist(album: any) {
		vinylTracklistOl.innerHTML = '';
		album.tracks.forEach((track: any, i: number) => {
			const li = document.createElement('li');
			li.dataset.i = String(i);
			li.innerHTML = `
				<span class="tl-num">${String(i + 1).padStart(2, '0')}</span>
				<span class="tl-title">${esc(track.title)}</span>
				${heartHtml('tl-heart', 'track', track.rel, !!track.fav, 'Toggle favorite track')}
				${isHiRes(track) ? '<span class="tl-hr">HI-RES</span>' : ''}
				<span class="tl-time">${fmtTime(track.duration)}</span>
			`;
			li.addEventListener('click', () => openAlbum(album, i, true));
			vinylTracklistOl.appendChild(li);
		});
		vinylTracklist.hidden = false;
	}

	function setCurrentTrackUI() {
		vinylTracklistOl.querySelectorAll('li').forEach((li) => {
			li.classList.toggle('is-current', Number((li as HTMLElement).dataset.i) === libState!.index);
		});
		const t = currentTrack();
		if (!t) return;
		vinylBadge.textContent = badgeText(t);
		vinylBadge.classList.toggle('is-hires', isHiRes(t));
	}

	function loadCurrent(autoplay: boolean) {
		const t = currentTrack();
		if (!t) return;
		audio.src = trackSrc(t);
		startBitrateMeter(t);
		if (autoplay) {
			audio.play().catch(() => {
				(document.getElementById('vinyl-note') as HTMLElement).textContent =
					'Tap play to start — autoplay was blocked.';
			});
			setPlayingUI(!audio.paused);
		} else {
			setPlayingUI(false);
		}
	}

	function openAlbum(album: any, index: number, autoplay = false) {
		libState = { album, index };
		currentFormat = 'library';
		audio.pause();
		audio.currentTime = 0;

		cassettePlayer.classList.remove('is-open');
		vinylPlayer.classList.add('is-open');

		(document.getElementById('vinyl-title') as HTMLElement).textContent = album.title;
		(document.getElementById('vinyl-artist') as HTMLElement).textContent = album.artist || '';
		(document.getElementById('vinyl-meta-title') as HTMLElement).textContent = album.title;
		(document.getElementById('vinyl-meta-sub') as HTMLElement).textContent = [album.artist, album.year].filter(Boolean).join(' · ');
		(document.getElementById('vinyl-note') as HTMLElement).textContent = '';
		setTracklist(album);
		setCurrentTrackUI();
		loadCurrent(autoplay);
	}

	function stepTrack(dir: number) {
		if (!libState) return;
		const tracks = libState.album.tracks;
		if (!tracks.length) return;
		libState.index = (libState.index + dir + tracks.length) % tracks.length;
		setCurrentTrackUI();
		loadCurrent(true);
	}

	// Live delivery bitrate in the badge next to the format: the browser
	// exposes how many compressed bytes it has decoded so far, so we measure
	// real throughput of whatever the server actually sent (raw FLAC ~real
	// lossless rate, an AAC transcode ~320k). Averaged over a 10s window so
	// initial buffering doesn't spike the number. The badge color still flags
	// delivery path from the ?to= on the URL (green = raw, amber = lossy).
	let bitrateTimer: number | null = null;
	let bitrateSamples: { t: number; b: number }[] = [];

	function decodedAudioBytes() {
		const a = audio as any;
		return a.webkitAudioDecodedByteCount ?? a.mozAudioDecodedByteCount ?? 0;
	}

	function staticKbps(t: any) {
		return t.size && t.duration ? (t.size * 8) / t.duration / 1000 : null;
	}

	function startBitrateMeter(t: any) {
		if (bitrateTimer !== null) clearInterval(bitrateTimer);
		const to = /[?&]to=([a-z0-9]+)/i.exec(trackSrc(t))?.[1];
		vinylDeliveryBadge.className = to === 'aac'
			? 'format-badge delivery-badge is-lossy'
			: to
				? 'format-badge delivery-badge is-reencode'
				: 'format-badge delivery-badge is-raw';
		vinylDeliveryBadge.hidden = false;
		bitrateSamples = [];
		const update = () => {
			const now = audio.currentTime;
			bitrateSamples.push({ t: now, b: decodedAudioBytes() });
			while (bitrateSamples.length && now - bitrateSamples[0].t > 10) bitrateSamples.shift();
			const first = bitrateSamples[0];
			const last = bitrateSamples[bitrateSamples.length - 1];
			const span = last.t - first.t;
			if (audio.paused || bitrateSamples.length < 2 || span < 0.5) {
				const stat = staticKbps(t);
				vinylDeliveryBadge.textContent = stat ? `${Math.round(stat)} kbps` : '— kbps';
				return;
			}
			const kbps = ((last.b - first.b) * 8) / span / 1000;
			vinylDeliveryBadge.textContent =
				kbps > 0 && isFinite(kbps) ? `${Math.round(kbps)} kbps` : '— kbps';
		};
		update();
		bitrateTimer = window.setInterval(update, 1000);
	}

	// ----------------------------------------------------------------------

	function fmtTime(sec: number) {
		if (!isFinite(sec)) return '00:00';
		const m = Math.floor(sec / 60);
		const s = Math.floor(sec % 60);
		return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
	}

	function setPlayingUI(playing: boolean) {
		if (currentFormat === 'vinyl' || currentFormat === 'library') {
			record.classList.toggle('is-spinning', playing);
			tonearm.classList.toggle('is-playing', playing);
			(document.getElementById('vinyl-play-icon') as HTMLElement).style.display = playing ? 'none' : '';
			(document.getElementById('vinyl-pause-icon') as HTMLElement).style.display = playing ? '' : 'none';
		} else if (currentFormat === 'cassette') {
			reelLeft.classList.toggle('is-spinning', playing);
			reelRight.classList.toggle('is-spinning', playing);
			(document.getElementById('cassette-play-icon') as HTMLElement).style.display = playing ? 'none' : '';
			(document.getElementById('cassette-pause-icon') as HTMLElement).style.display = playing ? '' : 'none';
		}
	}

	function openPlayer(tile: HTMLElement) {
		const format = tile.dataset.format as 'vinyl' | 'cassette';
		const title = tile.dataset.title || 'Untitled';
		const artist = tile.dataset.artist || 'Unknown';
		const year = tile.dataset.year || '';
		const src = tile.dataset.audio || '';

		currentFormat = format;
		libState = null;
		vinylTracklist.hidden = true;
		vinylBadge.textContent = 'VINYL';
		vinylBadge.classList.remove('is-hires');
		audio.pause();
		audio.currentTime = 0;

		const panel = format === 'vinyl' ? vinylPlayer : cassettePlayer;
		const other = format === 'vinyl' ? cassettePlayer : vinylPlayer;
		other.classList.remove('is-open');
		panel.classList.add('is-open');

		const prefix = format;
		(document.getElementById(`${prefix}-title`) as HTMLElement).textContent = title;
		(document.getElementById(`${prefix}-artist`) as HTMLElement).textContent = artist;
		(document.getElementById(`${prefix}-meta-title`) as HTMLElement).textContent = title;
		(document.getElementById(`${prefix}-meta-sub`) as HTMLElement).textContent = `${artist} · ${year}`;

		const note = document.getElementById(`${prefix}-note`) as HTMLElement;

		if (src) {
			note.textContent = '';
			audio.src = src;
			audio.play().catch(() => {
				note.textContent = 'Tap play to start — autoplay was blocked.';
			});
		} else {
			audio.removeAttribute('src');
			note.textContent = 'No audio uploaded for this one yet.';
		}
		setPlayingUI(!audio.paused && !!src);
	}

	document.querySelectorAll<HTMLElement>('.shelf-tile').forEach((tile) => {
		tile.addEventListener('click', () => openPlayer(tile));
	});

	function closeAll() {
		audio.pause();
		vinylPlayer.classList.remove('is-open');
		cassettePlayer.classList.remove('is-open');
		vinylTracklist.hidden = true;
		vinylBadge.classList.remove('is-hires');
		setPlayingUI(false);
		currentFormat = null;
		libState = null;
	}

	document.getElementById('vinyl-close')?.addEventListener('click', closeAll);
	document.getElementById('cassette-close')?.addEventListener('click', closeAll);
	[vinylPlayer, cassettePlayer].forEach((panel) => {
		panel.addEventListener('click', (e) => {
			if (e.target === panel) closeAll();
		});
	});
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') closeAll();
	});

	function togglePlay() {
		if (!audio.src) return;
		if (audio.paused) {
			audio.play();
		} else {
			audio.pause();
		}
	}
	document.getElementById('vinyl-play')?.addEventListener('click', togglePlay);
	document.getElementById('cassette-play')?.addEventListener('click', togglePlay);
	document.getElementById('vinyl-prev')?.addEventListener('click', () => stepTrack(-1));
	document.getElementById('vinyl-next')?.addEventListener('click', () => stepTrack(1));

	// Shared volume control — one <audio> feeds both players, so both sliders
	// stay in sync with the same element.
	const vinylVolume = document.getElementById('vinyl-volume') as HTMLInputElement;
	const cassetteVolume = document.getElementById('cassette-volume') as HTMLInputElement;

	function setVolume(value: number) {
		const v = Math.min(1, Math.max(0, value));
		audio.volume = v;
		vinylVolume.value = String(v);
		cassetteVolume.value = String(v);
	}
	vinylVolume.addEventListener('input', () => setVolume(Number(vinylVolume.value)));
	cassetteVolume.addEventListener('input', () => setVolume(Number(cassetteVolume.value)));

	audio.addEventListener('play', () => setPlayingUI(true));
	audio.addEventListener('pause', () => setPlayingUI(false));
	audio.addEventListener('ended', () => {
		if (libState) stepTrack(1);
		else setPlayingUI(false);
	});

	// Heart clicks: delegated so toggles survive every shelf/tracklist
	// re-render. Capture phase so stopPropagation runs before the tile's own
	// click handler (which opens the album / starts the track).
	function onHeartEvent(e: Event) {
		const h = (e.target as HTMLElement).closest<HTMLElement>('.tile-heart, .tl-heart');
		if (!h) return;
		e.preventDefault();
		e.stopPropagation();
		onHeart(h);
	}
	libShelf.addEventListener('click', onHeartEvent, true);
	libShelf.addEventListener('keydown', onHeartEvent, true);
	vinylTracklistOl.addEventListener('click', onHeartEvent, true);
	vinylTracklistOl.addEventListener('keydown', onHeartEvent, true);

	async function init() {
		await checkAuth();
		await loadLibrary();
	}
	init();

	audio.addEventListener('timeupdate', () => {
		const pct = audio.duration ? (audio.currentTime / audio.duration) * 100 : 0;
		if (currentFormat === 'vinyl' || currentFormat === 'library') {
			(document.getElementById('vinyl-scrub-fill') as HTMLElement).style.width = pct + '%';
			(document.getElementById('vinyl-time-current') as HTMLElement).textContent = fmtTime(audio.currentTime);
			(document.getElementById('vinyl-time-total') as HTMLElement).textContent = fmtTime(audio.duration);
		} else if (currentFormat === 'cassette') {
			(document.getElementById('cassette-scrub-fill') as HTMLElement).style.width = pct + '%';
			(document.getElementById('cassette-time-current') as HTMLElement).textContent = String(
				Math.floor(audio.currentTime * 4),
			).padStart(3, '0');
			(document.getElementById('cassette-time-total') as HTMLElement).textContent = String(
				Math.floor((audio.duration || 0) * 4),
			).padStart(3, '0');
		}
	});
</script>

