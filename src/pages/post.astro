---
/**
 * The postcard desk. The footer's Post it button comes here.
 *
 * A postcard is written on the page and posted to the studio's API, which
 * keeps it as drawn (design, paper, ink, postmark, photo) and works out a
 * real-world journey for it: the receipt names the day it should arrive and
 * links to /track. With no API behind the page (a static preview) the desk
 * says so and offers the visitor's own mail app instead.
 */
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import DeskPanel from '../components/DeskPanel.astro';
import Cursors from '../components/Cursors.astro';
import Postcard from '../components/Postcard.astro';
import { url } from '../lib/url.js';
import { kinds, designs, papers, inks, STUDIO_EMAIL, MAX_CHARS, MAX_IMAGE_BYTES } from '../data/postcards.js';

const first = kinds[0];
---

<Layout title="Postcard desk · Futile Studio" description="Write a postcard to Futile Studio and follow it across the map.">
	<Nav />
	<DeskPanel />
	<Cursors />

	<main id="main" class="desk wrap">
		<header class="desk-head">
			<p class="label"><a href={url('#contact')}>← Back to the studio</a></p>
			<h1 class="desk-title">The postcard desk</h1>
			<p class="desk-lede">
				Pick a kind of mail, write on the back, send it into the world. Cards land in the studio's postbox and get
				read.
			</p>
		</header>

		<div class="desk-grid" id="desk">
			<!-- ================= the card ================= -->
			<div class="stage">
				<div class="paper-stack">
					<div class="envelope" aria-hidden="true"><span class="env-flap"></span></div>
					<div class="card-in" id="card-in"><Postcard id="card-wrap" /></div>
				</div>

				<div class="stage-actions">
					<button class="btn" type="button" id="flip" aria-pressed="false" aria-controls="card-wrap">Turn it over</button>
				</div>

				<aside class="stamp-notes" id="stamp-notes" hidden>
					<p class="label">Stamp notes · a work of fiction</p>
					{
						kinds.map((k) => (
							<div data-for={k.id} hidden={k.id !== first.id}>
								<p class="sn-title">{k.stamp.title}, {k.stamp.serial}</p>
								<p class="sn-meta">Issued {k.lore.issued} · {k.lore.edition}</p>
								<p>{k.lore.story}</p>
							</div>
						))
					}
				</aside>
			</div>

			<!-- ================= the controls ================= -->
			<form class="controls" id="postcard-form" novalidate>
				<p class="office" id="office" data-state="checking" role="status">Checking whether the post office is open…</p>
				<p class="sender" id="sender" hidden>Sending as <b data-sender></b>, the name the studio gave you.</p>
				<!-- a field people never see: anything typed here is a bot's -->
				<div class="hp" aria-hidden="true">
					<label for="website">Leave this empty</label>
					<input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
				</div>
				<fieldset class="pick">
					<legend class="label">Kind of mail</legend>
					<div class="pick-row">
						{
							kinds.map((k, i) => (
								<label class="chip">
									<input type="radio" name="kind" value={k.id} checked={i === 0} />
									<span>{k.label}</span>
								</label>
							))
						}
					</div>
				</fieldset>

				<div class="msg-field">
					<label class="label" for="msg">Message</label>
					<textarea id="msg" name="msg" rows="6" maxlength={MAX_CHARS} placeholder={first.prompts[0]} aria-describedby="msg-count msg-err"></textarea>
					<div class="msg-meta">
						<span id="msg-count" aria-live="polite">0 / {MAX_CHARS}</span>
						<button class="link" type="button" id="prompt-btn">Random prompt</button>
					</div>
					<p class="msg-err" id="msg-err" role="alert"></p>
				</div>

				<div class="two">
					<div>
						<label class="label" for="from">Signed (optional)</label>
						<input id="from" name="from" type="text" maxlength="60" autocomplete="name" />
					</div>
					<div>
						<label class="label" for="reply">Reply to (optional)</label>
						<input id="reply" name="reply" type="email" maxlength="120" autocomplete="email" />
					</div>
				</div>

				<fieldset class="pick">
					<legend class="label">Picture side</legend>
					<div class="pick-row">
						{
							designs.map((d, i) => (
								<label class="chip">
									<input type="radio" name="design" value={d.id} checked={i === 0} />
									<span>{d.label}</span>
								</label>
							))
						}
					</div>
				</fieldset>

				<div class="photo-field">
					<label class="label" for="photo">Photo (optional)</label>
					<input id="photo" name="photo" type="file" accept="image/jpeg,image/png,image/webp" aria-describedby="photo-note" />
					<p class="photo-note" id="photo-note">
						JPEG, PNG or WebP, up to {MAX_IMAGE_BYTES / 1024 / 1024} MB. Location and camera details are removed before it is kept.
						<button class="link" type="button" id="photo-clear" hidden>Take it off</button>
					</p>
				</div>

				<div class="two">
					<fieldset class="pick">
						<legend class="label">Paper</legend>
						<div class="pick-row">
							{
								papers.map((p, i) => (
									<label class="chip">
										<input type="radio" name="paper" value={p.id} checked={i === 0} />
										<span>{p.label}</span>
									</label>
								))
							}
						</div>
					</fieldset>
					<fieldset class="pick">
						<legend class="label">Ink</legend>
						<div class="pick-row">
							{
								inks.map((k, i) => (
									<label class="chip">
										<input type="radio" name="ink" value={k.id} checked={i === 0} data-color={k.color} />
										<span><i class="swatch" style={`background:${k.color}`} aria-hidden="true"></i>{k.label}</span>
									</label>
								))
							}
						</div>
					</fieldset>
				</div>

				<div class="form-actions">
					<button class="btn btn-stamp send" type="submit" data-clue="post">Send this into the world</button>
					<button class="btn" type="button" id="surprise">Surprise me</button>
					<button class="link" type="button" id="rts">Return to sender</button>
				</div>
				<p class="mine" id="mine" hidden>Your post: <span data-mine></span></p>
				<p class="how" id="how">
					The card is stored in the studio's postbox and read by a person. Your reply address, if you give one, is
					used to reply and for nothing else.
				</p>
				<p class="preview-out" id="preview-out" hidden>
					Not sent: the post office is closed on this copy of the site. You can
					<a id="mail-link" href="#">open it in your email app</a> instead, or
					<button class="link" type="button" id="copy-pre">copy the card</button>.
				</p>
			</form>

			<!-- ================= the receipt ================= -->
			<section class="receipt" id="receipt" hidden aria-labelledby="receipt-title">
				<div class="rc-mark" aria-hidden="true"><span>Futile Post</span><span data-rc-date></span></div>
				<h2 class="rc-title" id="receipt-title" tabindex="-1">Postal receipt</h2>
				<dl class="rc-lines">
					<div><dt>No.</dt><dd data-rc-no></dd></div>
					<div><dt>Received</dt><dd data-rc-time></dd></div>
					<div><dt>Kind</dt><dd data-rc-kind></dd></div>
					<div><dt>Class</dt><dd data-rc-class></dd></div>
					<div><dt>To</dt><dd>Paderborn, DE</dd></div>
				</dl>
				<p class="rc-note">
					In the postbox. It travels like real post now: it should reach Paderborn by <b data-rc-eta></b>.
					<a data-rc-track href="#">Track it on the map</a>. Keep that link: it is the only way back to this card.
				</p>
				<p class="rc-msg" role="status"></p>
				<div class="form-actions">
					<button class="btn" type="button" id="copy">Copy the postcard</button>
					<button class="btn btn-stamp" type="button" id="again">Write another</button>
					<a class="link" href={url('#contact')}>Back to the studio</a>
				</div>
			</section>
		</div>
	</main>
</Layout>

<script define:vars={{ email: STUDIO_EMAIL, max: MAX_CHARS, maxImage: MAX_IMAGE_BYTES, trackUrl: url('track') }} is:inline>
	window.__postcard = { email, max, maxImage, trackUrl };
</script>

<script>
	import { animate } from 'motion';
	import { collect } from '../lib/guide.js';
	import { API_BASE } from '../lib/api.js';
	import { visitor } from '../lib/visitor.js';
	import { paint, turn as turnCard, cardNo, postmarkDate } from '../lib/postcard.js';
	import { kinds, postmarks } from '../data/postcards.js';

	const { email, max, maxImage, trackUrl } = (window as any).__postcard as { email: string; max: number; maxImage: number; trackUrl: string };
	const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
	const root = document.documentElement;
	const still = () => root.dataset.motion === 'off' || (root.dataset.motion !== 'on' && matchMedia('(prefers-reduced-motion: reduce)').matches);

	const form = $<HTMLFormElement>('postcard-form');
	const wrap = $('card-wrap');
	/* Motion leaves an inline transform behind on whatever it animates; on the flipping
	   .card that beat .is-back and the card would never turn over again. Wiggle the holder instead. */
	const holder = $('card-in');
	const msg = $<HTMLTextAreaElement>('msg');
	const from = $<HTMLInputElement>('from');
	const reply = $<HTMLInputElement>('reply');
	const photo = $<HTMLInputElement>('photo');
	const count = $('msg-count');
	const err = $('msg-err');
	const flip = $<HTMLButtonElement>('flip');
	const today = postmarkDate(Date.now());

	const value = (name: string) => (form.elements.namedItem(name) as RadioNodeList).value;
	const kind = () => kinds.find((k) => k.id === value('kind')) ?? kinds[0];
	let promptAt = 0;
	let pmAt = 0;
	let photoUrl = '';

	/* ---------- the card follows the form: one paint, the same one /mailbox and /track use ---------- */
	const look = () => ({
		kind: kind().id,
		design: value('design'),
		paper: value('paper'),
		ink: value('ink'),
		postmark: pmAt,
		prompt: promptAt,
		message: msg.value,
		signed: from.value.trim(),
		image: photoUrl,
		date: today,
	});
	function show() {
		paint(wrap, look());
		document.querySelectorAll<HTMLElement>('#stamp-notes [data-for]').forEach((el) => (el.hidden = el.dataset.for !== kind().id));
		msg.placeholder = kind().prompts[promptAt];
		count.textContent = `${msg.value.length} / ${max}`;
		if (msg.value.trim()) err.textContent = '';
	}
	form.addEventListener('change', (e) => {
		if ((e.target as HTMLInputElement).name === 'kind') promptAt = 0;
		show();
	});
	msg.addEventListener('input', show);
	from.addEventListener('input', show);

	/* ---------- the photo: previewed from the visitor's own disk, checked again by the server ---------- */
	const clearPhoto = () => {
		if (photoUrl) URL.revokeObjectURL(photoUrl);
		photoUrl = '';
		photo.value = '';
		$('photo-clear').hidden = true;
	};
	photo.addEventListener('change', () => {
		const f = photo.files?.[0];
		if (photoUrl) URL.revokeObjectURL(photoUrl);
		photoUrl = '';
		if (f && !['image/jpeg', 'image/png', 'image/webp'].includes(f.type)) {
			err.textContent = 'Photos can be JPEG, PNG or WebP.';
			clearPhoto();
		} else if (f && f.size > maxImage) {
			err.textContent = `That photo is over ${maxImage / 1024 / 1024} MB. Try a smaller one.`;
			clearPhoto();
		} else if (f) {
			photoUrl = URL.createObjectURL(f);
			$('photo-clear').hidden = false;
			err.textContent = '';
			turn(false);
		}
		show();
	});
	$('photo-clear').addEventListener('click', () => {
		clearPhoto();
		show();
	});

	/* ---------- turning it over ---------- */
	function turn(toBack: boolean) {
		turnCard(wrap, toBack);
		flip.setAttribute('aria-pressed', String(toBack));
		flip.textContent = toBack ? 'Turn to the picture' : 'Turn it over';
	}
	flip.addEventListener('click', () => turn(!wrap.querySelector('.card')!.classList.contains('is-back')));
	/* writing turns the card to the side you are writing on */
	msg.addEventListener('focus', () => turn(true));

	/* ---------- prompts, surprises, the postmark, the stamp ---------- */
	$('prompt-btn').addEventListener('click', () => {
		promptAt = (promptAt + 1) % kind().prompts.length;
		show();
	});
	const pickIndex = (n: number) => Math.floor(Math.random() * n);
	$('surprise').addEventListener('click', () => {
		for (const name of ['kind', 'design', 'paper', 'ink']) {
			const radios = [...form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]`)];
			radios[pickIndex(radios.length)].checked = true;
		}
		promptAt = pickIndex(kind().prompts.length);
		show();
		turn(false);
		if (!still()) animate(holder, { rotate: [-3, 0], scale: [0.97, 1] }, { type: 'spring', stiffness: 300, damping: 14 });
	});

	const pm = wrap.querySelector<HTMLButtonElement>('[data-postmark]')!;
	pm.addEventListener('click', () => {
		pmAt = (pmAt + 1) % postmarks.length;
		show();
		if (!still()) animate(pm, { scale: [1.35, 1], opacity: [0.3, 1] }, { type: 'spring', stiffness: 520, damping: 16 });
	});

	const stampBtn = wrap.querySelector<HTMLButtonElement>('[data-stamp]')!;
	const notes = $('stamp-notes');
	stampBtn.setAttribute('aria-controls', 'stamp-notes');
	stampBtn.addEventListener('click', () => {
		notes.hidden = !notes.hidden;
		stampBtn.setAttribute('aria-expanded', String(!notes.hidden));
	});

	/* ---------- return to sender ---------- */
	function reset() {
		form.reset();
		promptAt = 0;
		pmAt = 0;
		clearPhoto();
		show();
		turn(false);
		err.textContent = '';
	}
	$('rts').addEventListener('click', () => {
		reset();
		if (!still()) animate(holder, { x: [0, -24, 0], rotate: [0, -4, 0] }, { duration: 0.45 });
	});

	/* ---------- the visitor's own post: tracking links kept in this browser only ---------- */
	type Mine = { id: number; track: string };
	const MINE = 'futile-post-sent';
	const mine = (): Mine[] => {
		try {
			return JSON.parse(localStorage.getItem(MINE) || '[]').filter((m: Mine) => Number.isInteger(m.id) && /^[a-f0-9]{24}$/.test(m.track));
		} catch {
			return [];
		}
	};
	const trackLink = (m: Mine) => `${trackUrl}?c=${m.track}`;
	function showMine() {
		const list = mine();
		$('mine').hidden = !list.length;
		$('mine')
			.querySelector('[data-mine]')!
			.replaceChildren(
				...list.slice(-6).flatMap((m, i) => {
					const a = Object.assign(document.createElement('a'), { href: trackLink(m), textContent: cardNo(m.id) });
					return i ? [', ', a] : [a];
				}),
			);
	}
	showMine();

	/* ---------- sending: into the studio's postbox ----------
	   A receipt is only ever shown for a card the server answered 201 for.
	   With no server behind the page (a static preview), the desk says so
	   before anything is written, and sending offers the visitor's own email
	   app instead of pretending. */
	const receipt = $('receipt');
	const office = $('office');
	const previewOut = $('preview-out');
	const sendBtn = form.querySelector<HTMLButtonElement>('.send')!;
	const opened = Date.now();
	let lastText = '';
	let open = false;
	(async () => {
		try {
			const r = await fetch(`${API_BASE}/api/health`, { headers: { Accept: 'application/json' } });
			open = r.ok;
		} catch {
			open = false;
		}
		office.dataset.state = open ? 'open' : 'preview';
		office.textContent = open
			? 'The post office is open. Cards go into the studio’s postbox and travel like real post.'
			: 'Preview mode: the post office is closed on this copy of the site, so nothing written here will be sent.';
	})();
	const showSender = () => {
		const name = visitor().name;
		$('sender').hidden = !name;
		if (name) $('sender').querySelector('[data-sender]')!.textContent = name;
	};
	showSender();
	window.addEventListener('futile-name', showSender);

	form.addEventListener('submit', async (e) => {
		e.preventDefault();
		const text = msg.value.trim();
		previewOut.hidden = true;
		if (!text) {
			err.textContent = 'The back is still blank. Write something first, even one line.';
			turn(true);
			msg.focus();
			return;
		}
		if (reply.value && !reply.checkValidity()) {
			err.textContent = 'That reply address does not look like an email address. Fix it or leave it empty.';
			reply.focus();
			return;
		}
		const k = kind();
		const signed = from.value.trim();
		const lines = [text, '', signed ? `from ${signed}` : '', reply.value ? `reply to ${reply.value}` : '', '', `(a ${k.label.toLowerCase()} postcard from futile.studio/post)`];
		lastText = lines.join('\n').replace(/\n{3,}/g, '\n\n').trim();

		if (!open) {
			const subject = `Postcard: ${k.label}${signed ? `, from ${signed}` : ''}`;
			($('mail-link') as HTMLAnchorElement).href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lastText)}`;
			previewOut.hidden = false;
			return;
		}

		sendBtn.disabled = true;
		sendBtn.textContent = 'Posting…';
		try {
			const l = look();
			const body = new FormData();
			for (const [key, v] of Object.entries({ ...l, message: msg.value, reply: reply.value, token: visitor().token, website: ($('website') as HTMLInputElement).value, elapsed: Date.now() - opened }))
				if (key !== 'image' && key !== 'date') body.append(key, String(v ?? ''));
			if (photo.files?.[0] && photoUrl) body.append('image', photo.files[0]);
			const res = await fetch(`${API_BASE}/api/postcards`, { method: 'POST', body });
			const out = await res.json().catch(() => ({}));
			if (res.status !== 201) {
				err.textContent = out.error || 'The post office refused that one. Try again in a moment.';
				return;
			}
			collect('post');
			try {
				localStorage.setItem(MINE, JSON.stringify([...mine(), { id: out.id, track: out.track }].slice(-30)));
			} catch {
				/* private window: the receipt link still works, it just is not remembered here */
			}
			showMine();
			receipt.querySelector('[data-rc-no]')!.textContent = cardNo(out.id);
			receipt.querySelector('[data-rc-time]')!.textContent = new Date(out.receivedAt).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' });
			receipt.querySelector('[data-rc-kind]')!.textContent = k.label;
			receipt.querySelector('[data-rc-class]')!.textContent = k.klass;
			receipt.querySelector('[data-rc-date]')!.textContent = today;
			receipt.querySelector('[data-rc-eta]')!.textContent = new Date(out.deliveredAt).toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long' });
			receipt.querySelector<HTMLAnchorElement>('[data-rc-track]')!.href = trackLink(out);
			form.hidden = true;
			receipt.hidden = false;
			$('receipt-title').focus();
			if (!still()) animate(receipt, { y: [30, 0], opacity: [0, 1], rotate: [-4, -1] }, { type: 'spring', stiffness: 260, damping: 20 });
		} catch {
			err.textContent = 'Could not reach the post office. Nothing was sent; your card is still here.';
		} finally {
			sendBtn.disabled = false;
			sendBtn.textContent = 'Send this into the world';
		}
	});
	$('copy-pre').addEventListener('click', async () => {
		try {
			await navigator.clipboard.writeText(`To: ${email}\n\n${lastText}`);
			$('copy-pre').textContent = 'copied';
		} catch {
			$('copy-pre').textContent = `copy failed; it goes to ${email}`;
		}
	});

	$('copy').addEventListener('click', async () => {
		const out = receipt.querySelector('.rc-msg')!;
		try {
			await navigator.clipboard.writeText(`To: ${email}\n\n${lastText}`);
			out.textContent = 'Copied, address and all.';
		} catch {
			out.textContent = `Could not copy. Send it to ${email} by hand.`;
		}
	});
	$('again').addEventListener('click', () => {
		receipt.hidden = true;
		form.hidden = false;
		reset();
		msg.focus();
	});

	show();
</script>

<style>
	.desk {
		padding-block: clamp(2rem, 5vw, 3.5rem) clamp(4rem, 8vw, 6rem);
	}
	.desk-head {
		max-width: 40rem;
		margin-bottom: 2rem;
	}
	.desk-head .label a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		color: var(--ink);
	}
	.desk-title {
		font-family: var(--wordmark);
		font-weight: 400;
		font-size: clamp(2.6rem, 7vw, 4.6rem);
		letter-spacing: 0.03em;
		line-height: 1;
		margin-bottom: 0.8rem;
	}
	.desk-lede {
		color: var(--ink-soft);
	}
	.desk-grid {
		display: grid;
		grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
		gap: clamp(1.6rem, 4vw, 3.5rem);
		align-items: start;
	}

	/* ================= the card ================= */
	.stage {
		position: relative;
		padding-top: 2.4rem;
	}
	.paper-stack {
		position: relative;
		padding-bottom: 1.6rem;
	}
	/* the envelope it came out of, behind and below */
	.envelope {
		position: absolute;
		left: 6%;
		right: 6%;
		top: 34%;
		bottom: 0;
		background: #e4d5b4;
		box-shadow: var(--lift);
		rotate: 2deg;
	}
	.env-flap {
		position: absolute;
		inset: 0 0 auto;
		height: 55%;
		background: #d8c7a2;
		clip-path: polygon(0 0, 100% 0, 50% 100%);
	}
	.card-in {
		position: relative;
		animation: slide-out 0.9s var(--ease-out) 0.15s both;
	}
	@keyframes slide-out {
		from {
			translate: 0 38%;
			rotate: 3deg;
		}
	}

	.stage-actions {
		display: flex;
		justify-content: center;
		margin-top: 1.4rem;
	}
	.stamp-notes {
		max-width: 26rem;
		margin: 1rem auto 0;
		padding: 0.9rem 1.1rem;
		background: var(--card);
		border: 1px dashed var(--ink-faint);
		font-size: 0.88rem;
		color: var(--ink-soft);
	}
	.stamp-notes [hidden] {
		display: none;
	}
	.sn-title {
		font-weight: 600;
		color: var(--ink);
	}
	.sn-meta {
		margin-bottom: 0.4rem;
		font-family: var(--mono);
		font-size: 0.72rem;
	}

	/* ================= the controls ================= */
	.controls {
